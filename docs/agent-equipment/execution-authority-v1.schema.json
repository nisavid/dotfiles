{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nisavid.github.io/dotfiles/agent-equipment/execution-authority-v1.schema.json",
  "title": "Agent equipment execution and release authority v1",
  "oneOf": [
    {"$ref": "#/$defs/applyAuthorization"},
    {"$ref": "#/$defs/compensationAuthorization"},
    {"$ref": "#/$defs/checkpointSetManifest"},
    {"$ref": "#/$defs/releaseArchiveManifest"},
    {"$ref": "#/$defs/releaseReceipt"}
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "opaqueIdentity": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,31}:[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$"
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])[Tt]([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]([.,][0-9]{1,9})?Z$"
    },
    "executionDomainIdentity": {
      "type": "string",
      "pattern": "^execution-domain:[A-Za-z0-9][A-Za-z0-9._/-]{0,254}$"
    },
    "applyBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_identity",
        "implementation_manifest_digest",
        "catalog_digest",
        "lock_digest",
        "plan_digest",
        "plan_action_set_digest",
        "capability_set_digest",
        "captured_state_identity",
        "captured_state_digest",
        "expected_case_manifest_digest",
        "operator_review_package_digest"
      ],
      "properties": {
        "candidate_identity": {"$ref": "#/$defs/opaqueIdentity"},
        "implementation_manifest_digest": {"$ref": "#/$defs/digest"},
        "catalog_digest": {"$ref": "#/$defs/digest"},
        "lock_digest": {"$ref": "#/$defs/digest"},
        "plan_digest": {"$ref": "#/$defs/digest"},
        "plan_action_set_digest": {"$ref": "#/$defs/digest"},
        "capability_set_digest": {"$ref": "#/$defs/digest"},
        "captured_state_identity": {"$ref": "#/$defs/opaqueIdentity"},
        "captured_state_digest": {"$ref": "#/$defs/digest"},
        "expected_case_manifest_digest": {"$ref": "#/$defs/digest"},
        "operator_review_package_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "applyAuthorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "authorization_identity",
        "issuer_identity",
        "issued_at",
        "not_before",
        "expires_at",
        "execution_nonce",
        "run_identity",
        "execution_domain_identity",
        "command",
        "bindings"
      ],
      "properties": {
        "schema_version": {
          "const": "agent-equipment-apply-authorization/v1"
        },
        "authorization_identity": {
          "type": "string",
          "pattern": "^apply-authorization:sha256:[0-9a-f]{64}$"
        },
        "issuer_identity": {"$ref": "#/$defs/opaqueIdentity"},
        "issued_at": {"$ref": "#/$defs/utcTimestamp"},
        "not_before": {"$ref": "#/$defs/utcTimestamp"},
        "expires_at": {"$ref": "#/$defs/utcTimestamp"},
        "execution_nonce": {
          "type": "string",
          "pattern": "^execution-nonce:sha256:[0-9a-f]{64}$"
        },
        "run_identity": {
          "type": "string",
          "pattern": "^run:sha256:[0-9a-f]{64}$"
        },
        "execution_domain_identity": {
          "$ref": "#/$defs/executionDomainIdentity"
        },
        "command": {"const": "apply"},
        "bindings": {"$ref": "#/$defs/applyBindings"}
      }
    },
    "executionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apply_authorization_identity",
        "apply_authorization_digest",
        "execution_domain_identity",
        "execution_nonce",
        "run_identity"
      ],
      "properties": {
        "apply_authorization_identity": {
          "type": "string",
          "pattern": "^apply-authorization:sha256:[0-9a-f]{64}$"
        },
        "apply_authorization_digest": {"$ref": "#/$defs/digest"},
        "execution_domain_identity": {
          "$ref": "#/$defs/executionDomainIdentity"
        },
        "execution_nonce": {
          "type": "string",
          "pattern": "^execution-nonce:sha256:[0-9a-f]{64}$"
        },
        "run_identity": {
          "type": "string",
          "pattern": "^run:sha256:[0-9a-f]{64}$"
        }
      }
    },
    "compensationBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apply_authorization_identity",
        "apply_authorization_digest",
        "execution_domain_identity",
        "execution_nonce",
        "run_identity",
        "checkpoint_set_digest",
        "plan_action_set_digest"
      ],
      "properties": {
        "apply_authorization_identity": {
          "type": "string",
          "pattern": "^apply-authorization:sha256:[0-9a-f]{64}$"
        },
        "apply_authorization_digest": {"$ref": "#/$defs/digest"},
        "execution_domain_identity": {
          "$ref": "#/$defs/executionDomainIdentity"
        },
        "execution_nonce": {
          "type": "string",
          "pattern": "^execution-nonce:sha256:[0-9a-f]{64}$"
        },
        "run_identity": {
          "type": "string",
          "pattern": "^run:sha256:[0-9a-f]{64}$"
        },
        "checkpoint_set_digest": {"$ref": "#/$defs/digest"},
        "plan_action_set_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "compensationAuthorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "compensation_authorization_identity",
        "issuer_identity",
        "issued_at",
        "not_before",
        "expires_at",
        "compensation_nonce",
        "command",
        "bindings"
      ],
      "properties": {
        "schema_version": {
          "const": "agent-equipment-compensation-authorization/v1"
        },
        "compensation_authorization_identity": {
          "type": "string",
          "pattern": "^compensation-authorization:sha256:[0-9a-f]{64}$"
        },
        "issuer_identity": {"$ref": "#/$defs/opaqueIdentity"},
        "issued_at": {"$ref": "#/$defs/utcTimestamp"},
        "not_before": {"$ref": "#/$defs/utcTimestamp"},
        "expires_at": {"$ref": "#/$defs/utcTimestamp"},
        "compensation_nonce": {
          "type": "string",
          "pattern": "^compensation-nonce:sha256:[0-9a-f]{64}$"
        },
        "command": {"const": "compensate"},
        "bindings": {"$ref": "#/$defs/compensationBindings"}
      }
    },
    "checkpointSetBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apply_authorization_identity",
        "apply_authorization_digest",
        "execution_domain_identity",
        "execution_nonce",
        "run_identity",
        "plan_action_set_digest"
      ],
      "properties": {
        "apply_authorization_identity": {
          "type": "string",
          "pattern": "^apply-authorization:sha256:[0-9a-f]{64}$"
        },
        "apply_authorization_digest": {"$ref": "#/$defs/digest"},
        "execution_domain_identity": {"$ref": "#/$defs/executionDomainIdentity"},
        "execution_nonce": {
          "type": "string",
          "pattern": "^execution-nonce:sha256:[0-9a-f]{64}$"
        },
        "run_identity": {
          "type": "string",
          "pattern": "^run:sha256:[0-9a-f]{64}$"
        },
        "plan_action_set_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "checkpointManifestEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkpoint_identity",
        "durable_generation",
        "record_version",
        "phase",
        "invocation_state",
        "action_identity",
        "ordinal",
        "checkpoint_record_digest"
      ],
      "properties": {
        "checkpoint_identity": {
          "type": "string",
          "pattern": "^checkpoint:sha256:[0-9a-f]{64}$"
        },
        "durable_generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "record_version": {"const": "agent-equipment-checkpoint/v1"},
        "phase": {
          "enum": [
            "prepared",
            "completed",
            "compensating",
            "compensated",
            "compensation_blocked"
          ]
        },
        "invocation_state": {"enum": ["not_started", "started"]},
        "action_identity": {
          "type": "string",
          "pattern": "^action:sha256:[0-9a-f]{64}$"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "checkpoint_record_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "checkpointSetManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "checkpoint_set_identity",
        "checkpoint_store_generation",
        "bindings",
        "checkpoints",
        "checkpoint_set_digest"
      ],
      "properties": {
        "schema_version": {"const": "agent-equipment-checkpoint-set/v1"},
        "checkpoint_set_identity": {
          "type": "string",
          "pattern": "^checkpoint-set:sha256:[0-9a-f]{64}$"
        },
        "checkpoint_store_generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "bindings": {"$ref": "#/$defs/checkpointSetBindings"},
        "checkpoints": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {"$ref": "#/$defs/checkpointManifestEntry"},
          "uniqueItems": true
        },
        "checkpoint_set_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "archiveDestination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "store_identity",
        "store_key",
        "compare_token",
        "committed_generation"
      ],
      "properties": {
        "store_identity": {"$ref": "#/$defs/opaqueIdentity"},
        "store_key": {"$ref": "#/$defs/opaqueIdentity"},
        "compare_token": {"const": "absent"},
        "committed_generation": {"const": 1}
      }
    },
    "archivedDocumentByteDigests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apply_authorization_bytes_digest",
        "expected_case_manifest_bytes_digest",
        "evidence_bundle_bytes_digest",
        "attestation_manifest_bytes_digest"
      ],
      "properties": {
        "apply_authorization_bytes_digest": {"$ref": "#/$defs/digest"},
        "expected_case_manifest_bytes_digest": {"$ref": "#/$defs/digest"},
        "evidence_bundle_bytes_digest": {"$ref": "#/$defs/digest"},
        "attestation_manifest_bytes_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "releaseArchivePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_identity",
        "implementation_manifest_digest",
        "execution_binding",
        "checkpoint_set_digest",
        "run_terminal_state",
        "launcher_identity",
        "launcher_manifest_digest",
        "archive_destination",
        "archived_document_byte_digests"
      ],
      "properties": {
        "candidate_identity": {"$ref": "#/$defs/opaqueIdentity"},
        "implementation_manifest_digest": {"$ref": "#/$defs/digest"},
        "execution_binding": {"$ref": "#/$defs/executionBinding"},
        "checkpoint_set_digest": {"$ref": "#/$defs/digest"},
        "run_terminal_state": {"const": "succeeded"},
        "launcher_identity": {
          "type": "string",
          "pattern": "^release-launcher:[A-Za-z0-9][A-Za-z0-9._/-]{0,254}$"
        },
        "launcher_manifest_digest": {"$ref": "#/$defs/digest"},
        "archive_destination": {"$ref": "#/$defs/archiveDestination"},
        "archived_document_byte_digests": {
          "$ref": "#/$defs/archivedDocumentByteDigests"
        }
      }
    },
    "releaseArchiveManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "archive_identity",
        "payload",
        "archive_manifest_digest"
      ],
      "properties": {
        "schema_version": {
          "const": "agent-equipment-release-archive-manifest/v1"
        },
        "archive_identity": {
          "type": "string",
          "pattern": "^release-archive:sha256:[0-9a-f]{64}$"
        },
        "payload": {"$ref": "#/$defs/releaseArchivePayload"},
        "archive_manifest_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "releaseReceiptPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issued_at",
        "outcome",
        "candidate_identity",
        "implementation_manifest_digest",
        "execution_binding",
        "checkpoint_set_digest",
        "run_terminal_state",
        "launcher_identity",
        "launcher_manifest_digest",
        "archive_identity",
        "archive_manifest_digest",
        "archive_destination"
      ],
      "properties": {
        "issued_at": {"$ref": "#/$defs/utcTimestamp"},
        "outcome": {"const": "passed"},
        "candidate_identity": {"$ref": "#/$defs/opaqueIdentity"},
        "implementation_manifest_digest": {"$ref": "#/$defs/digest"},
        "execution_binding": {"$ref": "#/$defs/executionBinding"},
        "checkpoint_set_digest": {"$ref": "#/$defs/digest"},
        "run_terminal_state": {"const": "succeeded"},
        "launcher_identity": {
          "type": "string",
          "pattern": "^release-launcher:[A-Za-z0-9][A-Za-z0-9._/-]{0,254}$"
        },
        "launcher_manifest_digest": {"$ref": "#/$defs/digest"},
        "archive_identity": {
          "type": "string",
          "pattern": "^release-archive:sha256:[0-9a-f]{64}$"
        },
        "archive_manifest_digest": {"$ref": "#/$defs/digest"},
        "archive_destination": {"$ref": "#/$defs/archiveDestination"}
      }
    },
    "releaseReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "receipt_identity", "payload"],
      "properties": {
        "schema_version": {
          "const": "agent-equipment-release-receipt/v1"
        },
        "receipt_identity": {
          "type": "string",
          "pattern": "^release-receipt:sha256:[0-9a-f]{64}$"
        },
        "payload": {"$ref": "#/$defs/releaseReceiptPayload"}
      }
    }
  }
}
