#!/usr/bin/env bash
set -euo pipefail
shopt -s nullglob
{{- $plugins := .claudePlugins }}
{{- range concat $plugins.accepted $plugins.explicitlyOff }}
{{-   if not (regexMatch "^[A-Za-z0-9][A-Za-z0-9._-]*$" .) }}
{{-     fail (printf "claudePlugins: invalid plugin name %q" .) }}
{{-   end }}
{{-   if and (has . $plugins.explicitlyOff) (has . $plugins.accepted) }}
{{-     fail (printf "claudePlugins: %q is both accepted and explicitly off" .) }}
{{-   end }}
{{- end }}

# Claude Code enables any plugin without an enabledPlugins entry.
# Directory-catalog entries appear in account manifests under their UUID; their
# real names come from the plugin.json in the synced copy. Every plugin
# name found at apply time in an account plugin manifest, in the synced plugin
# directory or in the installed-plugin registry that is not accepted gets its
# @inline, @synced and installed marketplace entries set to false. Accepted
# names get no entry, so their current state is preserved (dotfiles#479).
plugins_dir={{ joinPath .chezmoi.homeDir ".claude/plugins" | quote }}
accepted={{ $plugins.accepted | toJson | squote }}
explicitly_off={{ $plugins.explicitlyOff | toJson | squote }}
one_copy_off={{ $plugins.oneCopyPerSkill.off | toJson | squote }}
one_copy_on={{ $plugins.oneCopyPerSkill.on | toJson | squote }}

uuid_pattern='^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'

synced_names() {
  local manifest plugin_dir name
  for manifest in "$plugins_dir"/synced/*/manifest.json; do
    jq -r --arg uuid "$uuid_pattern" \
      '.plugins[]?.name // empty | select(test($uuid) | not)' "$manifest"
  done
  for plugin_dir in "$plugins_dir"/synced/*/*/; do
    name=${plugin_dir%/}
    name=${name##*/}
    name=${name%\~g[0-9]*}
    if [[ $name =~ $uuid_pattern ]]; then
      if [[ -f ${plugin_dir}.claude-plugin/plugin.json ]]; then
        jq -r '.name // empty' "${plugin_dir}.claude-plugin/plugin.json"
      fi
    else
      printf '%s\n' "$name"
    fi
  done
}

found=$(synced_names | jq -R -s -c 'split("\n") | map(select(length > 0))')
registry=$plugins_dir/installed_plugins.json
if [[ -f $registry ]]; then
  installed=$(jq -c '.plugins // {} | keys' "$registry")
else
  installed='[]'
fi

jq \
  --argjson accepted "$accepted" \
  --argjson explicitly_off "$explicitly_off" \
  --argjson one_copy_off "$one_copy_off" \
  --argjson one_copy_on "$one_copy_on" \
  --argjson found "$found" \
  --argjson installed "$installed" '
  def plugin_name: sub("@[^@]*$"; "");
  ($accepted | map({key: ., value: true}) | from_entries) as $is_accepted |
  ($found + ($installed | map(plugin_name)) + $explicitly_off |
    unique | map(select($is_accepted[.] | not))) as $unaccepted |
  ($unaccepted | map({key: ., value: true}) | from_entries) as $is_unaccepted |
  ([$unaccepted[] | (. + "@inline"), (. + "@synced")] +
    [$installed[] | select($is_unaccepted[plugin_name])] +
    $one_copy_off) as $off |
  .enabledPlugins = (.enabledPlugins // {}) |
  reduce $off[] as $entry (.; .enabledPlugins[$entry] = false) |
  reduce $one_copy_on[] as $entry (.;
    if .enabledPlugins | has($entry) then .enabledPlugins[$entry] = true else . end) |
  del(.enabledPlugins["serena@claude-plugins-official"]) |
  .enabledPlugins["context7@claude-plugins-official"] = false |
  .enabledPlugins["github@claude-plugins-official"] = false |
  .enabledPlugins["greptile@claude-plugins-official"] = false
' < /dev/stdin
