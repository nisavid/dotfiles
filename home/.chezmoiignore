# Never manage the age identity (private key) — it is machine-local and must not be committed.
.config/age

# Machine-local git overrides (e.g. coderabbit machineId); not tracked.
.config/git/config.local

{{ if ne .chezmoi.os "darwin" }}
# The current Hindsight consumer is Darwin-only.
.agents/skills/hindsight-*
.config/hindsight-*
.hindsight*
.local/bin/hindsight-*
.local/lib/hindsight-*

# OrbStack owns the managed Docker context on macOS.
.docker

# The zsh GUI path bridge is a launchd integration.
Library/LaunchAgents/*zsh-gui-path*
.local/libexec/*/zsh-gui-path
{{ end }}
