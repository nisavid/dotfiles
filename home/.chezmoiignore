{{ if not (get (default (dict) (get . "secretExec")) "publicFixture") }}
# AWS has no consumer binding; only explicit public fixtures render it.
.aws
.config/secret-exec/profiles/aws.env
{{ end }}

# Never manage the age identity (private key) — it is machine-local and must not be committed.
.config/age

# Machine-local Git overrides; not tracked. Tools that use `git config --global`,
# such as CodeRabbit for its machineId, can't reach this file: plain --global
# reads skip includes and writes go to ~/.config/git/config.
.config/git/config.local

{{ if not (get (default (dict) (get . "hindsight")) "publicFixture") }}
# Hindsight has no consumer binding; only explicit public fixtures render it.
.agents/skills/hindsight-*
.config/hindsight-*
.hindsight*
.local/bin/hindsight-*
.local/lib/hindsight-*
{{ end }}

{{ if ne .chezmoi.os "darwin" }}
# OrbStack owns the managed Docker context on macOS.
.docker

# The zsh GUI path bridge is a launchd integration. These source trees contain
# no non-Darwin targets; the inventory test requires an explicit policy update
# before another target can be added beneath them.
Library
.local/libexec
{{ end }}

{{ if ne .chezmoi.os "linux" }}
# The provider selector, the systemd user units, and the build-tool shims that
# run builds in builds.slice, with the makepkg setting that goes with them, are
# Linux session integrations.
.config/environment.d/98-proton-pass.conf
.config/pacman/makepkg.conf
.config/systemd
.local/bin/cmake
.local/bin/makepkg
.local/bin/ninja
.local/lib/builds-slice

# Only Linux desktops read freedesktop desktop entries. These trees hold the
# protonpass:// and claude-cli:// scheme handlers and the Claude Desktop login
# entries, which launch through the secret-exec shims. The inventory test
# requires an explicit policy update before another target can be added beneath
# them.
.config/autostart
.local/share/applications
{{ end }}
