{{- $hindsight := .hindsight -}}
{{- if not (get $hindsight "publicFixture") -}}
{{- $private := include ".private-hindsight.toml.age" | decrypt | fromToml -}}
{{- $hindsight = $private.hindsight -}}
{{- end -}}
{
  "schema_version": 1,
  "hindsight_version": "0.8.4",
  "default_usage_limit_cooldown_seconds": 300,
  "failover_order": {{ $hindsight.failoverOrder | toJson }},
  "members": [
    {
      "id": "{{ $hindsight.primaryMemberId }}",
      "identity": {
        "provider": "{{ $hindsight.codexProvider }}",
        "model": "{{ $hindsight.codexModel }}",
        "base_url": "",
        "credential_marker": "provider-policy:{{ $hindsight.primaryMemberId }}"
      },
      "credential": {
        "mode": "oauth-home",
        "locator": "home-relative:{{ $hindsight.primaryCodexHome }}"
      },
      "timeout_seconds": null,
      "max_retries": null,
      "max_concurrent": null,
      "operation_priorities": {
        "default": 0,
        "reflect": 0,
        "retain": 20,
        "consolidation": 30
      },
      "quota_cooldown": true
    },
    {
      "id": "{{ $hindsight.secondaryMemberId }}",
      "identity": {
        "provider": "{{ $hindsight.codexProvider }}",
        "model": "{{ $hindsight.codexModel }}",
        "base_url": "",
        "credential_marker": "provider-policy:{{ $hindsight.secondaryMemberId }}"
      },
      "credential": {
        "mode": "oauth-home",
        "locator": "home-relative:{{ $hindsight.secondaryCodexHome }}"
      },
      "timeout_seconds": null,
      "max_retries": null,
      "max_concurrent": null,
      "operation_priorities": {
        "default": 0,
        "reflect": 0,
        "retain": 20,
        "consolidation": 30
      },
      "quota_cooldown": true
    },
    {
      "id": "{{ $hindsight.fallbackMemberId }}",
      "identity": {
        "provider": "{{ $hindsight.fallbackProvider }}",
        "model": "{{ $hindsight.fallbackModel }}",
        "base_url": "{{ $hindsight.fallbackBaseUrl }}",
        "credential_marker": null
      },
      "credential": {
        "mode": "none",
        "locator": null
      },
      "timeout_seconds": 300,
      "max_retries": 1,
      "max_concurrent": 1,
      "operation_priorities": {
        "default": 0,
        "reflect": 0,
        "retain": 20,
        "consolidation": 30
      },
      "quota_cooldown": false
    }
  ]
}
