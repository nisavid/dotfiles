{{- $config := default (dict) (get . "secretExec") -}}
{{- if not (get $config "publicFixture") -}}
{{- $config = include ".private-secret-exec.toml.age" | decrypt | fromToml -}}
{{- end -}}
{{- $github := get $config "github" -}}
{{- $bindings := get $github "byHostname" -}}
{{- $binding := index $bindings .chezmoi.hostname -}}
{{- if not $binding }}{{ fail (printf "no GitHub credential binding for host %q" .chezmoi.hostname) }}{{ end -}}
{{- $profileName := get $binding "profile" -}}
{{- $expectedLogin := get $binding "expectedLogin" -}}
{{- if or (not $profileName) (not $expectedLogin) }}{{ fail (printf "GitHub credential binding for host %q is incomplete" .chezmoi.hostname) }}{{ end -}}
# secret-exec-github-profile={{ $profileName }}
# secret-exec-github-login={{ $expectedLogin }}
{{ index $config.profiles $profileName -}}
