{{- $bindingData := .gitIdentity -}}
{{- if not (get $bindingData "publicFixture") -}}
{{- $bindingData = include ".private-git-identities.toml.age" | decrypt | fromToml -}}
{{- end -}}
{{- $identityName := default $bindingData.selection.default (index $bindingData.selection.byHostname .chezmoi.hostname) -}}
{{- $identity := index $bindingData.identities $identityName -}}
#!/bin/zsh -f

function main {
  emulate -L zsh
  setopt err_return no_unset pipe_fail

  local -r zshrc_dir={{ joinPath .chezmoi.homeDir ".config/zsh/zshrc.d" | quote }}
  local -r source_fragment=$zshrc_dir/no-tracking.zsh
  local -r local_fragment=$zshrc_dir/no-tracking.local.zsh
  if [[ -e $local_fragment && ! -L $local_fragment ]]; then
    print -ru2 -- "Cannot manage no-tracking: ${(q-)local_fragment} exists and is not a symbolic link."
    return 1
  fi

  local -r profile_dir={{ joinPath .chezmoi.homeDir ".config/zsh/profile.d" | quote }}
  if [[ -r $profile_dir/no-tracking.zshenv ]]; then
    local -r marker=$profile_dir/no-tracking.enabled
    if [[ -L $marker || ( -e $marker && ! -f $marker ) ]]; then
      print -ru2 -- "Cannot manage no-tracking: ${(q-)marker} is not a regular marker file."
      return 1
    fi
    if {{ if $identity.noTracking }}true{{ else }}false{{ end }}; then
      touch -- "$marker"
    else
      rm -f -- "$marker"
    fi
    # The profile dispatcher also treats a legacy link as an enable marker.
    # Retire it so switching to a personal identity really disables the policy.
    rm -f -- "$local_fragment"
    return
  fi

  # Retain compatibility with hosts that have not installed the pinned archive.
  if {{ if $identity.noTracking }}true{{ else }}false{{ end }}; then
    if [[ ! -r $source_fragment ]]; then
      print -ru2 -- "Cannot enable no-tracking: ${(q-)source_fragment} is not readable."
      return 1
    fi
    ln -sfn ${source_fragment:t} $local_fragment
  else
    rm -f -- $local_fragment
  fi
}

main "$@"
