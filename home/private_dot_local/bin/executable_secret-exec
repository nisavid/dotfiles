#!/bin/zsh -f

[[ -o xtrace ]] && unsetopt xtrace
PROTON_PASS_BOOTSTRAP_FIELD=PROTON_PASS_PERSONAL_ACCESS
PROTON_PASS_BOOTSTRAP_FIELD+=_TOKEN
readonly PROTON_PASS_BOOTSTRAP_FIELD
unset "$PROTON_PASS_BOOTSTRAP_FIELD" 2>/dev/null || true
# Provenance marker: names profiles whose values this launch exported. Never a
# value; an inherited copy is dropped so a failed launch cannot pass it on.
readonly SECRET_EXEC_MARKER=SECRET_EXEC_INJECTED_PROFILES
typeset -gr +x SECRET_EXEC_INHERITED_PROFILES=${SECRET_EXEC_INJECTED_PROFILES-}
unset "$SECRET_EXEC_MARKER" 2>/dev/null || true
set -euo pipefail

readonly SECRET_EXEC_SCRIPT_DIR=${0:A:h}
readonly SECRET_EXEC_PROVIDER_TIMEOUT_SECONDS=3
readonly SECRET_EXEC_POLL_CENTISECONDS=1
readonly SECRET_EXEC_TERMINATION_GRACE_CENTISECONDS=10
readonly SECRET_EXEC_NOTIFICATION_TIMEOUT_CENTISECONDS=200
typeset -g SECRET_EXEC_BEST_EFFORT_PROFILE=
typeset -ga SECRET_EXEC_TARGET_ARGV
typeset -g SECRET_EXEC_ACTIVE_CHILD_NAME=
typeset -gi SECRET_EXEC_ACTIVE_CHILD_PGID=0
typeset -gi SECRET_EXEC_CHILD_SEQUENCE=0
typeset -g SECRET_EXEC_GITHUB_PROFILE=
typeset -g SECRET_EXEC_GITHUB_EXPECTED_LOGIN=
typeset -g SECRET_EXEC_GITHUB_CONFIG_DIR=
integer SECRET_EXEC_ESCAPE_DIAGNOSTIC_FD

die() {
  print -u2 -r -- "secret-exec: $1"
  # Subshells report failure to the parent, which owns the fallback.
  [[ -z $SECRET_EXEC_BEST_EFFORT_PROFILE ]] || (( ZSH_SUBSHELL )) ||
    run_without_injection
  exit 1
}

escape_unmanageable_resolution() {
  if (( SECRET_EXEC_ESCAPE_DIAGNOSTIC_FD > 2 )); then
    print -u$SECRET_EXEC_ESCAPE_DIAGNOSTIC_FD -r -- "secret-exec: $1"
    exec {SECRET_EXEC_ESCAPE_DIAGNOSTIC_FD}>&- 2>/dev/null ||
      exec /usr/bin/false
  else
    print -u2 -r -- "secret-exec: $1"
  fi
  exec /usr/bin/false
}

active_resolution_identity_matches() {
  emulate -L zsh

  local child_name=$1
  integer expected_pgid=$2
  local listing child_listing
  listing=$(zpty 2>/dev/null) || return 1
  child_listing=${(M)${(f)listing}:#\(*\) ${child_name}:*}
  local child_state=${${child_listing#\(}%%\)*}
  [[ -n $child_listing && $child_state == <-> &&
    $child_state -eq expected_pgid ]]
}

terminate_active_resolution() {
  emulate -L zsh

  local child_name=${SECRET_EXEC_ACTIVE_CHILD_NAME:-}
  integer child_pgid=${SECRET_EXEC_ACTIVE_CHILD_PGID:-0}
  [[ -n $child_name && $child_pgid -gt 1 ]] || return 0

  zmodload zsh/zselect 2>/dev/null || true
  integer term_polls=$(( SECRET_EXEC_TERMINATION_GRACE_CENTISECONDS / 2 ))
  integer kill_polls=$(( SECRET_EXEC_TERMINATION_GRACE_CENTISECONDS - term_polls ))
  active_resolution_identity_matches "$child_name" $child_pgid &&
    kill -0 -- -$child_pgid 2>/dev/null ||
    escape_unmanageable_resolution 'bounded credential resolution became unmanageable'
  kill -TERM -- -$child_pgid 2>/dev/null || true
  while (( term_polls-- > 0 )) && kill -0 -- -$child_pgid 2>/dev/null; do
    zselect -t 1 2>/dev/null || true
  done
  active_resolution_identity_matches "$child_name" $child_pgid &&
    kill -0 -- -$child_pgid 2>/dev/null ||
    escape_unmanageable_resolution 'bounded credential resolution became unmanageable'
  zpty -d "$child_name" 2>/dev/null ||
    escape_unmanageable_resolution 'bounded credential resolution became unmanageable'

  while (( kill_polls-- > 0 )) && kill -0 -- -$child_pgid 2>/dev/null; do
    zselect -t 1 2>/dev/null || true
  done

  typeset -g SECRET_EXEC_ACTIVE_CHILD_NAME=
  typeset -gi SECRET_EXEC_ACTIVE_CHILD_PGID=0
}

start_bounded_resolution() {
  emulate -L zsh
  unsetopt bg_nice

  (( $# )) || die 'empty credential-resolution request'
  zmodload zsh/system || die 'zsh/system is required'
  zmodload zsh/zpty || die 'zsh/zpty is required'
  local -a SECRET_EXEC_CHILD_ARGV=("$@")
  integer SECRET_EXEC_CHILD_STDOUT_FD SECRET_EXEC_CHILD_STDERR_FD
  exec {SECRET_EXEC_CHILD_STDOUT_FD}>&1 || die 'cannot duplicate credential output'
  exec {SECRET_EXEC_CHILD_STDERR_FD}>&2 || {
    exec {SECRET_EXEC_CHILD_STDOUT_FD}>&-
    die 'cannot duplicate credential diagnostics'
  }

  (( ++SECRET_EXEC_CHILD_SEQUENCE ))
  local child_name="secret-exec-${sysparams[pid]}-$SECRET_EXEC_CHILD_SEQUENCE"
  # zpty supplies a portable session/PGID; provider bytes bypass its PTY.
  local child_wrapper='
integer child_diagnostic_status=0
exec {SECRET_EXEC_ESCAPE_DIAGNOSTIC_FD}>&- || child_diagnostic_status=125
trap '\''kill -KILL 0'\'' HUP
trap '\'''\'' TERM
unsetopt monitor
typeset child_start=
IFS= read -r child_start
integer child_start_status=$?
[[ $child_start == start ]] || child_start_status=126
unset child_start
integer child_status
if (( child_diagnostic_status != 0 )); then
  child_status=$child_diagnostic_status
elif (( child_start_status != 0 )); then
  child_status=126
else
  (
    trap - HUP TERM
    exec "${SECRET_EXEC_CHILD_ARGV[@]}" \
      >&$SECRET_EXEC_CHILD_STDOUT_FD 2>&$SECRET_EXEC_CHILD_STDERR_FD
  ) &
  integer credential_child_pid=$!
  wait $credential_child_pid
  child_status=$?
fi
zmodload zsh/zselect || child_status=125
integer group_quiescent=0
while (( ! group_quiescent )); do
  typeset group_listing=
  group_listing=$(trap - HUP TERM; exec /usr/bin/env -i LC_ALL=C /bin/ps -eo pid=,pgid=) || {
    child_status=125
    break
  }
  integer controller_seen=0 group_members=0 listing_valid=1
  typeset group_line=
  typeset -a group_fields
  for group_line in ${(f)group_listing}; do
    group_fields=( ${=group_line} )
    if (( ${#group_fields} != 2 )) ||
      [[ $group_fields[1] != <-> || $group_fields[2] != <-> ]]; then
      listing_valid=0
      break
    fi
    if (( group_fields[2] == sysparams[pid] )); then
      (( ++group_members ))
      (( group_fields[1] == sysparams[pid] )) && controller_seen=1
    fi
  done
  if (( ! listing_valid || ! controller_seen || group_members < 2 )); then
    child_status=125
    break
  fi
  (( group_members == 2 )) && group_quiescent=1
  (( group_quiescent )) || zselect -t 1 2>/dev/null || true
done
print -r -- "status:$child_status"
typeset child_finish=
IFS= read -r child_finish || kill -KILL 0'

  integer start_status=0
  zpty -b "$child_name" "$child_wrapper" || start_status=$?
  exec {SECRET_EXEC_CHILD_STDOUT_FD}>&-
  exec {SECRET_EXEC_CHILD_STDERR_FD}>&-
  (( start_status == 0 )) ||
    escape_unmanageable_resolution 'cannot identify credential-resolution process group'

  local listing child_listing
  listing=$(zpty 2>/dev/null) ||
    escape_unmanageable_resolution 'cannot identify credential-resolution process group'
  child_listing=${(M)${(f)listing}:#\(*\) ${child_name}:*}
  local child_pgid_text=${${child_listing#\(}%%\)*}
  if [[ -z $child_listing || $child_pgid_text != <-> ||
    $child_pgid_text -le 1 ]] ||
    ! kill -0 -- -$child_pgid_text 2>/dev/null ||
    ! kill -0 -- -$child_pgid_text 2>/dev/null; then
    escape_unmanageable_resolution 'cannot identify credential-resolution process group'
  fi
  typeset -g SECRET_EXEC_ACTIVE_CHILD_NAME=$child_name
  typeset -gi SECRET_EXEC_ACTIVE_CHILD_PGID=$child_pgid_text
  if ! zpty -w "$child_name" start; then
    terminate_active_resolution
    die 'cannot release bounded credential resolution'
  fi
}

wait_bounded_resolution() {
  emulate -L zsh

  local timeout_seconds=$1
  local child_name=$SECRET_EXEC_ACTIVE_CHILD_NAME
  integer child_pgid=$SECRET_EXEC_ACTIVE_CHILD_PGID
  zmodload zsh/datetime || die 'zsh/datetime is required'
  zmodload zsh/zselect || die 'zsh/zselect is required'
  local -F deadline=$(( EPOCHREALTIME + timeout_seconds ))

  # Nonblocking zpty reads may split a line; accumulate one bounded record.
  local status_record= status_chunk=
  integer status_max_length=32
  while [[ $status_record != *$'\n'* ]]; do
    status_chunk=
    if zpty -r -t "$child_name" status_chunk 2>/dev/null &&
      [[ -n $status_chunk ]]; then
      if (( ${#status_record} + ${#status_chunk} > status_max_length )); then
        status_record=invalid
        break
      fi
      status_record+=$status_chunk
      continue
    fi
    if ! kill -0 -- -$child_pgid 2>/dev/null; then
      if ! active_resolution_identity_matches "$child_name" $child_pgid ||
        ! kill -0 -- -$child_pgid 2>/dev/null; then
        status_record=invalid
        break
      fi
    fi
    if (( EPOCHREALTIME >= deadline )); then
      terminate_active_resolution
      return 124
    fi
    zselect -t "$SECRET_EXEC_POLL_CENTISECONDS" 2>/dev/null || true
  done
  [[ $status_record == status:<->$'\r\n' ||
    $status_record == status:<->$'\n' ]] || {
      terminate_active_resolution
      return 125
    }
  status_record=${status_record%$'\n'}
  status_record=${status_record%$'\r'}
  [[ $status_record == status:<-> ]] || {
    terminate_active_resolution
    return 125
  }
  integer child_status=${status_record#status:}
  if ! active_resolution_identity_matches "$child_name" $child_pgid ||
    ! kill -0 -- -$child_pgid 2>/dev/null ||
    ! zpty -d "$child_name" 2>/dev/null; then
    typeset -g SECRET_EXEC_ACTIVE_CHILD_NAME=
    typeset -gi SECRET_EXEC_ACTIVE_CHILD_PGID=0
    escape_unmanageable_resolution 'bounded credential resolution became unmanageable'
  fi
  typeset -g SECRET_EXEC_ACTIVE_CHILD_NAME=
  typeset -gi SECRET_EXEC_ACTIVE_CHILD_PGID=0
  integer finish_polls=$SECRET_EXEC_TERMINATION_GRACE_CENTISECONDS
  while (( finish_polls-- > 0 )) && kill -0 -- -$child_pgid 2>/dev/null; do
    zselect -t 1 2>/dev/null || true
  done
  kill -0 -- -$child_pgid 2>/dev/null && return 125
  # Reserve 124 for this waiter's absolute deadline, not a provider exit code.
  (( child_status == 124 )) && return 125
  return $child_status
}

run_bounded_resolution() {
  emulate -L zsh

  local timeout_seconds=$1
  shift
  start_bounded_resolution "$@"
  wait_bounded_resolution "$timeout_seconds"
}

trap 'terminate_active_resolution; remove_github_config_dir' EXIT
trap 'terminate_active_resolution; exit 129' HUP
trap 'terminate_active_resolution; exit 130' INT
trap 'terminate_active_resolution; exit 143' TERM

resolve_trusted_command() {
  emulate -L zsh

  local name=$1
  shift
  zmodload zsh/stat || die 'zsh/stat is required'
  local candidate
  for candidate in "$@"; do
    [[ $candidate == /* ]] || continue
    [[ -f $candidate && ! -L $candidate && -x $candidate ]] || continue
    local -A metadata
    zstat -H metadata -- "$candidate" || continue
    (( metadata[uid] == 0 || metadata[uid] == EUID )) || continue
    (( (metadata[mode] & 8#022) == 0 )) || continue
    print -r -- "$candidate"
    return 0
  done
  die "a trusted $name is required"
}

select_pass_cli_command() {
  emulate -L zsh

  command -v pass-cli >/dev/null 2>&1 || die 'pass-cli is required'
  print -r -- pass-cli
}

resolve_native_store_adapter() {
  emulate -L zsh

  resolve_trusted_command 'native-store adapter' \
    "$SECRET_EXEC_SCRIPT_DIR/secret-exec-native-store"
}

verify_private_mode() {
  emulate -L zsh

  local path=$1
  local expected_mode=$2
  local label=$3
  local -A item

  zmodload zsh/stat || die 'zsh/stat is required'
  zstat -H item -- "$path" || die "cannot inspect $label"
  (( item[uid] == EUID )) || die "$label must be owned by the current user"
  (( (item[mode] & 8#777) == 8#$expected_mode )) || \
    die "$label must have mode 0$expected_mode"
}

load_profiles() {
  emulate -L zsh
  setopt local_options extended_glob

  local profile_dir=$1
  local selected_profile=$2
  local mapping_pattern='^([A-Za-z_][A-Za-z0-9_]*)=(pass://[^[:space:]]+|secret-service://)$'
  local unset_pattern='^!([A-Za-z_][A-Za-z0-9_]*)$'
  local file profile line name reference key
  local -a files
  local -A profile_seen
  typeset -g SECRET_EXEC_GITHUB_PROFILE=
  typeset -g SECRET_EXEC_GITHUB_EXPECTED_LOGIN=

  [[ -d $profile_dir && ! -L $profile_dir ]] || die 'profile directory must be a real directory'
  verify_private_mode "$profile_dir" 700 'profile directory'
  files=("$profile_dir"/*.env(N.))
  (( ${#files} )) || die 'profile directory is empty'

  for file in "${files[@]}"; do
    [[ ! -L $file ]] || die "profile must not be a symbolic link: ${file:t}"
    [[ -f $file ]] || die "profile must be a regular file: ${file:t}"
    verify_private_mode "$file" 600 "profile ${file:t}"
    profile=${file:t:r}
    [[ $profile == [A-Za-z0-9][A-Za-z0-9_.-]# ]] || \
      die "invalid profile name: $profile"
    profile_seen[$profile]=1

    while IFS= read -r line || [[ -n $line ]]; do
      if [[ $profile == "$selected_profile" &&
        $line == '# secret-exec-github-profile='* ]]; then
        [[ -z $SECRET_EXEC_GITHUB_PROFILE ]] || die "duplicate GitHub profile marker in ${file:t}"
        SECRET_EXEC_GITHUB_PROFILE=${line#*=}
        [[ $SECRET_EXEC_GITHUB_PROFILE == [A-Za-z0-9_.-]## ]] ||
          die "invalid GitHub profile marker in ${file:t}"
      elif [[ $profile == "$selected_profile" &&
        $line == '# secret-exec-github-login='* ]]; then
        [[ -z $SECRET_EXEC_GITHUB_EXPECTED_LOGIN ]] || die "duplicate GitHub login marker in ${file:t}"
        SECRET_EXEC_GITHUB_EXPECTED_LOGIN=${line#*=}
        [[ $SECRET_EXEC_GITHUB_EXPECTED_LOGIN == [A-Za-z0-9_.-]## ]] ||
          die "invalid GitHub login marker in ${file:t}"
      fi
      [[ -z $line || $line == \#* ]] && continue
      if [[ $line =~ $unset_pattern ]]; then
        managed_names[$match[1]]=1
        continue
      fi
      [[ $line =~ $mapping_pattern ]] || die "invalid mapping in ${file:t}"
      name=$match[1]
      reference=$match[2]
      key=$profile:$name
      (( ! ${+profile_references[$key]} )) || \
        die "duplicate mapping for $name in $profile"
      profile_references[$key]=$reference
      managed_names[$name]=1
      [[ $profile == "$selected_profile" ]] && selected_references[$name]=$reference
    done < "$file"
  done

  (( ${+profile_seen[$selected_profile]} )) || die "unknown profile: $selected_profile"
  (( ${#selected_references} )) || die "unknown or empty profile: $selected_profile"
}

# Whoever can rename an entry in any directory above a trusted command can
# swap it after the command's own checks. Every such directory must belong to
# root or this user, and a world-writable one must be sticky with the next
# path component owned by root or this user. Group-writable directories stay
# trusted: their writers are this user's group or an administrator group, as
# with Homebrew's prefix.
verify_trusted_ancestors() {
  emulate -L zsh

  zmodload zsh/stat || return 1
  local child=$1
  local directory=${1:h}
  local -A metadata child_metadata
  while :; do
    zstat -H metadata -- "$directory" || return 1
    (( metadata[uid] == 0 || metadata[uid] == EUID )) || return 1
    if (( metadata[mode] & 8#002 )); then
      (( metadata[mode] & 8#1000 )) || return 1
      zstat -H child_metadata -- "$child" || return 1
      (( child_metadata[uid] == 0 || child_metadata[uid] == EUID )) || return 1
    fi
    [[ $directory != / ]] || return 0
    child=$directory
    directory=${directory:h}
  done
}

verify_github_identity() {
  emulate -L zsh

  [[ -n $SECRET_EXEC_GITHUB_PROFILE &&
    -n $SECRET_EXEC_GITHUB_EXPECTED_LOGIN ]] ||
    die 'GitHub identity self-check metadata is missing'
  [[ ${+GITHUB_PERSONAL_ACCESS_TOKEN} -eq 1 ]] ||
    die 'GitHub identity self-check credential is missing'

  local github_candidate
  github_candidate=$(command -v gh 2>/dev/null) ||
    die 'a trusted GitHub identity checker is required'
  [[ $github_candidate == /* ]] ||
    die 'a trusted GitHub identity checker is required'
  github_candidate=${github_candidate:A}
  local github_command
  github_command=$(resolve_trusted_command 'GitHub identity checker' \
    "$github_candidate") || return $?
  verify_trusted_ancestors "$github_command" ||
    die 'a trusted GitHub identity checker is required'
  # An empty private configuration keeps caller-controlled gh settings, such
  # as http_unix_socket, from rerouting the token-bearing request, provided no
  # other user can swap it under TMPDIR. The consumer ignores proxy and CA
  # variables, so the check drops them too.
  SECRET_EXEC_GITHUB_CONFIG_DIR=$(/usr/bin/mktemp -d \
    "${TMPDIR:-/tmp}/secret-exec-gh.XXXXXX" 2>/dev/null) ||
    die 'GitHub identity self-check failed'
  SECRET_EXEC_GITHUB_CONFIG_DIR=${SECRET_EXEC_GITHUB_CONFIG_DIR:P}
  verify_trusted_ancestors "$SECRET_EXEC_GITHUB_CONFIG_DIR" ||
    die 'GitHub identity self-check failed'
  local actual_login=
  integer check_status=0
  # Only the checker's subshell exports the resolved token as GH_TOKEN, so a
  # GH_TOKEN the caller set still reaches the consumer unchanged.
  actual_login=$(export GH_TOKEN=$GITHUB_PERSONAL_ACCESS_TOKEN
    run_bounded_resolution \
    "$SECRET_EXEC_PROVIDER_TIMEOUT_SECONDS" \
    /usr/bin/env -u HTTPS_PROXY -u https_proxy -u HTTP_PROXY -u http_proxy \
    -u ALL_PROXY -u all_proxy -u SSL_CERT_FILE -u SSL_CERT_DIR \
    GH_CONFIG_DIR="$SECRET_EXEC_GITHUB_CONFIG_DIR" \
    "$github_command" api --hostname github.com user --jq .login 2>/dev/null) ||
    check_status=$?
  remove_github_config_dir
  (( check_status == 0 )) || die 'GitHub identity self-check failed'
  [[ $actual_login == $SECRET_EXEC_GITHUB_EXPECTED_LOGIN ]] ||
    die 'GitHub identity self-check failed'
}

# Profiles whose launch verifies an identity after resolution. Today only github.
profile_checks_identity() {
  [[ $1 == github ]]
}

remove_github_config_dir() {
  [[ -n $SECRET_EXEC_GITHUB_CONFIG_DIR ]] || return 0
  /bin/rm -rf -- "$SECRET_EXEC_GITHUB_CONFIG_DIR" 2>/dev/null || true
  SECRET_EXEC_GITHUB_CONFIG_DIR=
}

scrub_managed_environment() {
  emulate -L zsh

  local name
  for name in "${(k)managed_names[@]}"; do
    unset "$name" || die "failed to remove inherited $name"
  done
}

# An enclosing launch already resolved this profile when the inherited marker
# names it and its values are still present: keep them, skip the provider, and
# still scrub every other managed name.
reuse_injected_profile() {
  emulate -L zsh

  local profile=$1
  shift
  # Reuse would skip the identity check, so these profiles always re-resolve.
  ! profile_checks_identity "$profile" || return 0
  local -a injected=("${(@s: :)SECRET_EXEC_INHERITED_PROFILES}")
  (( ${injected[(Ie)$profile]} )) || return 0
  local name value
  for name in "${(k)selected_references[@]}"; do
    value=${(P)name-}
    [[ -n $value && $value != *$'\n'* && $value != *$'\r'* ]] || return 0
  done
  for name in "${(k)managed_names[@]}"; do
    (( ${+selected_references[$name]} )) || unset "$name" ||
      die "failed to remove inherited $name"
  done
  export "$SECRET_EXEC_MARKER=$profile"
  exec "$@"
}

ensure_pass_provider_ready() {
  emulate -L zsh

  local reference
  local needs_provider=0
  for reference in "${(v)selected_references[@]}"; do
    if [[ $reference == pass://* ]]; then
      needs_provider=1
      break
    fi
  done
  (( needs_provider )) || return 0

  local candidate
  for candidate in \
    "$SECRET_EXEC_SCRIPT_DIR/proton-pass-ensure-ready" \
    "$SECRET_EXEC_SCRIPT_DIR/executable_proton-pass-ensure-ready"; do
    if [[ -f $candidate && ! -L $candidate && -x $candidate ]]; then
      if "$candidate" >/dev/null; then
        return 0
      else
        return $?
      fi
    fi
  done
  die 'proton-pass-ensure-ready is required for pass-backed profiles'
}

resolve_selected_secrets() {
  emulate -L zsh

  local name reference secret backend
  for name in "${(k)selected_references[@]}"; do
    reference=$selected_references[$name]
    case $reference in
      pass://*)
        backend=$(select_pass_cli_command) || return $?
        case $OSTYPE in
          linux*)
            export PROTON_PASS_LINUX_KEYRING=dbus
            ;;
          darwin*)
            unset PROTON_PASS_LINUX_KEYRING 2>/dev/null || true
            ;;
          *)
            die 'pass-backed profiles support only macOS and Linux'
            ;;
        esac
        local -x PROTON_PASS_AGENT_REASON='secret-exec credential resolution'
        local -x PROTON_PASS_NO_UPDATE_CHECK=1
        if secret=$(run_bounded_resolution \
          "$SECRET_EXEC_PROVIDER_TIMEOUT_SECONDS" \
          "$backend" item view --output human "$reference"); then
          :
        else
          integer resolution_status=$?
          (( resolution_status == 124 )) && die "timed out resolving $name"
          die "failed to resolve $name"
        fi
        unset PROTON_PASS_AGENT_REASON PROTON_PASS_NO_UPDATE_CHECK
        ;;
      secret-service://)
        backend=$(resolve_native_store_adapter) || return $?
        if secret=$(run_bounded_resolution \
          "$SECRET_EXEC_PROVIDER_TIMEOUT_SECONDS" \
          "$backend" lookup "$profile" "$name"); then
          :
        else
          integer resolution_status=$?
          (( resolution_status == 124 )) && die "timed out resolving $name"
          die "failed to resolve $name"
        fi
        ;;
      *)
        die "unsupported secret provider for $name"
        ;;
    esac
    [[ -n $secret && $secret != *$'\n'* && $secret != *$'\r'* ]] || \
      die "resolved value for $name must be one non-empty line"
    export "$name=$secret" || die "failed to bind $name"
  done
}

emit_aws_credentials() {
  emulate -L zsh
  setopt local_options extended_glob

  (( ${#selected_references} == 2 )) || \
    die 'AWS profile must contain exactly two mappings'
  (( ${+selected_references[AWS_ACCESS_KEY_ID]} )) || \
    die 'AWS profile is missing AWS_ACCESS_KEY_ID'
  (( ${+selected_references[AWS_SECRET_ACCESS_KEY]} )) || \
    die 'AWS profile is missing AWS_SECRET_ACCESS_KEY'
  [[ ! -t 1 ]] || die 'refusing to write AWS credentials to a terminal'
  [[ $AWS_ACCESS_KEY_ID == [A-Z0-9]## ]] || \
    die 'AWS access key has an invalid format'
  [[ $AWS_SECRET_ACCESS_KEY == [A-Za-z0-9/+=]## ]] || \
    die 'AWS secret key has an invalid format'

  print -r -- \
    '{"Version":1,"AccessKeyId":"'${AWS_ACCESS_KEY_ID}'","SecretAccessKey":"'${AWS_SECRET_ACCESS_KEY}'"}'
}

# Best-effort covers provider availability only: arm it after the profile
# contract has loaded and the inherited credential names are gone.
arm_best_effort() {
  typeset -g SECRET_EXEC_BEST_EFFORT_PROFILE=$1
  shift
  typeset -ga SECRET_EXEC_TARGET_ARGV=("$@")
}

abandon_injection() {
  [[ -z $SECRET_EXEC_BEST_EFFORT_PROFILE ]] || run_without_injection
  exit $1
}

notify_without_injection() {
  emulate -L zsh

  local title='Credentials unavailable'
  # Cause-neutral: stderr carries the value-free reason, as does the readiness
  # status when the readiness helper records the failure.
  local body="$2 started without its $1 credentials. Restart it once the credential provider is available."
  local -a notification
  case $OSTYPE in
    linux*)
      [[ ${commands[notify-send]:-} == /* ]] || return 0
      notification=("${commands[notify-send]}" --app-name='Secret-backed tools' "$title" "$body")
      ;;
    darwin*)
      [[ ${commands[osascript]:-} == /* ]] || return 0
      notification=("${commands[osascript]}" -e 'on run argv'
        -e 'display notification (item 1 of argv) with title (item 2 of argv)'
        -e 'end run' "$body" "$title")
      ;;
    *)
      return 0
      ;;
  esac
  # Detached and bounded, so the notifier never delays or outlives the launch.
  /bin/zsh -f -c '
zmodload zsh/zselect || exit 0
integer polls=$1
shift
"$@" &
integer notifier_pid=$!
while kill -0 $notifier_pid 2>/dev/null; do
  if (( polls-- <= 0 )); then
    kill -KILL $notifier_pid 2>/dev/null
    break
  fi
  zselect -t 1 2>/dev/null || true
done' secret-exec-notify \
    "$SECRET_EXEC_NOTIFICATION_TIMEOUT_CENTISECONDS" "${notification[@]}" \
    </dev/null >/dev/null 2>&1 &!
}

run_without_injection() {
  emulate -L zsh
  setopt local_options extended_glob

  local profile=$SECRET_EXEC_BEST_EFFORT_PROFILE
  typeset -g SECRET_EXEC_BEST_EFFORT_PROFILE=
  unset PROTON_PASS_AGENT_REASON PROTON_PASS_NO_UPDATE_CHECK 2>/dev/null || true
  scrub_managed_environment
  if (( SECRET_EXEC_ESCAPE_DIAGNOSTIC_FD > 2 )); then
    # A redirection-only exec returns the last command substitution's status,
    # usually the failed resolution here, so that status says nothing.
    exec {SECRET_EXEC_ESCAPE_DIAGNOSTIC_FD}>&- || true
    SECRET_EXEC_ESCAPE_DIAGNOSTIC_FD=0
  fi
  local command_name=${SECRET_EXEC_TARGET_ARGV[1]:t}
  [[ $command_name == [A-Za-z0-9][A-Za-z0-9_.+-]# ]] || command_name='A command'
  print -u2 -r -- "secret-exec: starting $command_name without $profile credentials"
  notify_without_injection "$profile" "$command_name"
  exec "${SECRET_EXEC_TARGET_ARGV[@]}"
}

main() {
  emulate -L zsh
  setopt local_options extended_glob pipe_fail

  local usage='usage: secret-exec [--best-effort] <profile> -- <command> [args...] | secret-exec aws-credential-process <profile>'
  (( $# )) || die "$usage"

  local mode=exec
  local profile best_effort=
  if [[ $1 == --best-effort ]]; then
    best_effort=1
    shift
    [[ ${1:-} != (|aws-credential-process) ]] || die "$usage"
  fi
  if [[ $1 == aws-credential-process ]]; then
    mode=aws
    (( $# == 2 )) || die 'usage: secret-exec aws-credential-process <profile>'
    profile=$2
  else
    profile=$1
    shift
    [[ ${1:-} == -- ]] || die 'expected -- before the command'
    shift
    (( $# )) || die 'a target command is required'
  fi

  local profile_dir=${XDG_CONFIG_HOME:-$HOME/.config}/secret-exec/profiles
  typeset -gA profile_references managed_names selected_references
  profile_references=()
  managed_names=()
  selected_references=()

  load_profiles "$profile_dir" "$profile"
  [[ -z ${managed_names[(I)SECRET_EXEC_*]} ]] ||
    die 'profiles must not manage SECRET_EXEC_* names'
  [[ $mode != exec ]] || reuse_injected_profile "$profile" "$@"
  scrub_managed_environment
  [[ -z $best_effort ]] || arm_best_effort "$profile" "$@"
  ensure_pass_provider_ready || abandon_injection $?
  exec {SECRET_EXEC_ESCAPE_DIAGNOSTIC_FD}>&2 ||
    die 'cannot preserve diagnostic channel'
  resolve_selected_secrets || abandon_injection $?

  if [[ $mode == aws ]]; then
    emit_aws_credentials
    return
  fi

  if profile_checks_identity "$profile"; then
    # Best-effort covers the provider only. Any identity-check failure,
    # including a missing or failing checker, fails closed.
    typeset -g SECRET_EXEC_BEST_EFFORT_PROFILE=
    verify_github_identity || return $?
  fi
  exec {SECRET_EXEC_ESCAPE_DIAGNOSTIC_FD}>&- ||
    escape_unmanageable_resolution 'cannot close diagnostic channel'
  # The scrub removed every other profile's values, so replace, never append.
  export "$SECRET_EXEC_MARKER=$profile"
  exec "$@"
}

main "$@"
