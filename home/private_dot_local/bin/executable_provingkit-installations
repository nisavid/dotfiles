#!/usr/bin/env python3
"""Verify offline recovery artifacts or manage a selected Provingkit installation."""

from __future__ import annotations

import argparse
import hashlib
import io
import json
import os
import platform
import re
import shutil
import stat
import subprocess
import tarfile
import tempfile
from contextlib import contextmanager
from copy import deepcopy
from pathlib import Path, PurePosixPath

TARGETS = {"codex": "agent-plugins", "claude": "claude", "cursor": "cursor"}
CATALOGS = {
    "agent-plugins": ".agents/plugins/marketplace.json",
    "claude": ".claude-plugin/marketplace.json",
    "cursor": ".cursor-plugin/marketplace.json",
}
MEMBERS = {
    "rolecasting",
    "tricritical",
    "versionkeeping",
    "mergecraft",
    "artifact-customs",
    "proseweaving",
}
REPOSITORY = "https://github.com/nisavid/provingkit"


def require(condition: bool, message: str) -> None:
    if not condition:
        raise ValueError(message)


def digest(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def is_digest(value: object, length: int = 64) -> bool:
    return (
        isinstance(value, str)
        and re.fullmatch(f"[0-9a-f]{{{length}}}", value) is not None
    )


def relative(value: object) -> bool:
    if not isinstance(value, str):
        return False
    path = PurePosixPath(value)
    return (
        value == path.as_posix()
        and not path.is_absolute()
        and value not in ("", ".")
        and ".." not in path.parts
    )


def validate_recoveries(selection: dict) -> None:
    recoveries = selection.get("recovery_packets", {})
    require(isinstance(recoveries, dict), "recovery_packets must be an object")
    for name, record in recoveries.items():
        require(isinstance(name, str) and bool(name), "recovery name is missing")
        require(
            isinstance(record, dict)
            and set(record)
            == {
                "schema",
                "version",
                "source",
                "platform",
                "packet",
                "manifest_sha256",
                "intended_remote_path",
                "retention",
            },
            "recovery record field set differs",
        )
        require(
            record["schema"] == "provingkit-recovery-selection-v1",
            "unsupported recovery schema",
        )
        require(record["version"] == "0.1.0-alpha.4", "unsupported recovery version")
        require(
            isinstance(record["source"], dict)
            and set(record["source"]) == {"repository", "commit"}
            and record["source"]["repository"] == REPOSITORY
            and is_digest(record["source"]["commit"], 40),
            "invalid recovery source",
        )
        require(
            isinstance(record["platform"], dict)
            and set(record["platform"]) == {"os", "arch"}
            and all(
                isinstance(value, str) and value
                for value in record["platform"].values()
            ),
            "invalid recovery platform",
        )
        require(
            isinstance(record["packet"], dict)
            and set(record["packet"]) == {"bytes", "sha256"}
            and type(record["packet"]["bytes"]) is int
            and record["packet"]["bytes"] > 0
            and is_digest(record["packet"]["sha256"])
            and is_digest(record["manifest_sha256"]),
            "invalid recovery packet pins",
        )
        remote = record["intended_remote_path"]
        require(
            isinstance(remote, str)
            and remote.startswith("/my-files/")
            and relative(remote[1:]),
            "invalid recovery intended remote path",
        )
        require(
            record["retention"] == "keep-until-approved-retirement",
            "unsupported recovery retention",
        )


def validate(selection: dict) -> dict | None:
    require(
        selection["schema"] == "provingkit-installations-v1",
        "unsupported projection schema",
    )
    validate_recoveries(selection)
    profile = selection["profile"]
    if profile is None:
        require(selection["profile_name"] is None, "inactive profile must have no name")
        return None
    require(
        isinstance(selection["profile_name"], str) and bool(selection["profile_name"]),
        "profile name is missing",
    )
    require(
        profile["schema"] == "provingkit-installation-selection-v1",
        "unsupported selection schema",
    )
    require(
        profile["source"]["repository"] == REPOSITORY, "unexpected source repository"
    )
    require(
        is_digest(profile["source"]["commit"], 40),
        "source commit must be a full lowercase Git SHA",
    )
    require(
        profile["adoption"]["stage"] in ("ad_hoc", "preview", "release"),
        "unsupported adoption stage",
    )
    require(
        all(
            isinstance(profile["adoption"][key], str) and profile["adoption"][key]
            for key in ("identity", "record")
        ),
        "adoption identity and record are required",
    )
    members = profile["artifact_slate"]
    require(
        isinstance(members, list)
        and bool(members)
        and all(m in MEMBERS for m in members)
        and len(members) == len(set(members)),
        "invalid member slate",
    )
    for platform_spec in (profile["platform"], selection["host_platform"]):
        require(
            set(platform_spec) == {"os", "arch"}
            and all(isinstance(v, str) for v in platform_spec.values()),
            "invalid platform",
        )
    require(
        isinstance(profile["clients"], dict) and bool(profile["clients"]),
        "no selected clients",
    )
    targets = set()
    for client, choice in profile["clients"].items():
        require(client in TARGETS, "unsupported client")
        require(
            choice.get("marketplace", "provingkit")
            in (
                ("provingkit", "provingkit-local")
                if client == "codex"
                else ("provingkit",)
            ),
            "unsupported native marketplace identity",
        )
        target = TARGETS[client]
        targets.add(target)
        require(choice["artifact"] == target, "client artifact target differs")
        require(
            choice["route"]
            == ("user_local_directory" if client == "cursor" else "native_marketplace"),
            "unsupported client route",
        )
        require(
            choice["scope"] == ("implicit_user" if client == "codex" else "user"),
            "unsupported client scope",
        )
        require(
            bool(choice["members"]) and set(choice["members"]) <= set(members),
            "client members differ from slate",
        )
        require(
            all(
                set(value) == {"enabled"} and isinstance(value["enabled"], bool)
                for value in choice["members"].values()
            ),
            "member enablement must be boolean",
        )
    require(
        set(profile["artifacts"]) == targets,
        "artifacts differ from selected client targets",
    )
    for target, artifact in profile["artifacts"].items():
        require(artifact["catalog"] == CATALOGS[target], "unexpected catalog path")
        require(is_digest(artifact["artifact_sha256"]), "invalid artifact digest")
        require(
            relative(artifact["archive"]["root"])
            and "/" not in artifact["archive"]["root"],
            "invalid archive root",
        )
        for kind in ("archive", "receipt", "modes"):
            require(is_digest(artifact[kind]["sha256"]), f"invalid {kind} digest")
            require(
                isinstance(artifact[kind]["url"], str)
                and (
                    artifact[kind]["url"].startswith("https://")
                    or (
                        os.environ.get("PROVINGKIT_TEST_LOCAL_ARTIFACTS") == "1"
                        and artifact[kind]["url"].startswith("file:///")
                    )
                ),
                f"{kind} URL must use HTTPS (local files require explicit fixture mode)",
            )
    require(
        profile["retirements"] == [],
        "retirement operations are not supported by this producer",
    )
    return profile


def files(root: Path) -> dict[str, list]:
    """Read regular file bytes and modes, following the projector verification recipe."""
    require(stat.S_ISDIR(root.lstat().st_mode), f"not a directory: {root}")
    result = {}
    for path in sorted(root.rglob("*")):
        mode = path.lstat().st_mode
        if stat.S_ISDIR(mode):
            continue
        require(stat.S_ISREG(mode), f"non-regular artifact file: {path}")
        result[path.relative_to(root).as_posix()] = [
            digest(path.read_bytes()),
            stat.S_IMODE(mode),
        ]
    return result


def artifact_root(home: Path, target: str, artifact: dict) -> Path:
    return (
        home
        / ".local/share/provingkit/artifacts"
        / target
        / artifact["artifact_sha256"]
    )


def verify_artifact(home: Path, profile: dict, target: str) -> Path:
    artifact = profile["artifacts"][target]
    root = artifact_root(home, target, artifact)
    evidence = (
        home / ".local/share/provingkit/evidence" / target / artifact["artifact_sha256"]
    )
    actual = files(root)
    raw = (root / "RECEIPT.json").read_bytes()
    require(
        raw == (evidence / "RECEIPT.json").read_bytes(),
        "extracted and separate receipt bytes differ",
    )
    require(digest(raw) == artifact["receipt"]["sha256"], "receipt digest differs")
    receipt = json.loads(raw)
    require(
        set(receipt)
        == {
            "artifact_sha256",
            "builder",
            "files",
            "plugin_slate",
            "policy_sha256",
            "schema",
            "source",
            "target",
        },
        "receipt field set differs",
    )
    require(
        receipt["schema"] == "provingkit-artifact-receipt-v1", "receipt schema differs"
    )
    commit = profile["source"]["commit"]
    require(
        receipt["builder"]
        == {"name": "provingkit-artifact-projector-v1", "revision": commit},
        "receipt builder differs",
    )
    source = receipt["source"]
    require(
        source
        == dict(
            profile["source"],
            channel=source["channel"],
            preview_label="preview-" + commit[:12],
        )
        and source["channel"] in ("preview", "main", "release"),
        "receipt source differs",
    )
    require(
        receipt["target"] == target
        and receipt["plugin_slate"] == profile["artifact_slate"],
        "receipt target or slate differs",
    )
    require(is_digest(receipt["policy_sha256"]), "invalid receipt policy digest")
    inventory = []
    framed = hashlib.sha256(b"provingkit-tree-v1\0")
    for name in sorted(set(actual) - {"RECEIPT.json"}):
        data = (root / name).read_bytes()
        inventory.append({"path": name, "sha256": digest(data)})
        encoded = name.encode()
        framed.update(
            len(encoded).to_bytes(8, "big")
            + encoded
            + len(data).to_bytes(8, "big")
            + data
        )
    require(
        receipt["files"] == inventory, "receipt inventory differs from artifact bytes"
    )
    require(
        framed.hexdigest() == receipt["artifact_sha256"] == artifact["artifact_sha256"],
        "artifact tree digest differs",
    )
    mode_bytes = (evidence / "modes.tsv").read_bytes()
    require(
        digest(mode_bytes) == artifact["modes"]["sha256"],
        "mode manifest digest differs",
    )
    lines = mode_bytes.decode().splitlines()
    require(
        bool(lines) and lines[0] == "path\tmode\torigin", "mode manifest header differs"
    )
    modes = {}
    for line in lines[1:]:
        name, mode, _origin = line.split("\t", 2)
        require(
            relative(name)
            and name not in modes
            and re.fullmatch(r"0[0-7]{3}", mode) is not None,
            "invalid mode manifest row",
        )
        modes[name] = int(mode, 8)
    require(
        set(modes) == set(actual) - {"RECEIPT.json"}, "mode manifest inventory differs"
    )
    require(
        all(actual[name][1] == mode for name, mode in modes.items()),
        "artifact modes differ",
    )
    catalog = json.loads((root / artifact["catalog"]).read_text())
    require(catalog["name"] == "provingkit", "marketplace name differs")
    require(
        [item["name"] for item in catalog["plugins"]] == profile["artifact_slate"],
        "catalog differs from the artifact slate",
    )
    return root


def recovery_tar(raw: bytes) -> dict[str, tuple[bytes | None, int]]:
    """Read a tar's effective paths without granting it filesystem authority."""
    entries = {}
    with tarfile.open(fileobj=io.BytesIO(raw), mode="r:gz") as archive:
        require(set(archive.pax_headers) <= {"path"}, "unsupported archive PAX headers")
        for item in archive:
            require(
                set(item.pax_headers) <= {"path"}, "unsupported archive PAX headers"
            )
            require(
                not item.issparse() and (item.isdir() or item.isreg()),
                "archive must contain only regular files and directories",
            )
            name = (
                item.name[:-1]
                if item.isdir() and item.name.endswith("/")
                else item.name
            )
            require(relative(name) and "\\" not in name, "unsafe archive path")
            require(name not in entries, "duplicate archive path")
            require(0 <= item.mode <= 0o777, "unsupported archive mode")
            if item.isdir():
                data = None
            else:
                stream = archive.extractfile(item)
                require(stream is not None, "archive file is unreadable")
                data = stream.read()
                require(len(data) == item.size, "archive file is truncated")
            entries[name] = (data, item.mode)
    for name in entries:
        for parent in PurePosixPath(name).parents:
            if parent.as_posix() in entries:
                require(
                    entries[parent.as_posix()][0] is None,
                    "conflicting archive ancestry",
                )
    return entries


def recovery_json_object(pairs: list) -> dict:
    result = {}
    for key, value in pairs:
        require(key not in result, "duplicate recovery JSON field")
        result[key] = value
    return result


def recovery_manifest(packet: Path, record: dict) -> tuple[dict, dict]:
    require(
        packet.stat().st_size == record["packet"]["bytes"],
        "recovery packet size differs",
    )
    raw = packet.read_bytes()
    require(digest(raw) == record["packet"]["sha256"], "recovery packet digest differs")
    entries = recovery_tar(raw)
    require("MANIFEST.json" in entries, "recovery manifest is missing")
    manifest_raw = entries["MANIFEST.json"][0]
    require(
        isinstance(manifest_raw, bytes)
        and digest(manifest_raw) == record["manifest_sha256"],
        "recovery manifest digest differs",
    )
    manifest = json.loads(manifest_raw, object_pairs_hook=recovery_json_object)
    require(
        set(manifest)
        == {"schema", "version", "source", "artifact_slate", "files", "targets"}
        and manifest["schema"] == "provingkit-artifact-recovery-packet-v1",
        "recovery manifest schema or fields differ",
    )
    require(
        manifest["version"] == record["version"]
        and manifest["source"] == record["source"],
        "recovery manifest source or version differs",
    )
    require(
        isinstance(manifest["artifact_slate"], list)
        and len(manifest["artifact_slate"]) == len(MEMBERS)
        and set(manifest["artifact_slate"]) == MEMBERS,
        "recovery artifact slate differs",
    )
    require(
        set(manifest["targets"]) == {"agent-plugins", "agent-plugins-local", "claude"},
        "recovery targets differ",
    )
    inventory = {}
    for item in manifest["files"]:
        require(
            set(item) == {"path", "bytes", "sha256"}
            and relative(item["path"])
            and item["path"] not in inventory
            and type(item["bytes"]) is int
            and item["bytes"] >= 0
            and is_digest(item["sha256"]),
            "invalid recovery file inventory",
        )
        inventory[item["path"]] = item
    expected = {"RECOVER.md"}
    for target, specification in manifest["targets"].items():
        require(
            set(specification)
            == {
                "kind",
                "archive",
                "artifact_sha256",
                "catalog",
                "directories",
                "receipt",
                "receipt_mode",
                "modes",
            },
            "recovery target fields differ",
        )
        canonical_target = (
            "agent-plugins" if target == "agent-plugins-local" else target
        )
        require(
            specification["kind"]
            == ("codex_local_alias" if target == "agent-plugins-local" else "ordinary")
            and specification["catalog"] == CATALOGS[canonical_target]
            and is_digest(specification["artifact_sha256"]),
            "invalid recovery target identity",
        )
        for kind, path in (
            ("archive", f"artifacts/{target}.tar.gz"),
            ("receipt", f"receipts/{target}.json"),
            ("modes", f"modes/{target}.tsv"),
        ):
            reference = specification[kind]
            require(
                set(reference)
                == (
                    {"path", "sha256", "root"}
                    if kind == "archive"
                    else {"path", "sha256"}
                )
                and reference["path"] == path
                and is_digest(reference["sha256"]),
                "invalid recovery constituent reference",
            )
            require(
                path in inventory and inventory[path]["sha256"] == reference["sha256"],
                "recovery constituent pin differs",
            )
            expected.add(path)
        require(
            relative(specification["archive"]["root"])
            and "/" not in specification["archive"]["root"],
            "invalid recovery archive root",
        )
        require(
            isinstance(specification["directories"], dict)
            and "." in specification["directories"],
            "missing recovery directory inventory",
        )
        for name, mode in specification["directories"].items():
            require(
                (name == "." or relative(name))
                and isinstance(mode, str)
                and re.fullmatch(r"0[0-7]{3}", mode),
                "invalid recovery directory mode",
            )
        require(
            specification["receipt_mode"] == "0600", "invalid recovery receipt mode"
        )
    require(
        set(inventory) == expected and set(entries) == expected | {"MANIFEST.json"},
        "recovery packet inventory differs",
    )
    contents = {}
    for name, item in inventory.items():
        data, mode = entries[name]
        require(
            isinstance(data, bytes)
            and len(data) == item["bytes"]
            and digest(data) == item["sha256"],
            "recovery constituent bytes differ",
        )
        require(mode == 0o600, "recovery constituent mode differs")
        contents[name] = data
    return manifest, contents


def recovery_directory_modes(root: Path) -> dict[str, str]:
    require(stat.S_ISDIR(root.lstat().st_mode), "recovery artifact is not a directory")
    result = {".": format(stat.S_IMODE(root.lstat().st_mode), "04o")}
    for path in root.rglob("*"):
        mode = path.lstat().st_mode
        require(
            stat.S_ISDIR(mode) or stat.S_ISREG(mode),
            "non-regular recovery artifact entry",
        )
        if stat.S_ISDIR(mode):
            result[path.relative_to(root).as_posix()] = format(
                stat.S_IMODE(mode), "04o"
            )
    return result


def verify_recovery_target(home: Path, manifest: dict, target: str) -> None:
    specification = manifest["targets"][target]
    root = artifact_root(home, target, specification)
    evidence = (
        home
        / ".local/share/provingkit/evidence"
        / target
        / specification["artifact_sha256"]
    )
    require(
        recovery_directory_modes(root) == specification["directories"],
        "recovery directory modes or inventory differ",
    )
    require(
        recovery_directory_modes(evidence) == {".": "0700"}
        and set(files(evidence)) == {"RECEIPT.json", "modes.tsv"},
        "recovery evidence inventory or directory modes differ",
    )
    require(
        all(mode == 0o600 for _sha, mode in files(evidence).values()),
        "recovery evidence file modes differ",
    )
    receipt = (root / "RECEIPT.json").read_bytes()
    require(
        stat.S_IMODE((root / "RECEIPT.json").lstat().st_mode)
        == int(specification["receipt_mode"], 8),
        "recovery receipt mode differs",
    )
    require(
        receipt == (evidence / "RECEIPT.json").read_bytes()
        and digest(receipt) == specification["receipt"]["sha256"],
        "recovery receipt bytes differ",
    )
    require(
        digest((evidence / "modes.tsv").read_bytes())
        == specification["modes"]["sha256"],
        "recovery modes bytes differ",
    )
    if target != "agent-plugins-local":
        verify_artifact(
            home,
            {
                "source": manifest["source"],
                "artifact_slate": manifest["artifact_slate"],
                "artifacts": manifest["targets"],
            },
            target,
        )
        return
    canonical = artifact_root(
        home, "agent-plugins", manifest["targets"]["agent-plugins"]
    )
    require(
        recovery_directory_modes(root) == recovery_directory_modes(canonical),
        "recovery alias directory inventory or modes differ from parent",
    )
    actual, parent_files = files(root), files(canonical)
    require(set(actual) == set(parent_files), "recovery alias file inventory differs")
    catalog_path = CATALOGS["agent-plugins"]
    catalog = (canonical / catalog_path).read_bytes()
    needle = b'"name":"provingkit"'
    require(catalog.count(needle) == 1, "unsupported canonical catalog encoding")
    framed = hashlib.sha256(b"provingkit-tree-v1\0")
    for name in sorted(set(actual) - {"RECEIPT.json"}):
        data = (root / name).read_bytes()
        expected = (
            catalog.replace(needle, b'"name":"provingkit-local"', 1)
            if name == catalog_path
            else (canonical / name).read_bytes()
        )
        require(
            data == expected and actual[name][1] == parent_files[name][1],
            "recovery alias content or mode differs",
        )
        encoded = name.encode()
        framed.update(
            len(encoded).to_bytes(8, "big")
            + encoded
            + len(data).to_bytes(8, "big")
            + data
        )
    require(
        framed.hexdigest() == specification["artifact_sha256"],
        "recovery alias tree digest differs",
    )
    parent_receipt = (canonical / "RECEIPT.json").read_bytes()
    require(
        json.loads(receipt, object_pairs_hook=recovery_json_object)
        == {
            "schema": "provingkit-local-marketplace-projection-v1",
            "source_commit": manifest["source"]["commit"],
            "parent_receipt_sha256": digest(parent_receipt),
            "change": {
                "path": catalog_path,
                "field": "name",
                "from": "provingkit",
                "to": "provingkit-local",
            },
            "plugin_slate": manifest["artifact_slate"],
        },
        "recovery alias receipt is not parent-bound",
    )
    canonical_evidence = (
        home
        / ".local/share/provingkit/evidence/agent-plugins"
        / manifest["targets"]["agent-plugins"]["artifact_sha256"]
    )
    require(
        (evidence / "modes.tsv").read_bytes()
        == (canonical_evidence / "modes.tsv").read_bytes(),
        "recovery alias modes differ from parent",
    )


class RecoveryRefused(ValueError):
    """Existing recovery destinations cannot be preserved by this import."""


def recovery_destination(home: Path, destination: Path) -> None:
    for path in (destination, *destination.parents):
        if (path.exists() or path.is_symlink()) and not stat.S_ISDIR(
            path.lstat().st_mode
        ):
            raise RecoveryRefused(
                f"recovery destination or ancestor is not a real directory: {path}"
            )
        if path == home:
            break


def import_recovery(home: Path, record: dict, packet: Path) -> dict:
    manifest, contents = recovery_manifest(packet, record)
    with tempfile.TemporaryDirectory(prefix="provingkit-recovery-") as temporary:
        staging = Path(temporary)
        for target, specification in manifest["targets"].items():
            entries = recovery_tar(contents[specification["archive"]["path"]])
            archive_root = specification["archive"]["root"]
            require(
                archive_root in entries
                and entries[archive_root][0] is None
                and all(
                    name == archive_root or name.startswith(archive_root + "/")
                    for name in entries
                ),
                "recovery archive root differs",
            )
            root = artifact_root(staging, target, specification)
            root.mkdir(parents=True, mode=entries[archive_root][1])
            root.chmod(entries[archive_root][1])
            for name, (data, mode) in entries.items():
                if name == archive_root:
                    continue
                path = root / name[len(archive_root) + 1 :]
                if data is None:
                    path.mkdir(parents=True, exist_ok=True)
                else:
                    path.parent.mkdir(parents=True, exist_ok=True)
                    path.write_bytes(data)
                path.chmod(mode)
            evidence = (
                staging
                / ".local/share/provingkit/evidence"
                / target
                / specification["artifact_sha256"]
            )
            evidence.mkdir(parents=True, mode=0o700)
            for name, data in (
                ("RECEIPT.json", contents[specification["receipt"]["path"]]),
                ("modes.tsv", contents[specification["modes"]["path"]]),
            ):
                path = evidence / name
                path.write_bytes(data)
                path.chmod(0o600)
        for target in ("agent-plugins", "claude", "agent-plugins-local"):
            verify_recovery_target(staging, manifest, target)
        destinations = []
        for target, specification in manifest["targets"].items():
            for kind in ("artifacts", "evidence"):
                source = (
                    staging
                    / ".local/share/provingkit"
                    / kind
                    / target
                    / specification["artifact_sha256"]
                )
                destination = (
                    home
                    / ".local/share/provingkit"
                    / kind
                    / target
                    / specification["artifact_sha256"]
                )
                recovery_destination(home, destination)
                if destination.exists():
                    try:
                        require(
                            recovery_directory_modes(destination)
                            == recovery_directory_modes(source)
                            and files(destination) == files(source),
                            "existing recovery destination differs",
                        )
                    except (OSError, ValueError) as error:
                        raise RecoveryRefused(
                            f"existing recovery destination differs: {destination}: {error}"
                        ) from error
                destinations.append((target, source, destination, destination.exists()))
        reports = {}
        imported = False
        for target, source, destination, existing in destinations:
            row = reports.setdefault(
                target,
                {
                    "outcome": "verified",
                    "artifact_sha256": manifest["targets"][target]["artifact_sha256"],
                },
            )
            if existing:
                recovery_destination(home, destination)
                try:
                    require(
                        recovery_directory_modes(destination)
                        == recovery_directory_modes(source)
                        and files(destination) == files(source),
                        "existing recovery destination changed",
                    )
                except (OSError, ValueError) as error:
                    raise RecoveryRefused(
                        f"existing recovery destination changed: {destination}: {error}"
                    ) from error
                continue
            recovery_destination(home, destination)
            destination.parent.mkdir(parents=True, exist_ok=True)
            try:
                shutil.copytree(source, destination)
            except FileExistsError as error:
                raise RecoveryRefused(
                    f"recovery destination appeared during publication: {destination}"
                ) from error
            imported = True
            row["outcome"] = "imported"
        return {
            "outcome": "artifacts_imported" if imported else "artifacts_verified",
            "clients": {},
            "targets": reports,
        }


class Unavailable(Exception):
    """A supported, observed operation cannot establish the selected state."""


def native_require(condition: bool, message: str) -> None:
    if not condition:
        raise Unavailable(message)


def unique_json_object(pairs: list) -> dict:
    result = {}
    for key, value in pairs:
        native_require(key not in result, "duplicate native marker field")
        result[key] = value
    return result


def installed_inventory(client: str, root: Path) -> tuple[dict, dict]:
    """Separate Claude's validated, volatile process markers from payload identity."""
    actual = files(root)
    markers = {}
    marker_root = root / ".in_use"
    if client == "claude" and (marker_root.exists() or marker_root.is_symlink()):
        native_require(
            stat.S_ISDIR(marker_root.lstat().st_mode), "invalid Claude marker directory"
        )
        for path in marker_root.iterdir():
            native_require(
                stat.S_ISREG(path.lstat().st_mode)
                and re.fullmatch(r"[1-9][0-9]*", path.name) is not None,
                "unrecognized Claude process marker",
            )
            raw = path.read_bytes()
            native_require(
                0 < len(raw) <= 4096, "incomplete or oversized Claude process marker"
            )
            value = json.loads(
                raw.decode("utf-8"), object_pairs_hook=unique_json_object
            )
            native_require(
                isinstance(value, dict)
                and set(value) in ({"pid"}, {"pid", "procStart"})
                and type(value["pid"]) is int
                and str(value["pid"]) == path.name
                and (
                    "procStart" not in value
                    or (
                        isinstance(value["procStart"], str)
                        and re.fullmatch(r"[0-9]+", value["procStart"]) is not None
                    )
                ),
                "unrecognized Claude process marker contents",
            )
            relative_path = path.relative_to(root).as_posix()
            markers[relative_path] = actual.pop(relative_path)
    return actual, markers


@contextmanager
def installation_view(root: Path, choice: dict):
    """Derive the fixed Codex alias from an already verified canonical artifact."""
    if choice.get("marketplace", "provingkit") == "provingkit":
        yield root
        return
    catalog_path = CATALOGS["agent-plugins"]
    canonical = (root / catalog_path).read_bytes()
    needle = b'"name":"provingkit"'
    native_require(
        canonical.count(needle) == 1, "unsupported canonical catalog encoding"
    )
    parent_bytes = (root / "RECEIPT.json").read_bytes()
    parent = json.loads(parent_bytes)
    with tempfile.TemporaryDirectory(prefix="provingkit-alias-") as temporary:
        view = Path(temporary) / "view"
        shutil.copytree(root, view)
        (view / catalog_path).write_bytes(
            canonical.replace(needle, b'"name":"provingkit-local"', 1)
        )
        derived = {
            "schema": "provingkit-local-marketplace-projection-v1",
            "source_commit": parent["source"]["commit"],
            "parent_receipt_sha256": digest(parent_bytes),
            "change": {
                "path": catalog_path,
                "field": "name",
                "from": "provingkit",
                "to": "provingkit-local",
            },
            "plugin_slate": parent["plugin_slate"],
        }
        (view / "RECEIPT.json").write_text(json.dumps(derived, indent=2) + "\n")
        yield view


class NativeClient:
    def __init__(self, name: str, home: Path, marketplace: str = "provingkit"):
        self.name = name
        self.home = home
        self.marketplace = marketplace
        self.sentinels = {}
        self.selected_members = None
        self.receipt = {}
        self.executable = shutil.which(name)
        native_require(self.executable is not None, f"{name} executable is unavailable")
        self.actions = []
        self.install_paths = {}
        self.replacement_files = {}
        self.observed_marketplace = None
        self.config = Path(
            os.environ.get(
                "CODEX_HOME" if name == "codex" else "CLAUDE_CONFIG_DIR",
                str(home / (".codex" if name == "codex" else ".claude")),
            )
        )
        self.version = self.call("--version", structured=False).strip()
        pattern = (
            r"codex-cli [0-9]+\.[0-9]+\.[0-9]+(?:[+.-].*)?"
            if name == "codex"
            else r"[0-9]+\.[0-9]+\.[0-9]+ \(Claude Code\)"
        )
        native_require(
            re.fullmatch(pattern, self.version) is not None,
            f"unrecognized native version response: {self.version}",
        )

    def call(self, *arguments: str, structured: bool = True, action: bool = False):
        argv = [self.executable, *arguments]
        result = subprocess.run(
            argv,
            stdin=subprocess.DEVNULL,
            capture_output=True,
            text=True,
            timeout=60,
            check=False,
        )
        if action:
            self.actions.append({"argv": argv, "returncode": result.returncode})
        native_require(
            result.returncode == 0,
            f"native command failed ({result.returncode}): {result.stderr.strip() or result.stdout.strip()}",
        )
        if action and self.selected_members is not None:
            _, rows = self.observe()
            native_require(
                set(rows) - self.selected_members == set(self.sentinels)
                and self.snapshot(rows, set(self.sentinels)) == self.sentinels,
                "unselected native state changed; stop and inspect the retained observation",
            )
        return json.loads(result.stdout) if structured else result.stdout

    def observe(self) -> tuple[dict | None, dict]:
        marketplaces = self.call("plugin", "marketplace", "list", "--json")
        plugins = self.call(
            "plugin",
            "list",
            *(
                ("--marketplace", self.marketplace, "--json")
                if self.name == "codex"
                else ("--json",)
            ),
        )
        if self.name == "codex":
            marketplaces, plugins = marketplaces["marketplaces"], plugins["installed"]
        native_require(
            isinstance(marketplaces, list) and isinstance(plugins, list),
            "unrecognized native list shape",
        )
        sources = [row for row in marketplaces if row["name"] == self.marketplace]
        native_require(len(sources) <= 1, "ambiguous provingkit marketplace")
        rows = {}
        for row in plugins:
            identifier = row["pluginId" if self.name == "codex" else "id"]
            if not identifier.endswith("@" + self.marketplace):
                continue
            name = identifier.removesuffix("@" + self.marketplace)
            native_require(
                relative(name) and "/" not in name,
                "unrecognized native member identifier",
            )
            if self.name == "codex":
                native_require(
                    row["installed"] is True
                    and row["name"] == name
                    and row["marketplaceName"] == self.marketplace,
                    "unrecognized Codex installed row",
                )
            native_require(
                not row.get("errors") and not row.get("errorDetails"),
                f"native member reports errors: {identifier}",
            )
            native_require(
                name not in rows and isinstance(row["enabled"], bool),
                "ambiguous installed member state",
            )
            native_require(
                self.name == "codex" or row["scope"] == "user",
                "provingkit member has another or ambiguous scope",
            )
            rows[name] = row
        self.observed_marketplace = sources[0] if sources else None
        return self.observed_marketplace, rows

    def source_path(self, marketplace: dict | None) -> str | None:
        if marketplace is None:
            return None
        if self.name == "codex":
            native_require(
                marketplace["marketplaceSource"]["sourceType"] == "local",
                "marketplace is not an observed local source",
            )
            native_require(
                marketplace["root"] == marketplace["marketplaceSource"]["source"],
                "marketplace source differs from root",
            )
            return marketplace["root"]
        native_require(
            marketplace["source"] == "directory",
            "marketplace is not an observed directory source",
        )
        return marketplace["path"]

    def snapshot(self, rows: dict, members: set) -> dict:
        native_require(members <= set(rows), "unselected registration disappeared")
        return {
            member: {
                "registration": deepcopy(rows[member]),
                "files": installed_inventory(
                    self.name, self.loaded_path(member, rows[member], self.receipt)
                )[0],
                "cache_files": installed_inventory(
                    self.name, self.installed_path(member, rows[member], self.receipt)
                )[0],
            }
            for member in sorted(members)
        }

    def automatic_updates(self) -> str:
        if self.name != "claude":
            return "not_observed"
        values = []
        for relative, section in (
            ("settings.json", "extraKnownMarketplaces"),
            ("plugins/known_marketplaces.json", None),
        ):
            path = self.config / relative
            if not path.exists():
                continue
            data = json.loads(path.read_text())
            entry = (data.get(section, {}) if section else data).get(
                self.marketplace, {}
            )
            if "autoUpdate" in entry:
                native_require(
                    isinstance(entry["autoUpdate"], bool),
                    "unrecognized automatic update setting",
                )
                values.append(entry["autoUpdate"])
        return "enabled" if any(values) else "disabled" if values else "unspecified"

    def installed_path(self, member: str, row: dict | None, receipt: dict) -> Path:
        if self.name == "codex":
            version = row["version"] if row else "local"
            native_require(
                isinstance(version, str)
                and re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._+-]*", version) is not None,
                "unrecognized Codex cache version",
            )
            expected = (
                self.config / "plugins/cache" / self.marketplace / member / version
            )
            observed = self.install_paths.get(member) or receipt.get(
                "native_paths", {}
            ).get(member)
            # list omits installPath; use its version within the measured cache layout.
            if observed is not None and Path(observed).name == version:
                native_require(
                    Path(observed) == expected,
                    "unexpected native Codex installation path",
                )
                return Path(observed)
            return expected
        if row is None:
            return self.config / "plugins/cache" / self.marketplace / member / "absent"
        path = Path(row["installPath"])
        expected_parent = self.config / "plugins/cache" / self.marketplace / member
        native_require(
            path.is_absolute() and path.parent == expected_parent,
            "unexpected native installation path",
        )
        return path

    def loaded_path(self, member: str, row: dict | None, receipt: dict) -> Path:
        cache = self.installed_path(member, row, receipt)
        if self.name != "claude" or row is None or "readFromFolder" not in row:
            return cache
        folder = row["readFromFolder"]
        native_require(
            isinstance(folder, str) and bool(folder),
            "unrecognized Claude effective load folder",
        )
        source = self.source_path(self.observed_marketplace)
        native_require(
            source is not None
            and Path(folder).is_absolute()
            and Path(folder) == Path(source) / "plugins" / member,
            "Claude effective load folder differs from its registered marketplace",
        )
        native_require(
            Path(folder).is_dir() and not Path(folder).is_symlink(),
            "Claude effective load folder is missing or unsupported",
        )
        return Path(folder)

    def install(self, member: str) -> None:
        result = self.call(
            "plugin",
            "add" if self.name == "codex" else "install",
            member + "@" + self.marketplace,
            *(("--json",) if self.name == "codex" else ("--scope", "user", "--json")),
            action=True,
        )
        native_require(
            result["pluginId"] == member + "@" + self.marketplace,
            "unrecognized native install result",
        )
        if self.name == "codex":
            path = Path(result["installedPath"])
            native_require(
                path.parent
                == self.config / "plugins/cache" / self.marketplace / member,
                "unexpected native install result path",
            )
            self.install_paths[member] = str(path)

    def uninstall(self, member: str) -> None:
        _, rows = self.observe()
        path = self.installed_path(member, rows[member], self.receipt)
        if path.exists() or path.is_symlink():
            actual = files(path)
            native_require(
                self.replacement_files.get(member)
                == installed_inventory(self.name, path)[0],
                f"selected cache changed before removal: {member}",
            )
            parent = self.home / ".local/state/provingkit/backups"
            parent.mkdir(parents=True, exist_ok=True)
            backup = (
                Path(tempfile.mkdtemp(prefix=f"{self.name}-{member}-", dir=parent))
                / "previous"
            )
            shutil.copytree(path, backup)
            native_require(files(backup) == actual, "native recovery copy differs")
            self.receipt.setdefault("native_backups", []).append(
                {
                    "client": self.name,
                    "member": member,
                    "path": str(backup),
                    "previous_path": str(path),
                    "files": actual,
                }
            )
        self.call(
            "plugin",
            "remove" if self.name == "codex" else "uninstall",
            member + "@" + self.marketplace,
            *(
                ("--json",)
                if self.name == "codex"
                else ("--scope", "user", "--keep-data", "--json")
            ),
            action=True,
        )

    def enable(self, member: str, enabled: bool) -> None:
        native_require(
            self.name == "claude", "Codex persistent enablement control is unavailable"
        )
        self.call(
            "plugin",
            "enable" if enabled else "disable",
            member + "@" + self.marketplace,
            "--scope",
            "user",
            "--json",
            action=True,
        )


def marketplace_root(native: NativeClient, choice: dict) -> Path:
    name = choice["artifact"] + (
        "-local" if native.marketplace == "provingkit-local" else ""
    )
    return native.home / ".local/share/provingkit/marketplaces" / name


def native_status(
    native: NativeClient,
    choice: dict,
    root: Path,
    marketplace: dict | None,
    rows: dict,
    receipt: dict,
) -> dict:
    members = {}
    for member in choice["members"]:
        row = rows.get(member)
        installed = native.installed_path(member, row, receipt)
        loaded = native.loaded_path(member, row, receipt)
        cache_content, additions = "absent", {}
        expected = files(root / "plugins" / member)
        if installed.exists() or installed.is_symlink():
            native_require(
                native.name != "claude"
                or not any(
                    name == ".in_use" or name.startswith(".in_use/")
                    for name in expected
                ),
                "artifact declares Claude native marker files",
            )
            actual, markers = installed_inventory(native.name, installed)
            extra = set(actual) - set(expected)
            allowed = {".codex-plugin/plugin.json"} if native.name == "codex" else set()
            native_require(
                extra <= allowed,
                f"unknown installed files for {member}: {sorted(extra - allowed)}",
            )
            additions = {name: actual[name] for name in extra} | markers
            if extra:
                adapter = json.loads(
                    (installed / ".codex-plugin/plugin.json").read_text()
                )
                native_require(
                    adapter.get("name") == member, "unrecognized native Codex adapter"
                )
            if native.name == "codex":
                previous = receipt["native_additions"].get(member)
                native_require(
                    previous is None or previous == additions,
                    f"native adapter drift for {member}",
                )
            cache_content = (
                "match"
                if all(actual.get(name) == value for name, value in expected.items())
                else "different"
            )
        content = cache_content
        if loaded != installed:
            content = "absent"
            if loaded.exists() or loaded.is_symlink():
                payload, _ = installed_inventory(native.name, loaded)
                content = "match" if payload == expected else "different"
        members[member] = {
            "content": content,
            "cache_content": cache_content,
            "enabled": row["enabled"] if row else "unknown",
            "scope": choice["scope"] if row else "unknown",
            "path": str(installed),
            "load_path": str(loaded),
            "registered": row is not None,
            "native_additions": additions,
        }
    source = native.source_path(marketplace)
    retained_source = (
        receipt.get("retained_codex_source") if native.name == "codex" else None
    )
    source_matches = (
        source is not None
        and (retained_source is None or retained_source["path"] == source)
        and (
            source == str(marketplace_root(native, choice))
            or native.marketplace == "provingkit-local"
        )
        and Path(source).exists()
        and files(Path(source)) == files(root)
    )
    converged = source_matches and all(
        item["content"] == "match"
        and item["cache_content"] == "match"
        and item["registered"]
        and item["enabled"] == choice["members"][name]["enabled"]
        for name, item in members.items()
    )
    return {
        "artifact": "verified",
        "route": choice["route"],
        "native_version": native.version,
        "marketplace": marketplace,
        "source_binding": "match" if source_matches else "different",
        "members": members,
        "actions": native.actions,
        "automatic_updates": native.automatic_updates(),
        "outcome": "converged" if converged else "incomplete",
        "runtime_acceptance": "not_observed",
    }


def native_reconcile(
    native: NativeClient,
    home: Path,
    choice: dict,
    root: Path,
    marketplace: dict | None,
    rows: dict,
    receipt: dict,
) -> tuple[dict, dict]:
    stable = marketplace_root(native, choice)
    source = native.source_path(marketplace)
    rebind = source is not None and source != str(stable)
    if native.name == "claude" and source is not None:
        settings = json.loads((native.config / "settings.json").read_text())
        declared = (
            settings.get("extraKnownMarketplaces", {})
            .get(native.marketplace, {})
            .get("source")
        )
        native_require(
            declared == {"source": "directory", "path": source},
            "source_transition_unavailable: user marketplace scope is ambiguous",
        )
    native_require(
        source is not None or not rows,
        "source_transition_unavailable: installed members have no marketplace",
    )
    retained_source_matches = False
    if rebind and native.name == "codex" and native.marketplace == "provingkit-local":
        baseline = native_status(native, choice, root, marketplace, rows, receipt)
        retained_source_matches = baseline["source_binding"] == "match"
        if retained_source_matches:
            rebind = False
    unselected = set(rows) - set(choice["members"])
    if rebind and native.name == "codex":
        native_require(
            not unselected,
            "source_transition_unavailable: marketplace removal would affect unselected members",
        )
    catalog = json.loads((root / CATALOGS[choice["artifact"]]).read_text())
    entries = {item["name"] for item in catalog["plugins"]}
    native_require(
        unselected <= entries,
        "source_transition_unavailable: clean catalog omits an installed unselected member",
    )
    native_require(
        not unselected or native.automatic_updates() != "enabled",
        "source_transition_unavailable: automatic updates are enabled for unselected members",
    )
    if native.name == "claude":
        for member in sorted(unselected):
            row = rows[member]
            if "readFromFolder" not in row:
                continue
            loaded = native.loaded_path(member, row, receipt)
            native_require(
                installed_inventory(native.name, loaded)[0]
                == files(root / "plugins" / member),
                f"source_transition_unavailable: local source would change unselected effective content for {member}",
            )
    native.receipt = receipt
    native.selected_members = set(choice["members"])
    unselected_before = native.snapshot(rows, unselected)
    native.sentinels = deepcopy(unselected_before)
    if rebind and native.name == "claude":
        for member, observation in native.sentinels.items():
            if "readFromFolder" in observation["registration"]:
                observation["registration"]["readFromFolder"] = str(
                    stable / "plugins" / member
                )
    current = native_status(native, choice, root, marketplace, rows, receipt)
    for member, observed in current["members"].items():
        if observed["cache_content"] != "absent":
            native.replacement_files[member] = installed_inventory(
                native.name, Path(observed["path"])
            )[0]
        if observed["cache_content"] == "different":
            previous = receipt.get("native_files", {}).get(native.name, {}).get(member)
            native_require(
                previous == installed_inventory(native.name, Path(observed["path"]))[0],
                f"unrecognized selected cache for {member}; reconcile its contents with the owner before replacement",
            )
        if observed["content"] == "different":
            loaded_records = receipt.get("native_loaded_files", {}).get(native.name, {})
            previous = (
                loaded_records[member]
                if member in loaded_records
                else receipt.get("native_files", {}).get(native.name, {}).get(member)
            )
            native_require(
                previous
                == installed_inventory(native.name, Path(observed["load_path"]))[0],
                f"unrecognized selected effective source for {member}; reconcile its contents with the owner before replacement",
            )
    if retained_source_matches:
        source_files = files(Path(source))
        native_require(
            source_files == files(root),
            "registered source changed during adoption",
        )
        receipt.setdefault(
            "retained_codex_source", {"path": source, "files": source_files}
        )
        changed = False
    else:
        changed = project_directory(root, stable, home, receipt)
    if rebind:
        receipt.setdefault("source_transitions", []).append(
            {
                "client": native.name,
                "previous_source": marketplace,
                "next_source": str(stable),
                "unselected": unselected_before,
                "expected_unselected": deepcopy(native.sentinels),
            }
        )
        if native.name == "codex":
            for member in rows:
                native.uninstall(member)
            native.call(
                "plugin",
                "marketplace",
                "remove",
                native.marketplace,
                "--json",
                action=True,
            )
        marketplace = None
    if marketplace is None:
        native.call(
            "plugin",
            "marketplace",
            "add",
            str(stable),
            *(("--json",) if native.name == "codex" else ("--scope", "user")),
            structured=native.name == "codex",
            action=True,
        )
    elif changed and native.name == "claude":
        native.call(
            "plugin",
            "marketplace",
            "update",
            native.marketplace,
            structured=False,
            action=True,
        )
    for member, observed in current["members"].items():
        removed = rebind and native.name == "codex"
        if (
            removed
            or observed["cache_content"] != "match"
            or not observed["registered"]
        ):
            if (
                not removed
                and observed["registered"]
                and observed["cache_content"] == "different"
            ):
                native.uninstall(member)
            native.install(member)
            if native.name == "codex":
                receipt["native_additions"].pop(member, None)
        _, updated = native.observe()
        enabled = choice["members"][member]["enabled"]
        if member in updated and updated[member]["enabled"] != enabled:
            native.enable(member, enabled)
    marketplace, final_rows = native.observe()
    native_require(
        set(final_rows) - native.selected_members == set(native.sentinels)
        and native.snapshot(final_rows, set(native.sentinels)) == native.sentinels,
        "unselected native state changed; inspect the retained observation",
    )
    if native.name == "codex" and not retained_source_matches:
        receipt.pop("retained_codex_source", None)
    return marketplace, final_rows


def receipt_path(home: Path) -> Path:
    return home / ".local/state/provingkit/installations.json"


def load_receipt(home: Path) -> dict:
    path = receipt_path(home)
    if not path.exists():
        return {
            "schema": "provingkit-installation-observation-v1",
            "directories": {},
            "native_additions": {},
        }
    receipt = json.loads(path.read_text())
    native_require(
        receipt["schema"] == "provingkit-installation-observation-v1",
        "unrecognized observation receipt",
    )
    native_require(
        isinstance(receipt["directories"], dict)
        and isinstance(receipt["native_additions"], dict),
        "unrecognized observation inventory",
    )
    native_require(
        isinstance(receipt.get("native_paths", {}), dict)
        and isinstance(receipt.get("native_files", {}), dict)
        and isinstance(receipt.get("native_loaded_files", {}), dict)
        and isinstance(receipt.get("native_backups", []), list)
        and isinstance(receipt.get("source_transitions", []), list),
        "unrecognized observation history",
    )
    native_require(
        all(
            isinstance(members, dict)
            and all(isinstance(inventory, dict) for inventory in members.values())
            for members in receipt.get("native_loaded_files", {}).values()
        ),
        "unrecognized effective-source inventory",
    )
    previous_marketplace = (
        receipt.get("clients", {}).get("codex", {}).get("marketplace")
    )
    if previous_marketplace is not None:
        previous_identity = previous_marketplace["name"]
        native_require(
            receipt.get("codex_marketplace") in (None, previous_identity),
            "conflicting recorded Codex marketplace identities",
        )
        receipt["codex_marketplace"] = previous_identity
    native_require(
        receipt.get("codex_marketplace") in (None, "provingkit", "provingkit-local"),
        "unrecognized recorded Codex marketplace identity",
    )
    return receipt


def save_receipt(home: Path, receipt: dict, selection: dict, clients: dict) -> None:
    receipt["selection"] = {
        key: selection[key] for key in ("source", "adoption", "artifacts")
    }
    codex_marketplace = clients.get("codex", {}).get("marketplace")
    if codex_marketplace is not None:
        receipt["codex_marketplace"] = codex_marketplace["name"]
    receipt["clients"] = clients
    path = receipt_path(home)
    raw = json.dumps(receipt, indent=2, sort_keys=True) + "\n"
    if path.exists() and path.read_text() == raw:
        return
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(mode="w", dir=path.parent, delete=False) as stream:
        stream.write(raw)
        temporary = Path(stream.name)
    os.replace(temporary, path)


def project_directory(
    source: Path, destination: Path, home: Path, receipt: dict
) -> bool:
    """Replace only a previously observed projection, retaining its previous tree."""
    expected = files(source)
    key = destination.relative_to(home).as_posix()
    present = destination.exists() or destination.is_symlink()
    if present:
        actual = files(destination)
        if actual == expected:
            receipt["directories"][key] = expected
            return False
        native_require(
            receipt["directories"].get(key) == actual,
            f"projection has unrecognized contents: {destination}",
        )
    destination.parent.mkdir(parents=True, exist_ok=True)
    stage = Path(tempfile.mkdtemp(prefix=".provingkit-", dir=destination.parent))
    shutil.copytree(source, stage, dirs_exist_ok=True)
    if present:
        backup_parent = home / ".local/state/provingkit/backups"
        backup_parent.mkdir(parents=True, exist_ok=True)
        backup = (
            Path(tempfile.mkdtemp(prefix=destination.name + "-", dir=backup_parent))
            / "previous"
        )
        os.replace(destination, backup)
        try:
            os.replace(stage, destination)
        except OSError:
            os.replace(backup, destination)
            raise
    else:
        os.replace(stage, destination)
    receipt["directories"][key] = expected
    return True


def cursor_reconcile(home: Path, choice: dict, root: Path, receipt: dict) -> None:
    for member in choice["members"]:
        installed = home / ".cursor/plugins/local" / member
        project_directory(root / "plugins" / member, installed, home, receipt)


def cursor_status(home: Path, choice: dict, root: Path) -> dict:
    members = {}
    for member in choice["members"]:
        installed = home / ".cursor/plugins/local" / member
        content = "absent"
        if installed.exists() or installed.is_symlink():
            content = (
                "match"
                if files(installed) == files(root / "plugins" / member)
                else "different"
            )
        members[member] = {
            "content": content,
            "enabled": "unknown",
            "scope": "user",
            "path": str(installed),
        }
    complete = all(item["content"] == "match" for item in members.values())
    return {
        "artifact": "verified",
        "route": choice["route"],
        "members": members,
        "materialization": "verified" if complete else "incomplete",
        "runtime_acceptance": "pending",
        "outcome": "materialized" if complete else "incomplete",
    }


def main() -> int:
    parser = argparse.ArgumentParser(
        description=__doc__,
        epilog="Procedures in nisavid/dotfiles: docs/agent-equipment/provingkit-installations.md; import-artifacts: docs/agent-equipment/provingkit-recovery.md.",
    )
    parser.add_argument(
        "command", choices=("validate", "status", "reconcile", "import-artifacts")
    )
    parser.add_argument(
        "--recovery", help="Name of an independently pinned recovery packet."
    )
    parser.add_argument(
        "--packet", type=Path, help="Explicit local recovery packet path."
    )
    parser.add_argument(
        "--selection",
        type=Path,
        default=Path.home() / ".config/provingkit/selection-v1.json",
    )
    parser.add_argument(
        "--json", action="store_true", help="Emit the JSON result (the default)."
    )
    args = parser.parse_args()
    try:
        selection = json.loads(args.selection.read_text())
        if args.command == "import-artifacts":
            require(
                selection["schema"] == "provingkit-installations-v1",
                "unsupported projection schema",
            )
            validate_recoveries(selection)
            require(
                isinstance(selection["host_platform"], dict)
                and set(selection["host_platform"]) == {"os", "arch"}
                and all(
                    isinstance(value, str) and value
                    for value in selection["host_platform"].values()
                ),
                "invalid recovery host platform",
            )
            require(
                args.recovery and args.packet,
                "import-artifacts requires --recovery and --packet",
            )
            require(
                args.recovery in selection.get("recovery_packets", {}),
                "unknown recovery: " + args.recovery,
            )
            profile = None
        else:
            profile = validate(selection)
    except (OSError, ValueError, KeyError, TypeError, AttributeError) as error:
        print(
            json.dumps(
                {"outcome": "invalid_selection", "message": str(error), "clients": {}}
            )
        )
        return 64
    if args.command == "import-artifacts":
        record = selection["recovery_packets"][args.recovery]
        if (
            record["platform"] != {"os": "linux", "arch": "amd64"}
            or selection["host_platform"] != record["platform"]
            or platform.system() != "Linux"
            or platform.machine() != "x86_64"
        ):
            print(
                json.dumps(
                    {
                        "outcome": "unsupported_platform",
                        "clients": {},
                        "recovery": args.recovery,
                    }
                )
            )
            return 2
        try:
            report = import_recovery(Path.home(), record, args.packet)
        except RecoveryRefused as error:
            print(
                json.dumps(
                    {
                        "outcome": "recovery_refused",
                        "message": str(error),
                        "clients": {},
                        "recovery": args.recovery,
                    }
                )
            )
            return 1
        except (
            OSError,
            ValueError,
            KeyError,
            TypeError,
            AttributeError,
            tarfile.TarError,
        ) as error:
            print(
                json.dumps(
                    {
                        "outcome": "recovery_invalid",
                        "message": str(error),
                        "clients": {},
                        "recovery": args.recovery,
                    }
                )
            )
            return 1
        report["recovery"] = args.recovery
        print(json.dumps(report, sort_keys=True))
        return 0
    report = {"outcome": "inactive", "clients": {}}
    code = 0
    if profile is not None:
        if (
            selection["host_platform"] != profile["platform"]
            or profile["platform"]["os"] != "linux"
            or platform.system() != "Linux"
            or profile["platform"]["arch"]
            != {"x86_64": "amd64", "aarch64": "arm64"}.get(
                platform.machine(), platform.machine()
            )
        ):
            report["outcome"] = "unsupported_platform"
        elif args.command == "validate":
            report["outcome"] = "valid"
        else:
            home = Path.home()
            try:
                roots = {
                    target: verify_artifact(home, profile, target)
                    for target in profile["artifacts"]
                }
            except (OSError, ValueError, KeyError, TypeError, AttributeError) as error:
                report.update(outcome="artifact_invalid", message=str(error))
                print(json.dumps(report, sort_keys=True))
                return 1
            try:
                receipt = load_receipt(home)
            except (
                Unavailable,
                OSError,
                ValueError,
                KeyError,
                TypeError,
                AttributeError,
            ) as error:
                print(
                    json.dumps(
                        {
                            "outcome": "receipt_unavailable",
                            "message": str(error),
                            "clients": {},
                        }
                    )
                )
                return 2
            try:
                codex_choice = profile["clients"].get("codex")
                if codex_choice is not None:
                    native_require(
                        receipt.get("codex_marketplace")
                        in (None, codex_choice.get("marketplace", "provingkit")),
                        "identity_transition_unavailable: changing a recorded Codex marketplace requires a separate migration",
                    )
                    retained = receipt.get("retained_codex_source")
                    if retained is not None:
                        native_require(
                            files(Path(retained["path"])) == retained["files"],
                            "adopted Codex source changed; reconcile its baseline with the owner",
                        )
                        codex = NativeClient(
                            "codex", home, codex_choice.get("marketplace", "provingkit")
                        )
                        registered, _ = codex.observe()
                        native_require(
                            codex.source_path(registered) == retained["path"],
                            "adopted Codex source registration changed; reconcile its binding with the owner",
                        )
            except (
                Unavailable,
                OSError,
                ValueError,
                KeyError,
                TypeError,
                AttributeError,
                subprocess.TimeoutExpired,
            ) as error:
                report.update(
                    outcome="selection_transition_unavailable", message=str(error)
                )
                print(json.dumps(report, sort_keys=True))
                return 2
            for client, choice in profile["clients"].items():
                native = None
                try:
                    native_require(
                        client == "claude"
                        or all(item["enabled"] for item in choice["members"].values()),
                        f"{client} persistent disable control is unavailable",
                    )
                    root = roots[choice["artifact"]]
                    if client == "cursor":
                        if args.command == "reconcile":
                            cursor_reconcile(home, choice, root, receipt)
                        observation = cursor_status(home, choice, root)
                    else:
                        with installation_view(root, choice) as root:
                            native = NativeClient(
                                client, home, choice.get("marketplace", "provingkit")
                            )
                            marketplace, rows = native.observe()
                            if args.command == "reconcile":
                                marketplace, rows = native_reconcile(
                                    native,
                                    home,
                                    choice,
                                    root,
                                    marketplace,
                                    rows,
                                    receipt,
                                )
                            observation = native_status(
                                native, choice, root, marketplace, rows, receipt
                            )
                    report["clients"][client] = observation
                    if native is not None and args.command == "reconcile":
                        inventories = receipt.setdefault("native_files", {}).setdefault(
                            client, {}
                        )
                        for member, observed in observation["members"].items():
                            if (
                                observed["content"] == "match"
                                and observed["cache_content"] == "match"
                                and observed["registered"]
                            ):
                                inventories[member] = installed_inventory(
                                    client, Path(observed["path"])
                                )[0]
                                loaded_inventories = receipt.setdefault(
                                    "native_loaded_files", {}
                                ).setdefault(client, {})
                                loaded_inventories[member] = installed_inventory(
                                    client, Path(observed["load_path"])
                                )[0]
                    if client == "codex" and args.command == "reconcile":
                        for member, observed in observation["members"].items():
                            if (
                                observed["content"] == "match"
                                and observed["registered"]
                            ):
                                receipt["native_additions"][member] = observed[
                                    "native_additions"
                                ]
                                receipt.setdefault("native_paths", {})[member] = (
                                    observed["path"]
                                )
                except (
                    Unavailable,
                    OSError,
                    ValueError,
                    KeyError,
                    TypeError,
                    AttributeError,
                    subprocess.TimeoutExpired,
                ) as error:
                    report["clients"][client] = {
                        "artifact": "verified",
                        "outcome": "unavailable",
                        "message": str(error),
                        "actions": native.actions if native else [],
                    }
            if args.command == "reconcile":
                try:
                    save_receipt(home, receipt, profile, report["clients"])
                except OSError as error:
                    report.update(outcome="receipt_unavailable", message=str(error))
                    print(json.dumps(report, sort_keys=True))
                    return 2
            complete = all(
                item["outcome"] in ("converged", "materialized")
                for item in report["clients"].values()
            )
            report["outcome"], code = (
                (("materialized" if "cursor" in profile["clients"] else "converged"), 0)
                if complete
                else ("incomplete", 2)
            )
    print(json.dumps(report, sort_keys=True))
    return code


if __name__ == "__main__":
    raise SystemExit(main())
