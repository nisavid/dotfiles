#!/bin/zsh -f

[[ -o xtrace ]] && unsetopt xtrace
PROTON_PASS_BOOTSTRAP_FIELD=PROTON_PASS_PERSONAL_ACCESS
PROTON_PASS_BOOTSTRAP_FIELD+=_TOKEN
readonly PROTON_PASS_BOOTSTRAP_FIELD
unset "$PROTON_PASS_BOOTSTRAP_FIELD" 2>/dev/null || true
set -euo pipefail

die() {
  print -u2 -r -- "proton-pass-session: $1"
  exit 1
}

script_dir=${0:A:h}
for candidate in \
  "$script_dir/proton-pass-ensure-ready" \
  "$script_dir/executable_proton-pass-ensure-ready"; do
  if [[ -f $candidate && ! -L $candidate && -x $candidate ]]; then
    exec "$candidate" "$@"
  fi
done
die 'proton-pass-ensure-ready is required'
