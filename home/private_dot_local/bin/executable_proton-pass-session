#!/usr/bin/env zsh

[[ -o xtrace ]] && unsetopt xtrace
set -euo pipefail

die() {
  print -u2 -r -- "proton-pass-session: $1"
  exit 1
}

backend=$(command -v pass-cli 2>/dev/null || true)
[[ -n $backend && -x $backend ]] || die 'pass-cli is required'

export PROTON_PASS_LINUX_KEYRING=dbus
if "$backend" test >/dev/null 2>&1; then
  exit 0
fi

[[ -n ${PROTON_PASS_PERSONAL_ACCESS_TOKEN:-} ]] ||
  die 'a personal access token is required to establish the session'

"$backend" login >/dev/null || die 'login failed'
unset PROTON_PASS_PERSONAL_ACCESS_TOKEN
"$backend" test >/dev/null 2>&1 || die 'the authenticated session did not verify'
