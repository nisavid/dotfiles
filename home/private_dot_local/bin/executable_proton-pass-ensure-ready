#!/bin/zsh -f

[[ -o xtrace ]] && unsetopt xtrace
PROTON_PASS_BOOTSTRAP_FIELD=PROTON_PASS_PERSONAL_ACCESS
PROTON_PASS_BOOTSTRAP_FIELD+=_TOKEN
readonly PROTON_PASS_BOOTSTRAP_FIELD
unset "$PROTON_PASS_BOOTSTRAP_FIELD" 2>/dev/null || true
# Backtraces and provider log levels add variable text that defeats exact
# provider diagnostics.
unset RUST_BACKTRACE RUST_LIB_BACKTRACE PASS_LOG_LEVEL MUON_LOG_LEVEL \
  2>/dev/null || true
set -euo pipefail
umask 077

# A failed first probe falls through to the exclusive classifying probe, so
# only the classifying probe and verification need headroom for slow requests.
readonly PROTON_PASS_READY_PROBE_TIMEOUT_SECONDS=3
readonly PROTON_PASS_CLASSIFY_PROBE_TIMEOUT_SECONDS=5
readonly PROTON_PASS_VERIFY_TIMEOUT_SECONDS=5
readonly PROTON_PASS_LOGOUT_TIMEOUT_SECONDS=3
# A timed-out classifying probe releases the lock after its deadline plus
# cleanup, so the takeover window must stay longer than that deadline. A
# shared holder runs only the shorter first probe.
readonly PROTON_PASS_LOCK_TAKEOVER_SECONDS=6
readonly PROTON_PASS_CONCURRENT_REPAIR_WAIT_SECONDS=20
# The first probe waits this long behind an exclusive holder before taking the
# exclusive path, whose own waits cover repairs. The wait adds to the slowest
# call, and the 36-second startup budget leaves room for about one second.
readonly PROTON_PASS_READY_LOCK_WAIT_SECONDS=1
readonly PROTON_PASS_NATIVE_STORE_TIMEOUT_SECONDS=3
readonly PROTON_PASS_LOGIN_TIMEOUT_SECONDS=8
readonly PROTON_PASS_POLL_CENTISECONDS=1
readonly PROTON_PASS_TERMINATION_GRACE_CENTISECONDS=10
readonly PROTON_PASS_DIAGNOSTIC_MAX_BYTES=4096
readonly PROTON_PASS_SCRIPT_DIR=${0:A:h}
PROTON_PASS_ABSENT_DIAGNOSTIC='Error: This operation requires an authenticated client'
PROTON_PASS_ABSENT_STATE_RECORD='Command is not logout there is no session'
# The provider dropped the session, but pass-cli keeps local authentication and
# refuses login until a forced local logout removes it.
PROTON_PASS_ORPHANED_SESSION_DIAGNOSTIC='Error: Error getting personal access token name'
PROTON_PASS_ORPHANED_SESSION_DIAGNOSTIC+=$'\n\nCaused by:\n'
PROTON_PASS_ORPHANED_SESSION_DIAGNOSTIC+=$'    0: Error sending request\n'
PROTON_PASS_ORPHANED_SESSION_DIAGNOSTIC+=$'    1: failed to authenticate: non-existent session\n'
PROTON_PASS_ORPHANED_SESSION_DIAGNOSTIC+='    2: non-existent session'
PROTON_PASS_INVALIDATED_DIAGNOSTIC='Your session has been invalidated and you have '
PROTON_PASS_INVALIDATED_DIAGNOSTIC+='been logged out automatically.'
PROTON_PASS_INVALIDATED_DIAGNOSTIC+=$'\n'
PROTON_PASS_INVALIDATED_DIAGNOSTIC+='Please log in again with: pass login'
# The stored local key cannot open the local database, for example after two
# processes each created a key for an empty session. pass-cli itself names a
# forced local logout as the remedy.
PROTON_PASS_UNDECRYPTABLE_STORE_DETAIL='Failed to open encrypted database: file is not a database. '
PROTON_PASS_UNDECRYPTABLE_STORE_DETAIL+='The encryption key may not match or the database may be corrupted. '
PROTON_PASS_UNDECRYPTABLE_STORE_DETAIL+="Try running 'pass-cli logout --force' to reset local state."
PROTON_PASS_UNDECRYPTABLE_DIAGNOSTIC='Error: Error creating client features'
PROTON_PASS_UNDECRYPTABLE_DIAGNOSTIC+=$'\n\nCaused by:\n'
PROTON_PASS_UNDECRYPTABLE_DIAGNOSTIC+=$'    0: Failed to initialize database\n'
PROTON_PASS_UNDECRYPTABLE_DIAGNOSTIC+=$'    1: Failed to get database connection\n'
PROTON_PASS_UNDECRYPTABLE_DIAGNOSTIC+="    2: Error occurred while creating a new object: $PROTON_PASS_UNDECRYPTABLE_STORE_DETAIL"$'\n'
PROTON_PASS_UNDECRYPTABLE_DIAGNOSTIC+="    3: $PROTON_PASS_UNDECRYPTABLE_STORE_DETAIL"$'\n'
PROTON_PASS_UNDECRYPTABLE_DIAGNOSTIC+='    4: Error code 0: not an error'
unset PROTON_PASS_UNDECRYPTABLE_STORE_DETAIL
readonly PROTON_PASS_ABSENT_DIAGNOSTIC PROTON_PASS_ABSENT_STATE_RECORD \
  PROTON_PASS_ORPHANED_SESSION_DIAGNOSTIC
readonly PROTON_PASS_INVALIDATED_DIAGNOSTIC PROTON_PASS_UNDECRYPTABLE_DIAGNOSTIC
# Exact pass-cli login failures that name an actionable cause. Server text,
# status-only responses, and every other variant remain generic.
PROTON_PASS_LOGIN_ALREADY_AUTHENTICATED_DIAGNOSTIC='Error: Already authenticated'
PROTON_PASS_LOGIN_FLOW_DIAGNOSTIC='Error: Error in personal access token login flow'
PROTON_PASS_LOGIN_FLOW_DIAGNOSTIC+=$'\n\nCaused by:\n'
PROTON_PASS_LOGIN_TOKEN_REJECTED_DIAGNOSTIC=$PROTON_PASS_LOGIN_FLOW_DIAGNOSTIC
PROTON_PASS_LOGIN_TOKEN_REJECTED_DIAGNOSTIC+=$'    0: Error creating personal access token session\n'
PROTON_PASS_LOGIN_TOKEN_REJECTED_DIAGNOSTIC+='    1: This personal access token is invalid, expired or has been deleted.'
PROTON_PASS_LOGIN_SESSION_REFUSED_DIAGNOSTIC=$PROTON_PASS_LOGIN_FLOW_DIAGNOSTIC
PROTON_PASS_LOGIN_SESSION_REFUSED_DIAGNOSTIC+=$'    0: Error creating personal access token session\n'
PROTON_PASS_LOGIN_SESSION_REFUSED_DIAGNOSTIC+=$'    1: Error requesting personal access token session\n'
PROTON_PASS_LOGIN_SESSION_REFUSED_DIAGNOSTIC+=$'    2: failed to authenticate: non-existent session\n'
PROTON_PASS_LOGIN_SESSION_REFUSED_DIAGNOSTIC+='    3: non-existent session'
PROTON_PASS_LOGIN_TOKEN_PARSE_DIAGNOSTIC=$PROTON_PASS_LOGIN_FLOW_DIAGNOSTIC
PROTON_PASS_LOGIN_TOKEN_PARSE_DIAGNOSTIC+=$'    0: Failed to parse personal access token token\n'
PROTON_PASS_LOGIN_TOKEN_PARSE_DIAGNOSTIC+='    1: '
PROTON_PASS_LOGIN_TOKEN_MALFORMED_DIAGNOSTICS=(
  "${PROTON_PASS_LOGIN_TOKEN_PARSE_DIAGNOSTIC}Invalid personal access token token format. Expected format: pst_<token>::<key>"
  "${PROTON_PASS_LOGIN_TOKEN_PARSE_DIAGNOSTIC}Personal access token token must start with 'pst_'"
  "${PROTON_PASS_LOGIN_TOKEN_PARSE_DIAGNOSTIC}Personal access token token must have exactly 64 characters after 'pst_' prefix"
)
unset PROTON_PASS_LOGIN_FLOW_DIAGNOSTIC PROTON_PASS_LOGIN_TOKEN_PARSE_DIAGNOSTIC
readonly PROTON_PASS_LOGIN_ALREADY_AUTHENTICATED_DIAGNOSTIC \
  PROTON_PASS_LOGIN_TOKEN_REJECTED_DIAGNOSTIC \
  PROTON_PASS_LOGIN_SESSION_REFUSED_DIAGNOSTIC \
  PROTON_PASS_LOGIN_TOKEN_MALFORMED_DIAGNOSTICS
typeset -g PROTON_PASS_ACTIVE_CHILD_NAME=
typeset -gi PROTON_PASS_ACTIVE_CHILD_PGID=0
typeset -gi PROTON_PASS_CHILD_SEQUENCE=0
# Never export inherited copies of private diagnostic or lock state to children.
unset PROTON_PASS_DIAGNOSTIC_FILE PROTON_PASS_DIAGNOSTIC_TEXT \
  PROTON_PASS_DIAGNOSTIC_WRITE_FD PROTON_PASS_DIAGNOSTIC_READ_FD \
  PROTON_PASS_LOGIN_FAILURE_REASON PROTON_PASS_LOGIN_FAILURE_MESSAGE \
  PROTON_PASS_READINESS_LOCK_FD 2>/dev/null || true
typeset -gi PROTON_PASS_READINESS_LOCK_FD=0
typeset -g PROTON_PASS_DIAGNOSTIC_FILE=
typeset -gi PROTON_PASS_DIAGNOSTIC_WRITE_FD=0
typeset -gi PROTON_PASS_DIAGNOSTIC_READ_FD=0
typeset -g PROTON_PASS_DIAGNOSTIC_TEXT=
typeset -g PROTON_PASS_LOGIN_FAILURE_REASON=login-failed
typeset -g PROTON_PASS_LOGIN_FAILURE_MESSAGE='provider-session repair failed'
typeset -g PROTON_PASS_SESSION_STATE=unknown
typeset -g PROTON_PASS_SESSION_WAITER_STAGE=unrecorded
unset PROTON_PASS_LAST_WAITER_STAGE 2>/dev/null || true
typeset -g PROTON_PASS_LAST_WAITER_STAGE=unrecorded
integer PROTON_PASS_ESCAPE_DIAGNOSTIC_FD
exec {PROTON_PASS_ESCAPE_DIAGNOSTIC_FD}>&2 || exit 1

die() {
  print -u2 -r -- "proton-pass-ensure-ready: $1"
  exit 1
}

escape_unmanageable_child() {
  remove_diagnostic_file || true
  print -u$PROTON_PASS_ESCAPE_DIAGNOSTIC_FD -r -- "proton-pass-ensure-ready: $1"
  exec {PROTON_PASS_ESCAPE_DIAGNOSTIC_FD}>&- 2>/dev/null ||
    exec /usr/bin/false
  exec /usr/bin/false
}

active_child_identity_matches() {
  emulate -L zsh

  local child_name=$1
  integer expected_pgid=$2
  local listing child_listing
  listing=$(zpty 2>/dev/null) || return 1
  child_listing=${(M)${(f)listing}:#\(*\) ${child_name}:*}
  local child_state=${${child_listing#\(}%%\)*}
  [[ -n $child_listing && $child_state == <-> &&
    $child_state -eq expected_pgid ]]
}

terminate_active_child() {
  emulate -L zsh

  local child_name=${PROTON_PASS_ACTIVE_CHILD_NAME:-}
  integer child_pgid=${PROTON_PASS_ACTIVE_CHILD_PGID:-0}
  [[ -n $child_name && $child_pgid -gt 1 ]] || return 0

  zmodload zsh/zselect 2>/dev/null || true
  integer term_polls=$(( PROTON_PASS_TERMINATION_GRACE_CENTISECONDS / 2 ))
  integer kill_polls=$(( PROTON_PASS_TERMINATION_GRACE_CENTISECONDS - term_polls ))
  active_child_identity_matches "$child_name" $child_pgid &&
    kill -0 -- -$child_pgid 2>/dev/null ||
    escape_unmanageable_child 'bounded credential child became unmanageable'
  kill -TERM -- -$child_pgid 2>/dev/null || true
  while (( term_polls-- > 0 )) && kill -0 -- -$child_pgid 2>/dev/null; do
    zselect -t 1 2>/dev/null || true
  done
  active_child_identity_matches "$child_name" $child_pgid &&
    kill -0 -- -$child_pgid 2>/dev/null ||
    escape_unmanageable_child 'bounded credential child became unmanageable'
  zpty -d "$child_name" 2>/dev/null ||
    escape_unmanageable_child 'bounded credential child became unmanageable'

  while (( kill_polls-- > 0 )) && kill -0 -- -$child_pgid 2>/dev/null; do
    zselect -t 1 2>/dev/null || true
  done

  typeset -g PROTON_PASS_ACTIVE_CHILD_NAME=
  typeset -gi PROTON_PASS_ACTIVE_CHILD_PGID=0
}

remove_diagnostic_file() {
  emulate -L zsh

  local diagnostic_file=${PROTON_PASS_DIAGNOSTIC_FILE:-}
  integer write_fd=${PROTON_PASS_DIAGNOSTIC_WRITE_FD:-0}
  integer read_fd=${PROTON_PASS_DIAGNOSTIC_READ_FD:-0}
  typeset -g PROTON_PASS_DIAGNOSTIC_FILE=
  typeset -gi PROTON_PASS_DIAGNOSTIC_WRITE_FD=0
  typeset -gi PROTON_PASS_DIAGNOSTIC_READ_FD=0
  # Closing the last descriptor releases the already unlinked file.
  (( write_fd <= 0 )) || exec {write_fd}>&- || true
  (( read_fd <= 0 )) || exec {read_fd}<&- || true
  [[ -z $diagnostic_file ]] || /bin/rm -f -- "$diagnostic_file"
}

cleanup_readiness_process() {
  remove_diagnostic_file || true
  terminate_active_child
}

create_diagnostic_file() {
  emulate -L zsh

  local state_dir=$1
  local prefix=$2
  remove_diagnostic_file
  typeset -g PROTON_PASS_DIAGNOSTIC_TEXT=
  zmodload zsh/stat || die 'zsh/stat is required'
  # Registered at once, so every catchable exit path removes the file.
  PROTON_PASS_DIAGNOSTIC_FILE=$(
    /usr/bin/mktemp "$state_dir/$prefix.XXXXXX"
  ) || die 'cannot create the private provider diagnostic file'
  integer write_fd=0 read_fd=0
  if ! /bin/chmod -- 600 "$PROTON_PASS_DIAGNOSTIC_FILE" ||
    ! exec {write_fd}>>"$PROTON_PASS_DIAGNOSTIC_FILE"; then
    remove_diagnostic_file
    die 'cannot secure the private provider diagnostic file'
  fi
  typeset -gi PROTON_PASS_DIAGNOSTIC_WRITE_FD=$write_fd
  exec {read_fd}<"$PROTON_PASS_DIAGNOSTIC_FILE" || {
    remove_diagnostic_file
    die 'cannot secure the private provider diagnostic file'
  }
  typeset -gi PROTON_PASS_DIAGNOSTIC_READ_FD=$read_fd
  # Unlink before any provider starts: only these descriptors reach the
  # captured text, and even an uncatchable kill leaves no named copy behind.
  /bin/rm -f -- "$PROTON_PASS_DIAGNOSTIC_FILE" || {
    remove_diagnostic_file
    die 'cannot secure the private provider diagnostic file'
  }
  typeset -g PROTON_PASS_DIAGNOSTIC_FILE=
  local -A write_metadata read_metadata
  if ! zstat -H write_metadata -f "$write_fd" ||
    ! zstat -H read_metadata -f "$read_fd" ||
    (( write_metadata[device] != read_metadata[device] ||
      write_metadata[inode] != read_metadata[inode] ||
      write_metadata[nlink] != 0 ||
      write_metadata[uid] != EUID ||
      (write_metadata[mode] & 8#177777) != 8#100600 )); then
    remove_diagnostic_file
    die 'cannot secure the private provider diagnostic file'
  fi
}

consume_diagnostic_file() {
  emulate -L zsh
  # Byte lengths bound the read; provider text is not decoded.
  setopt local_options no_unset no_multibyte

  typeset -g PROTON_PASS_DIAGNOSTIC_TEXT=
  integer read_fd=$PROTON_PASS_DIAGNOSTIC_READ_FD
  zmodload zsh/system || die 'zsh/system is required'
  local diagnostic= diagnostic_chunk=
  integer read_status=0
  if (( read_fd <= 0 )); then
    read_status=1
  fi
  # Read at most one byte past the limit, even if a descendant still writes.
  while (( read_status == 0 &&
    ${#diagnostic} <= PROTON_PASS_DIAGNOSTIC_MAX_BYTES )); do
    diagnostic_chunk=
    if sysread -i "$read_fd" \
      -s $(( PROTON_PASS_DIAGNOSTIC_MAX_BYTES + 1 - ${#diagnostic} )) \
      diagnostic_chunk; then
      diagnostic+=$diagnostic_chunk
    else
      read_status=$?
    fi
  done
  remove_diagnostic_file
  # sysread reports end of file as status 5.
  (( read_status == 0 || read_status == 5 )) || return 1
  (( ${#diagnostic} <= PROTON_PASS_DIAGNOSTIC_MAX_BYTES )) || return 1
  typeset -g PROTON_PASS_DIAGNOSTIC_TEXT="${diagnostic%$'\n'}"
}

start_bounded_child() {
  emulate -L zsh
  unsetopt bg_nice

  local environment_name=$1
  local output_mode=$2
  shift 2
  [[ $1 == -- ]] || die 'invalid bounded-child request'
  shift
  (( $# )) || die 'empty bounded-child request'
  if [[ -n $environment_name &&
    ! $environment_name =~ '^[A-Za-z_][A-Za-z0-9_]*$' ]]; then
    die 'invalid bounded-child environment name'
  fi

  zmodload zsh/system || die 'zsh/system is required'
  zmodload zsh/zpty || die 'zsh/zpty is required'
  local -a PROTON_PASS_CHILD_ARGV=("$@")
  local PROTON_PASS_CHILD_ENVIRONMENT_NAME=$environment_name
  if [[ -n $environment_name ]] &&
    (( ! ${+PROTON_PASS_CHILD_ENVIRONMENT_VALUE} )); then
    die 'missing bounded-child environment value'
  fi
  integer PROTON_PASS_CHILD_STDOUT_FD PROTON_PASS_CHILD_STDERR_FD
  case $output_mode in
    inherit)
      exec {PROTON_PASS_CHILD_STDOUT_FD}>&1 || die 'cannot duplicate bounded-child output'
      exec {PROTON_PASS_CHILD_STDERR_FD}>&2 || {
        exec {PROTON_PASS_CHILD_STDOUT_FD}>&-
        die 'cannot duplicate bounded-child diagnostics'
      }
      ;;
    discard)
      exec {PROTON_PASS_CHILD_STDOUT_FD}>/dev/null || die 'cannot discard bounded-child output'
      exec {PROTON_PASS_CHILD_STDERR_FD}>/dev/null || {
        exec {PROTON_PASS_CHILD_STDOUT_FD}>&-
        die 'cannot discard bounded-child diagnostics'
      }
      ;;
    capture)
      exec {PROTON_PASS_CHILD_STDOUT_FD}>&1 || die 'cannot duplicate bounded-child output'
      exec {PROTON_PASS_CHILD_STDERR_FD}>/dev/null || {
        exec {PROTON_PASS_CHILD_STDOUT_FD}>&-
        die 'cannot discard bounded-child diagnostics'
      }
      ;;
    capture-diagnostics)
      (( PROTON_PASS_DIAGNOSTIC_WRITE_FD > 0 )) ||
        die 'missing bounded-child diagnostic file'
      exec {PROTON_PASS_CHILD_STDOUT_FD}>/dev/null ||
        die 'cannot discard bounded-child output'
      exec {PROTON_PASS_CHILD_STDERR_FD}>&$PROTON_PASS_DIAGNOSTIC_WRITE_FD || {
        exec {PROTON_PASS_CHILD_STDOUT_FD}>&-
        die 'cannot capture bounded-child diagnostics'
      }
      ;;
    *)
      die 'invalid bounded-child output mode'
      ;;
  esac

  (( ++PROTON_PASS_CHILD_SEQUENCE ))
  local child_name="proton-pass-${sysparams[pid]}-$PROTON_PASS_CHILD_SEQUENCE"
  # zpty supplies a portable session/PGID; provider bytes bypass its PTY.
  local child_wrapper='
integer child_diagnostic_status=0
exec {PROTON_PASS_ESCAPE_DIAGNOSTIC_FD}>&- || child_diagnostic_status=125
(( PROTON_PASS_DIAGNOSTIC_READ_FD <= 0 )) ||
  exec {PROTON_PASS_DIAGNOSTIC_READ_FD}<&- || child_diagnostic_status=125
(( PROTON_PASS_DIAGNOSTIC_WRITE_FD <= 0 )) ||
  exec {PROTON_PASS_DIAGNOSTIC_WRITE_FD}>&- || child_diagnostic_status=125
trap '\''kill -KILL 0'\'' HUP
trap '\'''\'' TERM
unsetopt monitor
unset environment_value bootstrap_token
typeset child_start=
IFS= read -r child_start
integer child_start_status=$?
[[ $child_start == start ]] || child_start_status=126
unset child_start
integer child_status
if (( child_diagnostic_status != 0 )); then
  unset PROTON_PASS_CHILD_ENVIRONMENT_VALUE
  child_status=$child_diagnostic_status
elif (( child_start_status != 0 )); then
  unset PROTON_PASS_CHILD_ENVIRONMENT_VALUE
  child_status=126
elif [[ -n $PROTON_PASS_CHILD_ENVIRONMENT_NAME ]]; then
  (
    trap - HUP TERM
    typeset -gx "$PROTON_PASS_CHILD_ENVIRONMENT_NAME=$PROTON_PASS_CHILD_ENVIRONMENT_VALUE"
    unset PROTON_PASS_CHILD_ENVIRONMENT_VALUE
    exec "${PROTON_PASS_CHILD_ARGV[@]}" \
      >&$PROTON_PASS_CHILD_STDOUT_FD 2>&$PROTON_PASS_CHILD_STDERR_FD
  ) &
  integer credential_child_pid=$!
  unset PROTON_PASS_CHILD_ENVIRONMENT_VALUE
  wait $credential_child_pid
  child_status=$?
else
  unset PROTON_PASS_CHILD_ENVIRONMENT_VALUE
  (
    trap - HUP TERM
    exec "${PROTON_PASS_CHILD_ARGV[@]}" \
      >&$PROTON_PASS_CHILD_STDOUT_FD 2>&$PROTON_PASS_CHILD_STDERR_FD
  ) &
  integer credential_child_pid=$!
  wait $credential_child_pid
  child_status=$?
fi
zmodload zsh/zselect || child_status=125
integer group_quiescent=0
while (( ! group_quiescent )); do
  typeset group_listing=
  group_listing=$(trap - HUP TERM; exec /usr/bin/env -i LC_ALL=C /bin/ps -eo pid=,pgid=) || {
    child_status=125
    break
  }
  integer controller_seen=0 group_members=0 listing_valid=1
  typeset group_line=
  typeset -a group_fields
  for group_line in ${(f)group_listing}; do
    group_fields=( ${=group_line} )
    if (( ${#group_fields} != 2 )) ||
      [[ $group_fields[1] != <-> || $group_fields[2] != <-> ]]; then
      listing_valid=0
      break
    fi
    if (( group_fields[2] == sysparams[pid] )); then
      (( ++group_members ))
      (( group_fields[1] == sysparams[pid] )) && controller_seen=1
    fi
  done
  if (( ! listing_valid || ! controller_seen || group_members < 2 )); then
    child_status=125
    break
  fi
  (( group_members == 2 )) && group_quiescent=1
  (( group_quiescent )) || zselect -t 1 2>/dev/null || true
done
print -r -- "status:$child_status"
typeset child_finish=
IFS= read -r child_finish || kill -KILL 0'

  integer start_status=0
  zpty -b "$child_name" "$child_wrapper" || start_status=$?
  unset PROTON_PASS_CHILD_ENVIRONMENT_VALUE
  exec {PROTON_PASS_CHILD_STDOUT_FD}>&-
  exec {PROTON_PASS_CHILD_STDERR_FD}>&-
  (( start_status == 0 )) ||
    escape_unmanageable_child 'cannot identify bounded credential process group'

  local listing child_listing
  listing=$(zpty 2>/dev/null) ||
    escape_unmanageable_child 'cannot identify bounded credential process group'
  child_listing=${(M)${(f)listing}:#\(*\) ${child_name}:*}
  local child_pgid_text=${${child_listing#\(}%%\)*}
  if [[ -z $child_listing || $child_pgid_text != <-> ||
    $child_pgid_text -le 1 ]] ||
    ! kill -0 -- -$child_pgid_text 2>/dev/null ||
    ! kill -0 -- -$child_pgid_text 2>/dev/null; then
    escape_unmanageable_child 'cannot identify bounded credential process group'
  fi
  integer child_pgid=$child_pgid_text
  typeset -g PROTON_PASS_ACTIVE_CHILD_NAME=$child_name
  typeset -gi PROTON_PASS_ACTIVE_CHILD_PGID=$child_pgid
  if ! zpty -w "$child_name" start; then
    terminate_active_child
    die 'cannot release bounded credential child'
  fi
}

wait_bounded_child() {
  emulate -L zsh

  typeset -g PROTON_PASS_LAST_WAITER_STAGE=unrecorded
  local timeout_seconds=$1
  local child_name=$PROTON_PASS_ACTIVE_CHILD_NAME
  integer child_pgid=$PROTON_PASS_ACTIVE_CHILD_PGID
  zmodload zsh/datetime || die 'zsh/datetime is required'
  zmodload zsh/zselect || die 'zsh/zselect is required'
  local -F deadline=$(( EPOCHREALTIME + timeout_seconds ))

  # Nonblocking zpty reads may split a line; accumulate one bounded record.
  local status_record= status_chunk=
  integer status_max_length=32
  while [[ $status_record != *$'\n'* ]]; do
    status_chunk=
    if zpty -r -t "$child_name" status_chunk 2>/dev/null &&
      [[ -n $status_chunk ]]; then
      if (( ${#status_record} + ${#status_chunk} > status_max_length )); then
        typeset -g PROTON_PASS_LAST_WAITER_STAGE=record
        status_record=invalid
        break
      fi
      status_record+=$status_chunk
      continue
    fi
    if ! kill -0 -- -$child_pgid 2>/dev/null; then
      if ! active_child_identity_matches "$child_name" $child_pgid; then
        typeset -g PROTON_PASS_LAST_WAITER_STAGE=identity
        status_record=invalid
        break
      fi
      if ! kill -0 -- -$child_pgid 2>/dev/null; then
        typeset -g PROTON_PASS_LAST_WAITER_STAGE=liveness-retry
        status_record=invalid
        break
      fi
    fi
    if (( EPOCHREALTIME >= deadline )); then
      terminate_active_child
      return 124
    fi
    zselect -t "$PROTON_PASS_POLL_CENTISECONDS" 2>/dev/null || true
  done
  [[ $status_record == status:<->$'\r\n' ||
    $status_record == status:<->$'\n' ]] || {
      [[ $PROTON_PASS_LAST_WAITER_STAGE != unrecorded ]] ||
        typeset -g PROTON_PASS_LAST_WAITER_STAGE=record
      terminate_active_child
      return 125
    }
  status_record=${status_record%$'\n'}
  status_record=${status_record%$'\r'}
  [[ $status_record == status:<-> ]] || {
      typeset -g PROTON_PASS_LAST_WAITER_STAGE=record
      terminate_active_child
      return 125
    }
  integer child_status=${status_record#status:}
  (( child_status == 0 )) ||
    typeset -g PROTON_PASS_LAST_WAITER_STAGE=child-status
  if ! active_child_identity_matches "$child_name" $child_pgid ||
    ! kill -0 -- -$child_pgid 2>/dev/null ||
    ! zpty -d "$child_name" 2>/dev/null; then
    typeset -g PROTON_PASS_LAST_WAITER_STAGE=retirement
    typeset -g PROTON_PASS_ACTIVE_CHILD_NAME=
    typeset -gi PROTON_PASS_ACTIVE_CHILD_PGID=0
    escape_unmanageable_child 'bounded credential child became unmanageable'
  fi
  typeset -g PROTON_PASS_ACTIVE_CHILD_NAME=
  typeset -gi PROTON_PASS_ACTIVE_CHILD_PGID=0
  integer finish_polls=$PROTON_PASS_TERMINATION_GRACE_CENTISECONDS
  while (( finish_polls-- > 0 )) && kill -0 -- -$child_pgid 2>/dev/null; do
    zselect -t 1 2>/dev/null || true
  done
  if kill -0 -- -$child_pgid 2>/dev/null; then
    typeset -g PROTON_PASS_LAST_WAITER_STAGE=retirement
    return 125
  fi
  return $child_status
}

run_bounded() {
  emulate -L zsh

  local timeout_seconds=$1
  local output_mode=$2
  shift 2
  [[ $1 == -- ]] || die 'invalid bounded-child request'
  shift
  local PROTON_PASS_CHILD_ENVIRONMENT_VALUE=
  start_bounded_child '' "$output_mode" -- "$@"
  wait_bounded_child "$timeout_seconds"
}

trap cleanup_readiness_process EXIT
trap 'cleanup_readiness_process; exit 129' HUP
trap 'cleanup_readiness_process; exit 130' INT
trap 'cleanup_readiness_process; exit 143' TERM

resolve_trusted_command() {
  emulate -L zsh

  local name=$1
  shift

  zmodload zsh/stat || die 'zsh/stat is required'
  local candidate
  for candidate in "$@"; do
    [[ $candidate == /* ]] || continue
    [[ -f $candidate && ! -L $candidate && -x $candidate ]] || continue
    local -A metadata
    zstat -H metadata -- "$candidate" || continue
    (( metadata[uid] == 0 || metadata[uid] == EUID )) || continue
    (( (metadata[mode] & 8#022) == 0 )) || continue
    print -r -- "$candidate"
    return 0
  done
  die "a trusted $name is required"
}

select_pass_cli_command() {
  emulate -L zsh

  command -v pass-cli >/dev/null 2>&1 || die 'pass-cli is required'
  print -r -- pass-cli
}

prepare_state_directory() {
  emulate -L zsh

  local state_dir=$1
  [[ ! -L $state_dir ]] || die 'state directory must not be a symbolic link'
  /bin/mkdir -p -- "$state_dir" || die 'cannot create the state directory'
  [[ -d $state_dir && ! -L $state_dir ]] ||
    die 'state directory must be a real directory'

  zmodload zsh/stat || die 'zsh/stat is required'
  local -A metadata
  zstat -H metadata -- "$state_dir" || die 'cannot inspect the state directory'
  (( metadata[uid] == EUID )) ||
    die 'state directory must be owned by the current user'
  /bin/chmod -- 700 "$state_dir" || die 'cannot secure the state directory'
}

# Specific reasons name a cause an operator can act on. Timeouts, lock waits,
# and unclassified states stay generic, so they never displace a recorded
# specific failure.
specific_failure_reason() {
  emulate -L zsh

  case $1 in
    unsafe-lock|native-store-unavailable|invalid-bootstrap-value) return 0 ;;
    logout-failed|login-failed|login-already-authenticated) return 0 ;;
    login-token-rejected|login-token-malformed|login-session-refused) return 0 ;;
    verify-failed|login-marker-failed) return 0 ;;
  esac
  return 1
}

write_status() {
  emulate -L zsh
  setopt local_options no_unset

  local state=$1
  local reason=$2
  local waiter_stage=$3
  case $state in
    ready|unavailable) ;;
    *) state=unavailable ;;
  esac
  # Ready and generic reasons; every specific reason is listed only above.
  case $reason in
    existing-session|concurrent-repair|repaired) ;;
    lock-timeout|concurrent-repair-failed) ;;
    session-probe-timeout|session-state-unknown) ;;
    native-store-timeout|logout-timeout|login-timeout|verify-timeout) ;;
    *) specific_failure_reason "$reason" || reason=unrecorded ;;
  esac
  case $waiter_stage in
    record|identity|liveness-retry|child-status|retirement|unrecorded) ;;
    *) waiter_stage=unrecorded ;;
  esac
  local state_dir=${XDG_STATE_HOME:-$HOME/.local/state}/secret-exec
  prepare_state_directory "$state_dir"
  local status_file=$state_dir/proton-pass-readiness.status

  zmodload zsh/datetime || die 'zsh/datetime is required'
  # The latest specific failure survives later writes, including ready ones.
  # Only enumerated values carry over from the previous file.
  local last_failure_reason= last_failure_at=
  if [[ -f $status_file && ! -L $status_file ]]; then
    local status_line previous_reason= previous_at=
    integer status_lines=0
    while (( status_lines++ < 8 )) && IFS= read -r status_line; do
      case $status_line in
        last-failure-reason=*) previous_reason=${status_line#*=} ;;
        last-failure-at=*) previous_at=${status_line#*=} ;;
      esac
    done < "$status_file" 2>/dev/null || true
    if specific_failure_reason "$previous_reason" &&
      [[ $previous_at == <-> ]]; then
      last_failure_reason=$previous_reason
      last_failure_at=$previous_at
    fi
  fi
  if [[ $state == unavailable ]] && specific_failure_reason "$reason"; then
    last_failure_reason=$reason
    last_failure_at=$EPOCHSECONDS
  fi
  local -a status_lines_out=(
    "state=$state"
    "reason=$reason"
    "waiter-stage=$waiter_stage"
    "updated_at=$EPOCHSECONDS"
  )
  [[ -z $last_failure_reason ]] || status_lines_out+=(
    "last-failure-reason=$last_failure_reason"
    "last-failure-at=$last_failure_at"
  )
  local temporary
  temporary=$(/usr/bin/mktemp "$state_dir/.proton-pass-readiness.XXXXXX") ||
    die 'cannot create the readiness status'
  print -rl -- "${status_lines_out[@]}" > "$temporary" || {
      /bin/rm -f -- "$temporary"
      die 'cannot write the readiness status'
    }
  /bin/chmod -- 600 "$temporary" || {
    /bin/rm -f -- "$temporary"
    die 'cannot secure the readiness status'
  }
  /bin/mv -f -- "$temporary" "$status_file" || {
    /bin/rm -f -- "$temporary"
    die 'cannot publish the readiness status'
  }
}

fail_readiness() {
  emulate -L zsh

  local reason=$1
  local message=$2
  local waiter_stage=$3
  write_status unavailable "$reason" "$waiter_stage"
  die "$message"
}

session_ready() {
  emulate -L zsh

  local backend=$1
  local timeout_seconds=$2
  local -x PROTON_PASS_NO_UPDATE_CHECK=1
  local -x PROTON_PASS_DISABLE_TELEMETRY=1
  run_bounded "$timeout_seconds" discard -- "$backend" info
}

diagnostic_matches_state() {
  emulate -L zsh

  local diagnostic=$1
  local expected=$2
  local state=$3
  [[ $diagnostic == "$expected" ]] && return 0
  if [[ $state == absent &&
    $diagnostic == "$PROTON_PASS_ABSENT_STATE_RECORD"$'\n'"$expected" ]]; then
    return 0
  fi
  [[ $diagnostic == *$'\n'"$expected" ]] || return 1

  local framing=${diagnostic%$'\n'"$expected"}
  [[ -n $framing && $framing != $'\n'* && $framing != *$'\n' &&
    $framing != *$'\n\n'* ]] || return 1
  local line
  local timestamp_pattern='[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z'
  local source_pattern='pass-cli/src/main\.rs'
  local state_message_pattern
  local log_line_pattern
  local ansi_log_line_pattern
  case $state in
    absent)
      state_message_pattern='(Command is not logout there is no session|'
      state_message_pattern+='Session is some but is not logged in)'
      ;;
    invalidated)
      state_message_pattern='Session invalidated'
      ;;
    *)
      return 1
      ;;
  esac

  log_line_pattern="^${timestamp_pattern} ERROR ${source_pattern}:[0-9]+: ${state_message_pattern}\$"
  local dim_pattern=$'\e\\[2m'
  local red_pattern=$'\e\\[31m'
  local reset_pattern=$'\e\\[0m'
  ansi_log_line_pattern="^${dim_pattern}${timestamp_pattern}${reset_pattern} "
  ansi_log_line_pattern+="${red_pattern}ERROR${reset_pattern} "
  ansi_log_line_pattern+="${dim_pattern}${source_pattern}${reset_pattern}"
  ansi_log_line_pattern+="${dim_pattern}:${reset_pattern}${dim_pattern}[0-9]+:${reset_pattern} "
  ansi_log_line_pattern+="${state_message_pattern}\$"

  local framing_mode=
  for line in "${(f)framing}"; do
    [[ $line != *$'\0'* ]] || return 1
    if [[ $line =~ $log_line_pattern ]]; then
      [[ $framing_mode != ansi ]] || return 1
      framing_mode=plain
    elif [[ $line =~ $ansi_log_line_pattern ]]; then
      [[ $framing_mode != plain ]] || return 1
      framing_mode=ansi
    else
      return 1
    fi
  done
}

# The terminal diagnostic stays byte-exact. Only the local database engine's
# plain `ERROR CORE` records may precede it.
diagnostic_matches_undecryptable_store() {
  emulate -L zsh

  local diagnostic=$1
  [[ $diagnostic == "$PROTON_PASS_UNDECRYPTABLE_DIAGNOSTIC" ]] && return 0
  [[ $diagnostic == *$'\n'"$PROTON_PASS_UNDECRYPTABLE_DIAGNOSTIC" ]] || return 1

  local framing=${diagnostic%$'\n'"$PROTON_PASS_UNDECRYPTABLE_DIAGNOSTIC"}
  [[ -n $framing && $framing != $'\n'* && $framing != *$'\n' &&
    $framing != *$'\n\n'* ]] || return 1
  local core_record_pattern='^[0-9]{4}-[0-9]{2}-[0-9]{2} '
  core_record_pattern+='[0-9]{2}:[0-9]{2}:[0-9]{2}\.[0-9]{3}: ERROR CORE [^[:cntrl:]]+$'
  local line
  for line in "${(f)framing}"; do
    [[ $line != *$'\0'* && $line =~ $core_record_pattern ]] || return 1
  done
}

classify_session_state() {
  emulate -L zsh
  setopt local_options no_unset pipe_fail

  local backend=$1
  local state_dir=$2
  typeset -g PROTON_PASS_SESSION_STATE=unknown
  typeset -g PROTON_PASS_SESSION_WAITER_STAGE=unrecorded
  create_diagnostic_file "$state_dir" .proton-pass-session-probe

  local -x PROTON_PASS_NO_UPDATE_CHECK=1
  # Telemetry can drop authentication first and print a different diagnostic.
  local -x PROTON_PASS_DISABLE_TELEMETRY=1
  integer probe_status=0
  run_bounded "$PROTON_PASS_CLASSIFY_PROBE_TIMEOUT_SECONDS" \
    capture-diagnostics -- "$backend" info || probe_status=$?
  local waiter_stage=$PROTON_PASS_LAST_WAITER_STAGE
  typeset -g PROTON_PASS_SESSION_WAITER_STAGE=$waiter_stage
  if (( probe_status == 0 )); then
    remove_diagnostic_file
    typeset -g PROTON_PASS_SESSION_STATE=ready
    return 0
  fi
  if (( probe_status == 124 )) && [[ $waiter_stage != child-status ]]; then
    remove_diagnostic_file
    typeset -g PROTON_PASS_SESSION_STATE=timeout
    return 0
  fi

  # Only a reported provider exit is read, and only by exact text.
  if [[ $waiter_stage != child-status ]]; then
    remove_diagnostic_file
    return 0
  fi
  consume_diagnostic_file || return 0
  local diagnostic=$PROTON_PASS_DIAGNOSTIC_TEXT
  typeset -g PROTON_PASS_DIAGNOSTIC_TEXT=
  if diagnostic_matches_state \
    "$diagnostic" "$PROTON_PASS_ABSENT_DIAGNOSTIC" absent; then
    typeset -g PROTON_PASS_SESSION_STATE=absent
  elif [[ $diagnostic == "$PROTON_PASS_ORPHANED_SESSION_DIAGNOSTIC" ]]; then
    # No framing is accepted: the supported CLI emits none on this path.
    typeset -g PROTON_PASS_SESSION_STATE=orphaned
  elif diagnostic_matches_state \
    "$diagnostic" "$PROTON_PASS_INVALIDATED_DIAGNOSTIC" invalidated; then
    typeset -g PROTON_PASS_SESSION_STATE=invalidated
  elif diagnostic_matches_undecryptable_store "$diagnostic"; then
    typeset -g PROTON_PASS_SESSION_STATE=undecryptable
  fi
}

# Opens, validates, and locks the readiness lock, shared or exclusive, waiting
# up to the given seconds, and leaves the locked descriptor in
# PROTON_PASS_READINESS_LOCK_FD. Returns 2 when the wait expires; every other
# failure fails readiness. zsh locks with fcntl(2), so the lock belongs to this
# process alone: children never inherit it, and it ends when the process exits
# or closes any descriptor for the file.
lock_readiness() {
  emulate -L zsh

  local lock_file=$1
  local lock_mode=$2
  local wait_seconds=$3
  local -a lock_options=(-t "$wait_seconds" -i 0.05)
  case $lock_mode in
    shared) lock_options+=(-r) ;;
    exclusive) ;;
    *) die 'invalid readiness lock mode' ;;
  esac
  typeset -gi PROTON_PASS_READINESS_LOCK_FD=0
  zmodload zsh/stat || die 'zsh/stat is required'
  zmodload zsh/system ||
    fail_readiness unsafe-lock 'zsh/system is required for readiness locking' unrecorded
  [[ ! -L $lock_file ]] ||
    fail_readiness unsafe-lock 'readiness lock must not be a symbolic link' unrecorded
  if [[ -e $lock_file ]]; then
    [[ -f $lock_file ]] ||
      fail_readiness unsafe-lock 'readiness lock must be a regular file' unrecorded
    local -A existing_lock
    zstat -H existing_lock -- "$lock_file" ||
      fail_readiness unsafe-lock 'cannot inspect the readiness lock' unrecorded
    (( existing_lock[uid] == EUID )) ||
      fail_readiness unsafe-lock 'readiness lock must be owned by the current user' unrecorded
  fi
  integer lock_create_fd
  exec {lock_create_fd}>>"$lock_file" ||
    fail_readiness unsafe-lock 'cannot open the readiness lock' unrecorded
  local -A opened_lock published_lock
  zstat -H opened_lock -f "$lock_create_fd" ||
    fail_readiness unsafe-lock 'cannot inspect the opened readiness lock' unrecorded
  zstat -H published_lock -- "$lock_file" ||
    fail_readiness unsafe-lock 'cannot inspect the published readiness lock' unrecorded
  (( opened_lock[device] == published_lock[device] &&
    opened_lock[inode] == published_lock[inode] )) ||
    fail_readiness unsafe-lock 'readiness lock changed while opening' unrecorded
  (( opened_lock[uid] == EUID )) ||
    fail_readiness unsafe-lock 'readiness lock must be owned by the current user' unrecorded
  (( (opened_lock[mode] & 8#7777) == 8#600 )) ||
    fail_readiness unsafe-lock 'readiness lock must have mode 0600' unrecorded
  exec {lock_create_fd}>&-

  integer lock_fd
  integer lock_status=0
  zsystem flock "${lock_options[@]}" -f lock_fd "$lock_file" || lock_status=$?
  if (( lock_status != 0 )); then
    (( lock_status != 2 )) || return 2
    fail_readiness unsafe-lock 'cannot acquire the readiness lock' unrecorded
  fi
  [[ ! -L $lock_file ]] || {
    zsystem flock -u lock_fd
    fail_readiness unsafe-lock 'readiness lock must not be a symbolic link' unrecorded
  }
  zstat -H opened_lock -f "$lock_fd" || {
    zsystem flock -u lock_fd
    fail_readiness unsafe-lock 'cannot inspect the locked readiness file' unrecorded
  }
  zstat -H published_lock -- "$lock_file" || {
    zsystem flock -u lock_fd
    fail_readiness unsafe-lock 'cannot inspect the published readiness lock' unrecorded
  }
  (( opened_lock[device] == published_lock[device] &&
    opened_lock[inode] == published_lock[inode] )) || {
    zsystem flock -u lock_fd
    fail_readiness unsafe-lock 'readiness lock changed while locking' unrecorded
  }
  (( opened_lock[uid] == EUID )) || {
    zsystem flock -u lock_fd
    fail_readiness unsafe-lock 'readiness lock must be owned by the current user' unrecorded
  }
  (( (opened_lock[mode] & 8#7777) == 8#600 )) || {
    zsystem flock -u lock_fd
    fail_readiness unsafe-lock 'readiness lock must have mode 0600' unrecorded
  }
  typeset -gi PROTON_PASS_READINESS_LOCK_FD=$lock_fd
}

# Every login runs under the exclusive readiness lock, and the lock dies with
# its holder. A marker found while holding the lock therefore belongs to a
# repair that never reached verification or cleanup, and whatever it stored is
# suspect: pass-cli writes its session before its private token key.
login_marker_usable() {
  emulate -L zsh

  local login_marker=$1
  [[ ! -L $login_marker ]] &&
    [[ ! -e $login_marker || -f $login_marker ]]
}

record_login_marker() {
  emulate -L zsh

  local state_dir=$1
  local login_marker=$2
  login_marker_usable "$login_marker" ||
    fail_readiness login-marker-failed \
      'the login marker must be a regular file' unrecorded
  zmodload zsh/datetime || die 'zsh/datetime is required'
  local temporary
  temporary=$(/usr/bin/mktemp "$state_dir/.proton-pass-login.XXXXXX") ||
    fail_readiness login-marker-failed \
      'cannot record the repair in progress' unrecorded
  if ! print -r -- "started_at=$EPOCHSECONDS" > "$temporary" ||
    ! /bin/chmod -- 600 "$temporary" ||
    ! /bin/mv -f -- "$temporary" "$login_marker"; then
    /bin/rm -f -- "$temporary"
    fail_readiness login-marker-failed \
      'cannot record the repair in progress' unrecorded
  fi
}

clear_login_marker() {
  emulate -L zsh

  local login_marker=$1
  /bin/rm -f -- "$login_marker" ||
    fail_readiness login-marker-failed \
      'cannot clear the login marker' unrecorded
}

force_local_logout() {
  emulate -L zsh

  local backend=$1
  integer logout_status=0
  run_bounded "$PROTON_PASS_LOGOUT_TIMEOUT_SECONDS" discard -- \
    "$backend" logout --force || logout_status=$?
  local logout_waiter_stage=$PROTON_PASS_LAST_WAITER_STAGE
  (( logout_status != 0 )) || return 0
  if (( logout_status == 124 )) && [[ $logout_waiter_stage != child-status ]]; then
    fail_readiness logout-timeout 'provider-session cleanup timed out' \
      "$logout_waiter_stage"
  fi
  fail_readiness logout-failed 'provider-session cleanup failed' \
    "$logout_waiter_stage"
}

classify_login_failure() {
  emulate -L zsh

  local diagnostic=$1
  local reason=login-failed
  local message='provider-session repair failed'
  local malformed_diagnostic
  if [[ $diagnostic == "$PROTON_PASS_LOGIN_ALREADY_AUTHENTICATED_DIAGNOSTIC" ]]; then
    reason=login-already-authenticated
    message='provider login refused: a local provider session is still authenticated'
  elif [[ $diagnostic == "$PROTON_PASS_LOGIN_TOKEN_REJECTED_DIAGNOSTIC" ]]; then
    reason=login-token-rejected
    message='the provider rejected the bootstrap token as invalid, expired, or deleted'
  elif [[ $diagnostic == "$PROTON_PASS_LOGIN_SESSION_REFUSED_DIAGNOSTIC" ]]; then
    reason=login-session-refused
    message='the provider refused to open a login session'
  else
    for malformed_diagnostic in "${PROTON_PASS_LOGIN_TOKEN_MALFORMED_DIAGNOSTICS[@]}"; do
      [[ $diagnostic == "$malformed_diagnostic" ]] || continue
      reason=login-token-malformed
      message='the bootstrap token is not a well-formed personal access token'
      break
    done
  fi
  typeset -g PROTON_PASS_LOGIN_FAILURE_REASON="$reason"
  typeset -g PROTON_PASS_LOGIN_FAILURE_MESSAGE="$message"
}

main() {
  emulate -L zsh
  setopt local_options err_return no_unset pipe_fail

  (( $# == 0 )) || die 'this operation takes no arguments'
  local platform_id=$OSTYPE
  case $platform_id in
    linux*)
      export PROTON_PASS_LINUX_KEYRING=dbus
      ;;
    darwin*)
      unset PROTON_PASS_LINUX_KEYRING 2>/dev/null || true
      ;;
    *)
      die 'only macOS and Linux are supported'
      ;;
  esac

  local backend
  backend=$(select_pass_cli_command)
  local state_dir=${XDG_STATE_HOME:-$HOME/.local/state}/secret-exec
  local login_marker=$state_dir/proton-pass-login.pending
  local lock_file=$state_dir/proton-pass-readiness.lock
  prepare_state_directory "$state_dir"

  # Info accepts the partial session a login leaves, and every repair holds the
  # lock exclusively from before it records its marker until it publishes its
  # status. The first probe therefore runs under a shared lock: it waits out a
  # repair instead of racing it, and readers still run side by side. A marker
  # seen here belongs to a repair that never finished, so only the exclusive
  # path may judge that session. The shared lock is released before that path
  # starts, never upgraded, and a wait that expires goes straight there.
  integer lock_status=0
  lock_readiness "$lock_file" shared "$PROTON_PASS_READY_LOCK_WAIT_SECONDS" ||
    lock_status=$?
  if (( lock_status == 0 )); then
    integer existing_session_ready=0
    if login_marker_usable "$login_marker" && [[ ! -e $login_marker ]] &&
      session_ready "$backend" "$PROTON_PASS_READY_PROBE_TIMEOUT_SECONDS"; then
      write_status ready existing-session unrecorded
      existing_session_ready=1
    fi
    zsystem flock -u PROTON_PASS_READINESS_LOCK_FD
    (( ! existing_session_ready )) || return 0
  fi

  integer waited_for_concurrent_repair=0
  lock_status=0
  lock_readiness "$lock_file" exclusive "$PROTON_PASS_LOCK_TAKEOVER_SECONDS" ||
    lock_status=$?
  if (( lock_status != 0 )); then
    waited_for_concurrent_repair=1
    lock_status=0
    lock_readiness "$lock_file" exclusive \
      "$PROTON_PASS_CONCURRENT_REPAIR_WAIT_SECONDS" || lock_status=$?
    (( lock_status == 0 )) ||
      fail_readiness lock-timeout \
        'timed out waiting for provider-session repair' unrecorded
  fi
  integer lock_fd=$PROTON_PASS_READINESS_LOCK_FD

  # An unusable marker stops the call before anything is classified or reset.
  login_marker_usable "$login_marker" || {
    zsystem flock -u lock_fd
    fail_readiness login-marker-failed \
      'the login marker must be a regular file' unrecorded
  }
  integer interrupted_repair=0
  [[ ! -f $login_marker ]] || interrupted_repair=1
  classify_session_state "$backend" "$state_dir"
  local session_state=$PROTON_PASS_SESSION_STATE
  local session_waiter_stage=$PROTON_PASS_SESSION_WAITER_STAGE
  if [[ $session_state == ready ]] && (( ! interrupted_repair )); then
    write_status ready concurrent-repair unrecorded
    return 0
  fi
  if (( waited_for_concurrent_repair )); then
    zsystem flock -u lock_fd
    fail_readiness concurrent-repair-failed \
      'the concurrent provider-session repair did not establish readiness' unrecorded
  fi
  # A ready session reaches this point only behind an interrupted repair.
  case $session_state in
    ready|absent|orphaned|invalidated|undecryptable) ;;
    timeout)
      zsystem flock -u lock_fd
      fail_readiness session-probe-timeout \
        'provider-session readiness check timed out' "$session_waiter_stage"
      ;;
    *)
      zsystem flock -u lock_fd
      fail_readiness session-state-unknown \
        'provider-session readiness could not be classified' "$session_waiter_stage"
      ;;
  esac

  local native_store_adapter
  native_store_adapter=$(resolve_trusted_command 'native-store adapter' \
    "$PROTON_PASS_SCRIPT_DIR/secret-exec-native-store")
  local bootstrap_token
  if bootstrap_token=$(run_bounded \
    "$PROTON_PASS_NATIVE_STORE_TIMEOUT_SECONDS" \
    capture -- "$native_store_adapter" proton-bootstrap); then
    :
  else
    integer store_status=$?
    (( store_status == 124 )) &&
      fail_readiness native-store-timeout \
        'the native bootstrap item lookup timed out' unrecorded
    fail_readiness native-store-unavailable \
      'the native bootstrap item is unavailable or locked' unrecorded
  fi
  [[ -n $bootstrap_token && $bootstrap_token != *$'\n'* && $bootstrap_token != *$'\r'* ]] ||
    fail_readiness invalid-bootstrap-value \
      'the native bootstrap item must contain one non-empty line' unrecorded

  # The marker covers the forced logout as well as the login: unlocked
  # readers stay off local state that is being replaced.
  record_login_marker "$state_dir" "$login_marker"
  # Stored local authentication blocks login, so remove it only after a
  # positive classification and a validated bootstrap value. Whatever an
  # interrupted repair stored is removed the same way.
  if (( interrupted_repair )) ||
    [[ $session_state == (orphaned|invalidated|undecryptable) ]]; then
    force_local_logout "$backend"
  fi

  # Login stderr goes only to a private unlinked file; stdout carries account
  # metadata.
  create_diagnostic_file "$state_dir" .proton-pass-login-diagnostic
  local PROTON_PASS_CHILD_ENVIRONMENT_VALUE=$bootstrap_token
  unset bootstrap_token
  start_bounded_child "$PROTON_PASS_BOOTSTRAP_FIELD" \
    capture-diagnostics -- "$backend" login
  unset PROTON_PASS_CHILD_ENVIRONMENT_VALUE
  integer login_status=0
  wait_bounded_child "$PROTON_PASS_LOGIN_TIMEOUT_SECONDS" || login_status=$?
  local login_waiter_stage=$PROTON_PASS_LAST_WAITER_STAGE
  if (( login_status != 0 )); then
    local login_failure_reason login_failure_message
    if (( login_status == 124 )) && [[ $login_waiter_stage != child-status ]]; then
      remove_diagnostic_file
      login_failure_reason=login-timeout
      login_failure_message='provider-session repair timed out'
    else
      # Only a reported provider exit is classified, and only by exact text.
      local login_diagnostic=
      if [[ $login_waiter_stage == child-status ]] && consume_diagnostic_file; then
        login_diagnostic=$PROTON_PASS_DIAGNOSTIC_TEXT
      fi
      remove_diagnostic_file
      typeset -g PROTON_PASS_DIAGNOSTIC_TEXT=
      classify_login_failure "$login_diagnostic"
      unset login_diagnostic
      login_failure_reason=$PROTON_PASS_LOGIN_FAILURE_REASON
      login_failure_message=$PROTON_PASS_LOGIN_FAILURE_MESSAGE
    fi
    # Info rejected any local authentication before login, so what a failed
    # login leaves is unusable to this helper: often partial state that info
    # accepts while item reads fail. The cleanup cannot tell that from a
    # complete login behind a failed waiter, or from a session another process
    # stored outside the lock, and deliberately discards either rather than
    # report an unusable session as ready. Only an exact refusal, which stored
    # nothing, keeps what it found. A failed cleanup keeps the login marker,
    # so the next call forces out whatever survived.
    [[ $login_failure_reason == login-already-authenticated ]] ||
      force_local_logout "$backend"
    clear_login_marker "$login_marker"
    fail_readiness "$login_failure_reason" "$login_failure_message" \
      "$login_waiter_stage"
  fi
  remove_diagnostic_file
  # A login that fails verification keeps its marker, so the next call forces
  # out what it stored and logs in again.
  if session_ready "$backend" "$PROTON_PASS_VERIFY_TIMEOUT_SECONDS"; then
    :
  else
    integer verify_status=$?
    (( verify_status == 124 )) &&
      fail_readiness verify-timeout 'repaired provider-session verification timed out' unrecorded
    fail_readiness verify-failed 'the repaired provider session did not verify' unrecorded
  fi
  clear_login_marker "$login_marker"
  write_status ready repaired unrecorded
}

main "$@"
