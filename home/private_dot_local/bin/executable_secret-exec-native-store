#!/bin/zsh -f

[[ -o xtrace ]] && unsetopt xtrace
PROTON_PASS_BOOTSTRAP_FIELD=PROTON_PASS_PERSONAL_ACCESS
PROTON_PASS_BOOTSTRAP_FIELD+=_TOKEN
readonly PROTON_PASS_BOOTSTRAP_FIELD
unset "$PROTON_PASS_BOOTSTRAP_FIELD" 2>/dev/null || true
set -euo pipefail
umask 077

die() {
  print -u2 -r -- "secret-exec-native-store: $1"
  exit 1
}

resolve_trusted_command() {
  emulate -L zsh

  local name=$1
  shift
  zmodload zsh/stat || die 'zsh/stat is required'
  local candidate
  for candidate in "$@"; do
    [[ $candidate == /* ]] || continue
    [[ -f $candidate && ! -L $candidate && -x $candidate ]] || continue
    local -A metadata
    zstat -H metadata -- "$candidate" || continue
    (( metadata[uid] == 0 || metadata[uid] == EUID )) || continue
    (( (metadata[mode] & 8#022) == 0 )) || continue
    print -r -- "$candidate"
    return 0
  done
  die "a trusted $name is required"
}

main() {
  emulate -L zsh
  setopt local_options err_return no_unset pipe_fail

  local operation=${1:-}
  case $operation in
    proton-bootstrap)
      (( $# == 1 )) || die 'proton-bootstrap takes no arguments'
      case $OSTYPE in
        linux*)
          local secret_tool
          secret_tool=$(resolve_trusted_command secret-tool /usr/bin/secret-tool)
          exec "$secret_tool" lookup \
            application secret-exec \
            profile proton-session \
            name "$PROTON_PASS_BOOTSTRAP_FIELD"
          ;;
        darwin*)
          local security_tool
          security_tool=$(resolve_trusted_command security /usr/bin/security)
          exec "$security_tool" find-generic-password \
            -a proton-session -s secret-exec -w
          ;;
        *)
          die 'the Proton bootstrap store supports only macOS and Linux'
          ;;
      esac
      ;;
    lookup)
      (( $# == 3 )) || die 'lookup requires a profile and variable name'
      local profile=$2
      local name=$3
      [[ $profile =~ '^[A-Za-z0-9][A-Za-z0-9_.-]*$' ]] ||
        die 'invalid profile name'
      [[ $name =~ '^[A-Za-z_][A-Za-z0-9_]*$' ]] ||
        die 'invalid variable name'
      case $OSTYPE in
        linux*)
          local secret_tool
          secret_tool=$(resolve_trusted_command secret-tool /usr/bin/secret-tool)
          exec "$secret_tool" lookup \
            application secret-exec profile "$profile" name "$name"
          ;;
        *)
          die 'Secret Service lookup is supported only on Linux'
          ;;
      esac
      ;;
    *)
      die 'usage: secret-exec-native-store proton-bootstrap | lookup <profile> <name>'
      ;;
  esac
}

main "$@"
