#!/usr/bin/env zsh
set -euo pipefail

install_root="{{ joinPath .chezmoi.homeDir .hindsight.installRoot }}"
config="{{ joinPath .chezmoi.homeDir .hindsight.installationPath }}"

if (( $# == 0 )); then
  exec "$install_root/bin/hindsight-memory" service --help
fi

exec "$install_root/bin/hindsight-memory" service "$@" --config "$config"
