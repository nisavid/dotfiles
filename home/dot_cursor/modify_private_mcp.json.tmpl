#!/usr/bin/env bash
# chezmoi modify_ script for ~/.cursor/mcp.json.
#
# Cursor owns this file and holds servers the dotfiles do not own. This script
# sets only the context7 entry to the same process-scoped launcher the Claude
# Code and Codex bindings use, drops every transport and credential key from
# that entry (including the stdio `type`, as the Claude Code modifier does),
# and passes every other entry and setting through unchanged. An
# absent or empty file gains only the managed entry. A file that is not one
# JSON document fails the apply with no output.
set -euo pipefail

command={{ joinPath .chezmoi.homeDir ".local/bin/secret-exec" | quote }}

jq --null-input --join-output --arg command "$command" '
  def local_server($existing; $args):
    (($existing // {}) + {command: $command, args: $args}) |
    del(.type, .url, .auth, .env, .envFile, .env_vars, .headers, .http_headers, .bearer_token_env_var);

  ([inputs] |
    if length == 0 then {}
    elif length == 1 then .[0]
    else error("Cursor MCP config must hold one JSON document") end) |
  .mcpServers = (.mcpServers // {}) |
  .mcpServers.context7 = local_server(.mcpServers.context7;
    ["context7", "--", "npx", "-y", "@upstash/context7-mcp@3.2.4"])
' < /dev/stdin
