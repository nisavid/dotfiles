# Codex exec-policy rules for firecrawl-axi, deployed from the dotfiles
# (dotfiles#499; see docs/SECRET_INJECTION.md). Nine web-only subcommands run
# outside the sandbox, so the secret-exec launcher can resolve the Firecrawl key
# and hand it to that one process. The owner approved the rule on 2026-11-20.
# parse is left out (it can run curl with server-chosen arguments) and stays
# sandboxed and keyless; setup asks, because it writes harness settings.
# The host_executable lines at the end keep the rules to the bare program names:
# a program of that name given by a path stays under the sandbox.

WEB_SUBCOMMANDS = ["search", "scrape", "map", "crawl", "dev-search", "github-search", "papers", "agent", "monitors"]

prefix_rule(
    pattern = ["firecrawl-axi", WEB_SUBCOMMANDS],
    decision = "allow",
    justification = "firecrawl-axi web-only subcommands need the Firecrawl key from secret-exec, which cannot resolve inside the sandbox (dotfiles#499)",
    match = [["firecrawl-axi", "search", "example"], ["firecrawl-axi", "map", "https://example.com"]],
    not_match = [["firecrawl-axi", "parse", "file.pdf"], ["firecrawl-axi", "setup", "hooks"]],
)

prefix_rule(
    pattern = ["secret-exec", "firecrawl", "--", "firecrawl-axi", WEB_SUBCOMMANDS],
    decision = "allow",
    justification = "explicit secret-exec form of the firecrawl-axi web-only subcommands; it carries the Firecrawl key on its own (dotfiles#499)",
    match = [["secret-exec", "firecrawl", "--", "firecrawl-axi", "scrape", "https://example.com"]],
    not_match = [["secret-exec", "firecrawl", "--", "sh"], ["secret-exec", "github", "--", "firecrawl-axi", "search", "x"]],
)

prefix_rule(
    pattern = ["firecrawl-axi", "setup"],
    decision = "prompt",
    justification = "firecrawl-axi setup writes hooks into harness settings",
    match = [["firecrawl-axi", "setup", "hooks"]],
    not_match = [["firecrawl-axi", "search", "example"]],
)

prefix_rule(
    pattern = ["secret-exec", "firecrawl", "--", "firecrawl-axi", "setup"],
    decision = "prompt",
    justification = "firecrawl-axi setup writes hooks into harness settings",
    match = [["secret-exec", "firecrawl", "--", "firecrawl-axi", "setup", "hooks"]],
    not_match = [["secret-exec", "firecrawl", "--", "firecrawl-axi", "search", "example"]],
)

host_executable(name = "firecrawl-axi", paths = [])
host_executable(name = "secret-exec", paths = [])
