#!/usr/bin/env bash
# chezmoi modify_ script for ~/.codex/config.toml.
#
# Codex owns this file and rewrites it continuously (per-session project trusts,
# [hooks.state] hashes, marketplace timestamps, app-version paths, etc.). Rather than
# manage the whole file, this script overlays only a minimal, curated set of settings
# onto Codex's live file and passes everything else through untouched, except
# that an mcp_servers table split around other tables, or written inline, is
# rewritten as one plain table: its settings stay the same, but its comments
# and formatting are lost. The overlaid settings and edits:
#   - top-level project_doc_max_bytes             (instruction-size budget)
#   - [tui] theme, [desktop] git-branch-prefix   (portable prefs)
#   - [desktop.open-in-target-preferences] global (parametrized editor target)
#   - process-scoped Firecrawl and GitHub MCP launchers
#   - Context7's remote server, its key printed as a header by a helper that
#     runs under secret-exec (dotfiles#522)
#   - macOS developer-tool writable_roots
#   - private writable roots and project trusts (from an age catalog)
#   - the retired serena MCP entry, removed
#   - [[skills.config]] entries that disable retired workflow skills
#
# Requires Python 3.9+; embedded TOMLKit bytes are verified before import.
# No package manager, network access, or global install is used.
set -euo pipefail

export HOMEDIR={{ .chezmoi.homeDir | quote }}
export PROJECT_DOC_MAX_BYTES={{ .codexInstructions.projectDocMaxBytes | int | quote }}
{{- $bindingData := .gitIdentity }}
{{- if not (get $bindingData "publicFixture") }}
{{- $bindingData = include ".private-git-identities.toml.age" | decrypt | fromToml }}
{{- end }}
{{- $identityName := default $bindingData.selection.default (index $bindingData.selection.byHostname .chezmoi.hostname) }}
{{- $identity := index $bindingData.identities $identityName }}
export EDITOR_TARGET={{ $identity.editorTarget | quote }}
export GIT_BRANCH_PREFIX={{ $identity.branchPrefix | quote }}
{{- if get $bindingData "publicFixture" }}
export WORK_TOML_B64={{ "writable_roots = []\nprojects = []\n" | b64enc | quote }}
{{- else }}
export WORK_TOML_B64={{ include ".private-codex-work.toml.age" | decrypt | b64enc | quote }}
{{- end }}

# python3 reads the script from file descriptor 3 without a path, so no zip-import
# probe moves its offset on older Pythons; the live config arrives on stdin.
# The script exits with status 86 only after it has written the whole config.
# Python given an empty or cut-short script prints nothing and exits 0, so every
# other status fails here, and chezmoi never receives an empty config.
set +e
python3 -I -S -c 'import sys; exec(compile(open(3, "rb").read(), "codex-modifier", "exec"))' 3<<'PYEOF'
import base64
import binascii
import hashlib
import os
import shlex
import sys
import tempfile
from pathlib import Path

# Isolated Python excludes environment overrides, the working directory, and
# site hooks. Verify exact repository-reviewed bytes before exposing private
# inputs to third-party code. Never fall back to another package source.
# Encode the included file at render time, so even substituted source/string
# delimiters remain data rather than becoming Python or shell statements.
wheel_text = base64.b64decode("{{ include ".chezmoitemplates/vendor/tomlkit-0.15.2.whl.b64" | b64enc }}")
try:
    wheel = base64.b64decode(b"".join(wheel_text.split()), validate=True)
except (binascii.Error, ValueError):
    raise SystemExit("Codex modifier: bundled TOMLKit integrity check failed")
if hashlib.sha256(wheel).hexdigest() != "05562412163a3037b94497385fb7f9204c637bc605af7a48199e41cf2272f437":
    raise SystemExit("Codex modifier: bundled TOMLKit integrity check failed")
# Keep this private directory alive until interpreter shutdown; its finalizer
# removes the archive, which contains only public dependency bytes.
vendor_directory = tempfile.TemporaryDirectory(prefix="codex-tomlkit-")
wheel_path = Path(vendor_directory.name) / "tomlkit.whl"
wheel_path.write_bytes(wheel)
sys.path.insert(0, str(wheel_path))
import tomlkit

home = os.environ["HOMEDIR"]
editor = os.environ["EDITOR_TARGET"]
work = tomlkit.parse(base64.b64decode(os.environ["WORK_TOML_B64"]).decode())

raw = sys.stdin.read()
doc = tomlkit.parse(raw) if raw.strip() else tomlkit.document()

def ensure_table(parent, key):
    if key not in parent:
        parent[key] = tomlkit.table()
    return parent[key]

# A top-level key: tomlkit places it ahead of the tables, so it never lands inside
# the last one.
doc["project_doc_max_bytes"] = int(os.environ["PROJECT_DOC_MAX_BYTES"])
ensure_table(doc, "tui")["theme"] = "catppuccin-mocha"
desk = ensure_table(doc, "desktop")
desk["git-branch-prefix"] = os.environ["GIT_BRANCH_PREFIX"]
ensure_table(desk, "open-in-target-preferences")["global"] = editor

def rebuilt_table(parent, key):
    # Rebuild parent[key] as one plain table from its values and remove the old
    # parts. A table split over several headers, or written with dotted keys,
    # cannot have its fields deleted reliably; the rebuilt copy can.
    existing = parent[key] if key in parent else None
    table = tomlkit.table()
    if hasattr(existing, "items"):
        for name, value in existing.unwrap().items():
            table[name] = value
    if key in parent:
        del parent[key]
    return table

# An mcp_servers table split around other tables reads as a proxy, and an
# inline one cannot be edited in place; a split table also changes again on a
# second run. Either is rebuilt whole as one plain table, unmanaged entries
# included.
if "mcp_servers" in doc and not isinstance(doc["mcp_servers"], tomlkit.items.Table):
    doc["mcp_servers"] = rebuilt_table(doc, "mcp_servers")
mcp = ensure_table(doc, "mcp_servers")
if "serena" in mcp:
    del mcp["serena"]

def plain_entry(name):
    # Return the named server entry as a table that can be edited in place. A
    # plain or inline table stays where it is, with its comments, unless the
    # whole mcp_servers table was rebuilt above; any other layout is rebuilt.
    existing = mcp[name] if name in mcp else None
    if isinstance(existing, tomlkit.items.InlineTable) or (
        type(existing) is tomlkit.items.Table and not existing.is_super_table()
    ):
        return existing
    return rebuilt_table(mcp, name)

# Fields that can carry a key, or choose the credential Codex sends, go from
# every managed entry: environment values and names, header values and names,
# a token variable, an OAuth block (it can hold a client secret), a working
# directory (it can hold a .env file that a server loads), a literal
# bearer_token (Codex refuses to load any config that has one), and auth and
# oauth_resource (they choose the credential Codex sends). The Codex evidence
# is in docs/SECRET_INJECTION.md#codex-mcp-entries.
key_fields = (
    "env", "env_vars", "cwd", "headers", "http_headers", "env_http_headers",
    "bearer_token_env_var", "bearer_token", "oauth", "oauth_resource", "auth",
)
# Each managed entry uses one transport, and the fields of the other one go
# too: Codex rejects an entry that mixes them. Codex ignores type, so it goes
# from both.
stdio_fields = ("type", "command", "args", "cwd", "env", "env_vars")
http_fields = (
    "type", "url", "bearer_token_env_var", "http_headers_helper", "http_headers",
    "env_http_headers", "oauth", "oauth_resource", "auth",
)

def drop_fields(entry, fields):
    for key in fields:
        if key in entry:
            del entry[key]

secret_exec = os.path.join(home, ".local", "bin", "secret-exec")
managed_mcp_servers = {
    "firecrawl": [
        "firecrawl", "--", "npx", "-y", "firecrawl-mcp@3.22.3",
    ],
    "github": [
        "github", "--", "npx", "-y", "mcp-remote@0.1.38",
        "https://api.githubcopilot.com/mcp/", "--header",
        "Authorization:Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN}",
    ],
}
for name, args in managed_mcp_servers.items():
    server = plain_entry(name)
    drop_fields(server, key_fields + http_fields)
    server["command"] = secret_exec
    server["args"] = args
    mcp[name] = server

# Context7 uses its remote server. Codex runs the helper command through sh -c
# and sends the JSON object it prints as HTTP headers. secret-exec gives the key
# to that short-lived helper only, so the key is in neither the environment of
# Codex nor this file. Every stdio field and every field that can carry a key
# goes; other settings, such as timeouts and enabled, stay.
context7_helper = os.path.join(home, ".local", "lib", "secret-exec", "context7-http-headers")
context7 = plain_entry("context7")
drop_fields(context7, key_fields + stdio_fields)
context7["url"] = "https://mcp.context7.com/mcp"
context7["http_headers_helper"] = " ".join(
    shlex.quote(part) for part in (secret_exec, "context7", "--", context7_helper)
)
mcp["context7"] = context7

sww = ensure_table(doc, "sandbox_workspace_write")
if "writable_roots" not in sww:
    sww["writable_roots"] = tomlkit.array()
roots = sww["writable_roots"]
have = {str(x) for x in roots}
darwin_writable_roots = [
    ".codex/worktrees",
    ".t3/worktrees",
    ".vite-plus",
    "node_modules/.vite-temp",
    ".config/.wrangler/logs",
    ".config/containers/podman/machine",
    ".config/docker/buildx",
    ".local/share/fnm",
    ".local/share/go/bin",
    ".local/share/go/pkg/sumdb",
    ".local/share/mise",
    ".local/share/uv",
    ".local/share/yarn",
    ".local/share/chezmoi",
    ".local/share/chezmoi.wt",
    ".local/share/containers",
    ".local/share/graphite",
    ".local/share/mastic",
    ".local/share/mlxctl",
    ".local/state",
    ".config/mastic",
    ".config/mlxctl",
    ".config/gcloud",
    ".config/graphite",
    ".config/helm",
    ".pg0/instances",
    ".serena/memories",
    ".kube",
    ".cache",
    ".npm",
    ".yarn",
    "Library/Caches",
    "Library/Logs/mlxctl",
    "Library/Logs/mlxd",
    "Library/pnpm",
] if {{ if eq .chezmoi.os "darwin" }}True{{ else }}False{{ end }} else []
# Linux needs write access to its Codex/worktree metadata, the stable
# chezmoi checkout pair, and the Provingkit deletion queue. The sandbox fails
# every command when a writable root is missing, so chezmoi also manages the
# queue directory.
linux_writable_roots = [
    ".codex/worktrees",
    ".t3/worktrees",
    ".local/share/chezmoi",
    ".local/share/chezmoi.wt",
    ".local/state/provingkit/deletion-queue",
] if {{ if eq .chezmoi.os "linux" }}True{{ else }}False{{ end }} else []
for rel in darwin_writable_roots + linux_writable_roots + work["writable_roots"]:
    p = os.path.join(home, rel)
    if p not in have:
        roots.append(p); have.add(p)

projs = ensure_table(doc, "projects")
for rel in work["projects"]:
    p = os.path.join(home, rel)
    if p not in projs:
        t = tomlkit.table(); t["trust_level"] = "trusted"; projs[p] = t

# Disable retired workflow skills from personal and plugin discovery roots.
# Cache versions change, so resolve installed paths whenever chezmoi applies the
# overlay instead of persisting versioned absolute paths.
skills = ensure_table(doc, "skills")
configured_skills = skills.get("config")
if configured_skills is None:
    configured_skills = tomlkit.aot()
    skills["config"] = configured_skills
retired_skill_names = (
    "yeet",
    "finishing-a-development-branch",
    "executing-plans",
    "subagent-driven-development",
    "writing-plans",
    "test-driven-development",
    "dispatching-parallel-agents",
)
plugin_root = Path(home) / ".codex" / "plugins" / "cache"
personal_skill_root = Path(home) / ".agents" / "skills"

def is_retired_skill_path(raw_path):
    path = Path(raw_path)
    if path.name != "SKILL.md" or path.parent.name not in retired_skill_names:
        return False
    parts = path.parts
    if tuple(parts[-4:-2]) == (".agents", "skills"):
        return True
    for index in range(len(parts) - 2):
        if tuple(parts[index:index + 3]) != (".codex", "plugins", "cache"):
            continue
        return len(parts[index + 3:]) == 6 and parts[-3] == "skills"
    return False

retired_paths = set()
for skill in retired_skill_names:
    personal_path = personal_skill_root / skill / "SKILL.md"
    if personal_path.is_file():
        retired_paths.add(personal_path)
    retired_paths.update(plugin_root.glob(f"*/*/*/skills/{skill}/SKILL.md"))

retired_path_strings = {str(path) for path in retired_paths}
kept_retired_paths = set()
remove_indices = []
for index, entry in enumerate(configured_skills):
    path = str(entry.get("path", ""))
    if not is_retired_skill_path(path):
        continue
    if (
        path in retired_path_strings
        and entry.get("enabled") == False
        and path not in kept_retired_paths
    ):
        kept_retired_paths.add(path)
    else:
        remove_indices.append(index)
for index in reversed(remove_indices):
    del configured_skills[index]

for path in sorted(retired_paths, key=str):
    if str(path) in kept_retired_paths:
        continue
    entry = tomlkit.table()
    entry["path"] = str(path)
    entry["enabled"] = False
    configured_skills.append(entry)

text = tomlkit.dumps(doc)
# tomlkit can render some hand-written layouts, such as dotted mcp_servers keys
# at the top level, so that they read back as different settings. Refuse to
# write such a config rather than hand it to chezmoi.
if tomlkit.parse(text).unwrap() != doc.unwrap():
    raise SystemExit(
        "Codex modifier: the rewritten config reads back differently;"
        " write its mcp_servers entries as plain tables"
    )

def write_config(config_text):
    sys.stdout.write(config_text)
    sys.stdout.flush()
    # The launcher accepts this status, and no other, as success.
    return 86

# One statement writes the config and returns the success status, so a script
# cut short anywhere before its end writes nothing.
raise SystemExit(write_config(text))
PYEOF
python_status=$?
set -e
if [ "$python_status" -ne 86 ]; then
  if [ "$python_status" -eq 0 ]; then
    echo 'Codex modifier: the Python script ended without writing a config' >&2
  fi
  exit 1
fi
