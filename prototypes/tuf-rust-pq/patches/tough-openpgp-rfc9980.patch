+fn verify_openpgp_rfc9980(
+    public: &[u8],
+    msg: &[u8],
+    signature: &[u8],
+) -> openpgp::Result<Fingerprint> {
+    let cert = Cert::from_bytes(public)?;
+    if cert.is_tsk() || cert.clone().to_vec()?.as_slice() != public {
+        return openpgp_rejection("expected one canonical unarmored public certificate");
+    }
+    if cert.primary_key().key().version() != 6
+        || cert.primary_key().key().pk_algo() != PublicKeyAlgorithm::MLDSA65_Ed25519
+    {
+        return openpgp_rejection("expected an RFC 9580 algorithm-30 primary key");
+    }
+
+    let mut packets = PacketPile::from_bytes(signature)?.into_children();
+    let Some(Packet::Signature(parsed_signature)) = packets.next() else {
+        return openpgp_rejection("expected one detached signature packet");
+    };
+    if packets.next().is_some()
+        || Packet::from(parsed_signature.clone()).to_vec()?.as_slice() != signature
+    {
+        return openpgp_rejection("expected one canonical unarmored signature packet");
+    }
+    if parsed_signature.version() != 6
+        || parsed_signature.typ() != SignatureType::Binary
+        || parsed_signature.pk_algo() != PublicKeyAlgorithm::MLDSA65_Ed25519
+        || parsed_signature.hash_algo() != HashAlgorithm::SHA512
+    {
+        return openpgp_rejection("signature parameters do not match the provisional scheme");
+    }
+
+    let mut issuers = parsed_signature.issuer_fingerprints();
+    let Some(issuer @ Fingerprint::V6(_)) = issuers.next() else {
+        return openpgp_rejection("expected one v6 issuer fingerprint");
+    };
+    if issuers.next().is_some() {
+        return openpgp_rejection("expected one v6 issuer fingerprint");
+    }
+    let issuer = issuer.clone();
+
+    let policy = StandardPolicy::new();
+    let signing_keys: Vec<_> = cert
+        .keys()
+        .with_policy(&policy, None)
+        .supported()
+        .alive()
+        .revoked(false)
+        .for_signing()
+        .collect();
+    if signing_keys.len() != 1
+        || signing_keys[0].key().version() != 6
+        || signing_keys[0].key().pk_algo() != PublicKeyAlgorithm::MLDSA65_Ed25519
+        || signing_keys[0].key().fingerprint() != issuer
+    {
+        return openpgp_rejection("issuer is not the certificate's sole composite signing key");
+    }
+
+    let helper = OpenPgpVerificationHelper {
+        cert,
+        issuer: issuer.clone(),
+    };
+    let mut verifier =
+        DetachedVerifierBuilder::from_bytes(signature)?.with_policy(&policy, None, helper)?;
+    verifier.verify_bytes(msg)?;
+    Ok(issuer)
+}
