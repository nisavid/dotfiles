+struct OpenPgpVerificationHelper {
+    cert: Cert,
+    issuer: Fingerprint,
+}
+
+impl VerificationHelper for OpenPgpVerificationHelper {
+    fn get_certs(&mut self, ids: &[KeyHandle]) -> openpgp::Result<Vec<Cert>> {
+        if ids
+            .iter()
+            .any(|id| id.aliases(KeyHandle::from(&self.issuer)))
+        {
+            Ok(vec![self.cert.clone()])
+        } else {
+            Ok(Vec::new())
+        }
+    }
+
+    fn check(&mut self, structure: MessageStructure<'_>) -> openpgp::Result<()> {
+        let mut layers = structure.into_iter();
+        let Some(MessageLayer::SignatureGroup { results }) = layers.next() else {
+            return openpgp_rejection("detached signature group is missing");
+        };
+        if layers.next().is_some() || results.len() != 1 {
+            return openpgp_rejection("expected exactly one detached signature result");
+        }
+
+        match &results[0] {
+            Ok(GoodChecksum { ka, .. }) if ka.key().fingerprint() == self.issuer => Ok(()),
+            _ => openpgp_rejection("composite signature verification failed"),
+        }
+    }
+}
