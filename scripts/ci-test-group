#!/usr/bin/env bash
# Run one named group of the portability test battery from the repository root.
#
# The groups split the portability test battery so CI can run it in parallel.
# GitHub Actions runs every group on macOS and Linux
# (.github/workflows/platform-portability.yml);
# tests/ci-test-group.zsh checks those lists and the shell syntax check.
# Each group expects the workflow's dependencies on PATH: zsh, chezmoi, age tooling
# (AGE_TOOLING_DIRECTORY), python3 with uv/uvx, jq, rg, bat, and flock on macOS.
# age-admission and age-provisioning also need AGE_TOOLING_ARCHIVE and
# AGE_TOOLING_ARCHIVE_SHA256.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: ci-test-group GROUP
       ci-test-group --list

Groups:
  shell-bindings    CI group check, shell syntax, zsh bindings, privacy scan, skills
  proton-pass       Proton Pass startup and session behavior tests
  discover          agent-equipment unittest discovery suite
  python-checks     pyrefly, agent-equipment and remaining unittests, JSON Schema
  age-admission     age admission, recovery, procedure and envelope unittests
  age-provisioning  age admission provisioning unittests
  zsh-deployment    user-session deployment contracts
EOF
}

groups=(
  shell-bindings
  proton-pass
  discover
  python-checks
  age-admission
  age-provisioning
  zsh-deployment
)

# Run a syntax check function on each file, and fail if any file fails.
# bash -n reads only its first operand as the script, and one zcompile call
# stops at the first file that fails, so each file is checked on its own.
check_each() {
  local check=$1 file failed=0
  shift
  for file in "$@"; do
    if ! "$check" "$file"; then
      printf '%s: syntax check failed\n' "$file" >&2
      failed=1
    fi
  done
  return "$failed"
}

bash_syntax() {
  bash -n -- "$1"
}

# zsh -n misjudges valid files: it flips its exit status on each top-level !
# pipeline it skips, so a valid file can exit 1 silently, and zsh 5.9 still
# reads each $(<file) in an assignment or argument, warning when the file is
# missing. zcompile only parses the file, so its status is the parse result.
zsh_syntax() {
  local zwc_dir check_status=0
  zwc_dir="$(mktemp -d)" || return
  zsh -f -c 'zcompile -U -- "$1" "$2"' zsh "$zwc_dir/check.zwc" "$1" ||
    check_status=$?
  rm -rf -- "$zwc_dir"
  return "$check_status"
}

# Check both lists even when the first fails, so one run reports every file.
check_shell_syntax() {
  local failed=0
  check_each bash_syntax \
    home/run_after_restore-acl.sh \
    home/run_before_save-acl.sh \
    scripts/private-skill-transaction \
    scripts/private-skill-transaction.d/*.bash || failed=1
  check_each zsh_syntax \
    home/run_after_sync-global-agent-skills-to-claude.zsh \
    tests/claude-skill-sync.zsh \
    tests/container-runtime-bindings.zsh \
    tests/global-agents-policy.zsh \
    tests/hindsight-agents-bindings.zsh \
    tests/identity-bindings.zsh \
    tests/platform-portability.zsh \
    tests/private-skill-transaction.zsh \
    tests/privacy-scan.zsh \
    tests/proton-pass-session.zsh \
    tests/proton-pass-startup-bindings.zsh \
    tests/proton-pass-startup.zsh \
    tests/secret-command-shims.zsh \
    tests/secret-exec-migrate.zsh \
    tests/secret-exec.zsh \
    tests/secret-injection-bindings.zsh \
    tests/private-skill-transaction.d/*.zsh || failed=1
  return "$failed"
}

group_shell_bindings() {
  zsh -f tests/ci-test-group.zsh
  check_shell_syntax
  zsh -f tests/claude-skill-sync.zsh
  zsh -f tests/platform-portability.zsh
  zsh -f tests/container-runtime-bindings.zsh
  zsh -f tests/privacy-scan.zsh
  python3 scripts/privacy-scan --root . --require-age-manifest
  zsh -f tests/identity-bindings.zsh
  zsh -f tests/secret-exec.zsh
  zsh -f tests/secret-command-shims.zsh
  zsh -f tests/secret-exec-migrate.zsh
  zsh -f tests/secret-injection-bindings.zsh
  zsh -f tests/proton-pass-startup-bindings.zsh
  GLOBAL_AGENTS_POLICY_PUBLIC_ONLY=1 \
    zsh -f tests/global-agents-policy.zsh
  if [[ "$(uname -s)" == Linux ]]; then
    zsh -f tests/hindsight-agents-bindings.zsh
  fi
  zsh -f tests/private-skill-transaction.zsh all
}

group_proton_pass() {
  zsh -f tests/proton-pass-startup.zsh
  zsh -f tests/proton-pass-session.zsh
}

group_discover() {
  python3 -m unittest discover -s tests/agent_equipment -t . -p 'test_*.py'
}

group_python_checks() {
  uvx --from pyrefly==1.2.0 pyrefly check \
    --preset strict \
    --min-severity warn \
    --search-path home/private_dot_local/lib/agent-equipment \
    --progress-bar no \
    --summary=full \
    home/private_dot_local/lib/agent-equipment/agent_equipment \
    home/private_dot_local/bin/executable_agent-equipment
  python3 -m unittest tests/test_chezmoi_source_ownership.py
  python3 -m unittest \
    tests.test_provingkit_export \
    tests.test_provingkit_installations \
    tests.test_provingkit_recovery \
    tests.test_provingkit_deployment
  python3 -m unittest tests.test_codex_quota_safeguard_deployment
  python3 -m unittest tests.test_proton_drive_desktop tests.test_proton_drive_desktop_deployment
  python3 -m unittest tests.test_memory_telemetry
  python3 -m unittest tests/test_agent_equipment_acceptance.py
  python3 -m unittest tests/test_agent_equipment_acceptance_evidence.py
  python3 -m unittest tests/test_agent_equipment_adapter_contract.py
  python3 -m unittest tests/test_agent_equipment_captured_state.py
  python3 -m unittest tests/test_agent_equipment_deployment_contract.py
  python3 -m unittest tests/test_agent_equipment_design.py
  python3 -m unittest tests/test_agent_equipment_json_schema.py
  REQUIRE_AGE_TOOLING=1 \
    python3 -m unittest tests/test_agent_equipment_public_data.py
  python3 -m unittest tests/test_privacy_age_integrity_gate.py
  python3 -m unittest tests/test_buildkite_pipeline_settings.py
  uvx --from check-jsonschema==0.35.0 \
    check-jsonschema --check-metaschema \
    docs/agent-equipment/adapter-contract-v1.schema.json \
    docs/agent-equipment/acceptance-evidence-v1.schema.json \
    docs/agent-equipment/catalog-v1.schema.json \
    docs/agent-equipment/lock-v1.schema.json \
    docs/agent-equipment/captured-state-v1.schema.json \
    docs/agent-equipment/execution-authority-v1.schema.json \
    docs/agent-equipment/plan-action-set-v1.schema.json \
    docs/agent-equipment/provingkit-export.schema.json
  uvx --from check-jsonschema==0.35.0 check-jsonschema \
    --base-uri "file://$PWD/docs/agent-equipment/adapter-contract-v1.schema.json" \
    --schemafile docs/agent-equipment/adapter-contract-v1.schema.json \
    tests/fixtures/agent-equipment/schema/valid-adapter-*.json
  uvx --from check-jsonschema==0.35.0 check-jsonschema \
    --schemafile docs/agent-equipment/catalog-v1.schema.json \
    tests/fixtures/agent-equipment/schema/valid-catalog.json \
    docs/agent-equipment/initial-catalog.proposed.json
  uvx --from check-jsonschema==0.35.0 check-jsonschema \
    --base-uri "file://$PWD/docs/agent-equipment/lock-v1.schema.json" \
    --schemafile docs/agent-equipment/lock-v1.schema.json \
    tests/fixtures/agent-equipment/schema/valid-lock.json \
    docs/agent-equipment/initial-lock.proposed.json
  uvx --from check-jsonschema==0.35.0 check-jsonschema \
    --schemafile docs/agent-equipment/captured-state-v1.schema.json \
    tests/fixtures/agent-equipment/schema/valid-captured-state.json
  uvx --from check-jsonschema==0.35.0 check-jsonschema \
    --schemafile docs/agent-equipment/plan-action-set-v1.schema.json \
    tests/fixtures/agent-equipment/schema/valid-plan-action-set.json
  uvx --from check-jsonschema==0.35.0 check-jsonschema \
    --schemafile docs/agent-equipment/provingkit-export.schema.json \
    tests/fixtures/provingkit-installations/export-example.json
  # The fixture deliberately exercises a native remove inverse.  Until
  # #115 supplies independently validated prepared authority, the
  # capture validator must reject that plan-only path.
  local captured_state_output captured_state_status
  set +e
  captured_state_output="$({
    python3 scripts/agent_equipment_captured_state.py \
      --authoritative-plan-actions \
      tests/fixtures/agent-equipment/schema/valid-plan-action-set.json \
      --expected-candidate-identity \
      candidate:fixture/controller-v1 \
      --expected-implementation-manifest-digest \
      sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa \
      tests/fixtures/agent-equipment/schema/valid-captured-state.json
  } 2>&1)"
  captured_state_status=$?
  set -e
  if [[ "$captured_state_status" -ne 1 ]]; then
    printf 'expected plan-only native inverse validation to exit 1, got %s\n%s\n' \
      "$captured_state_status" "$captured_state_output" >&2
    return 1
  fi
  case "$captured_state_output" in
    *NATIVE_REMOVE_INVERSE_PREPARED_AUTHORITY_REQUIRED*) ;;
    *)
      printf 'expected prepared-authority diagnostic was not emitted\n%s\n' \
        "$captured_state_output" >&2
      return 1
      ;;
  esac
}

group_age_admission() {
  python3 -m unittest tests/test_proton_pass_age_admission.py
  AGE_TOOLING_ARCHIVE="$AGE_TOOLING_ARCHIVE" \
  AGE_TOOLING_ARCHIVE_SHA256="$AGE_TOOLING_ARCHIVE_SHA256" \
  REQUIRE_AGE_TOOLING=1 \
    python3 -B -m unittest -v tests.test_age_admission_provider_fixture
  python3 -B -m unittest -v tests.test_age_admission_recovery_preimage
  python3 -B -m unittest -v tests.test_age_admission_procedure
  REQUIRE_AGE_TOOLING=1 \
    python3 -m unittest tests/test_privacy_age_admission.py
  REQUIRE_AGE_TOOLING=1 \
    python3 -m unittest tests/test_privacy_age_envelopes.py
}

group_age_provisioning() {
  AGE_TOOLING_ARCHIVE="$AGE_TOOLING_ARCHIVE" \
  AGE_TOOLING_ARCHIVE_SHA256="$AGE_TOOLING_ARCHIVE_SHA256" \
  REQUIRE_AGE_TOOLING=1 \
    python3 -B -m unittest -v tests.test_age_admission_provisioning
}

group_zsh_deployment() {
  zsh tests/zsh-gui-path.zsh
  zsh tests/proton-pass-startup-bindings.zsh
}

main() {
  if [[ $# -ne 1 ]]; then
    usage >&2
    return 64
  fi
  case "$1" in
    -h | --help)
      usage
      return 0
      ;;
    --list)
      printf '%s\n' "${groups[@]}"
      return 0
      ;;
  esac
  local group=$1 candidate
  for candidate in "${groups[@]}"; do
    if [[ "$candidate" == "$group" ]]; then
      local script_path repo_root
      script_path="$(realpath -- "${BASH_SOURCE[0]}")"
      repo_root="${script_path%/*/*}"
      cd -- "$repo_root"
      # Groups run as separate CI jobs, so each one sets these up itself.
      # Deployment fixtures assert modes created with these public defaults.
      umask 022
      # A runner's checkout umask can leave this reviewed source group-writable.
      chmod 0755 scripts/provision-age-admission-signer
      "group_${group//-/_}"
      return
    fi
  done
  printf 'ci-test-group: unknown group: %s\n' "$group" >&2
  usage >&2
  return 64
}

# tests/ci-test-group.zsh sources this file to call its functions.
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
