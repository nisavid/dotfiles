#!/usr/bin/env python3
"""Create a signed, exact-head admission receipt without exposing plaintext."""

from __future__ import annotations

import argparse
import importlib.util
import os
import re
import secrets
import shutil
import stat
import subprocess
import sys
import tempfile
import types
from datetime import datetime, timedelta, timezone
from pathlib import Path

sys.dont_write_bytecode = True

REPOSITORY_ROOT = Path(__file__).resolve().parents[1]


class ReceiptRequestError(ValueError):
    """A receipt request failed closed validation before trusted imports."""

CHECK_TIMEOUT_SECONDS = 60
SIGN_TIMEOUT_SECONDS = 15
MAX_SIGNING_KEY_BYTES = 64 * 1024
MAX_SIGNING_TOOL_BYTES = 32 * 1024 * 1024
MAX_GIT_TREE_BYTES = 8 * 1024 * 1024
MAX_GIT_INDEX_BYTES = 8 * 1024 * 1024
MAX_MATERIALIZED_TREE_ENTRIES = 10_000
# Keep the aggregate cap equal to the per-object cap so local materialization
# cannot exceed the hosted verifier's bounded Git-object surface.
MAX_MATERIALIZED_TREE_BYTES = 16 * 1024 * 1024
MAX_WORKTREE_ENTRIES = 10_000
# Keep the aggregate cap equal to the per-object cap for the same reason.
MAX_WORKTREE_BYTES = 16 * 1024 * 1024
MAX_LAUNCHER_BYTES = 256 * 1024
COMMIT_ID = re.compile(r"[0-9a-f]{40}\Z", re.ASCII)


def _within(path: Path, root: Path) -> bool:
    try:
        path.relative_to(root)
    except ValueError:
        return False
    return True


def _validated_checkout_root(raw: Path) -> Path:
    try:
        canonical = raw.resolve(strict=True)
    except OSError as error:
        raise ReceiptRequestError("checkout is unavailable") from error
    if not canonical.is_dir():
        raise ReceiptRequestError("checkout is unavailable")
    return canonical


def _git(
    repository: Path,
    *arguments: str,
    maximum_output_bytes: int | None = None,
    environment_overrides: dict[str, str] | None = None,
) -> bytes:
    environment = os.environ.copy()
    for variable in (
        "GIT_ALTERNATE_OBJECT_DIRECTORIES",
        "GIT_COMMON_DIR",
        "GIT_CONFIG_COUNT",
        "GIT_CONFIG_PARAMETERS",
        "GIT_CONFIG_LOCAL",
        "GIT_CONFIG_SYSTEM",
        "GIT_DIR",
        "GIT_INDEX_FILE",
        "GIT_OBJECT_DIRECTORY",
        "GIT_WORK_TREE",
    ):
        environment.pop(variable, None)
    for variable in tuple(environment):
        if variable.startswith(("GIT_CONFIG_KEY_", "GIT_CONFIG_VALUE_")):
            environment.pop(variable, None)
    environment.update(
        {
            "GIT_CONFIG_GLOBAL": os.devnull,
            "GIT_CONFIG_NOSYSTEM": "1",
            "GIT_NO_LAZY_FETCH": "1",
            "GIT_NO_REPLACE_OBJECTS": "1",
            "GIT_OPTIONAL_LOCKS": "0",
            "GIT_TERMINAL_PROMPT": "0",
            "LC_ALL": "C",
        }
    )
    if environment_overrides:
        environment.update(environment_overrides)
    try:
        result = subprocess.run(
            [
                "git",
                "-c",
                "core.fsmonitor=false",
                "-c",
                f"core.hooksPath={os.devnull}",
                "-C",
                os.fspath(repository),
                *arguments,
            ],
            check=False,
            capture_output=True,
            env=environment,
            timeout=30,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        raise ReceiptRequestError("checkout state inspection failed") from error
    if result.returncode != 0:
        raise ReceiptRequestError("checkout state inspection failed")
    if maximum_output_bytes is not None and len(result.stdout) > maximum_output_bytes:
        raise ReceiptRequestError("checkout state inspection exceeded its size limit")
    return result.stdout


def _validated_checkout(
    raw: Path,
    expected_commit: str,
    *,
    label: str,
) -> Path:
    if COMMIT_ID.fullmatch(expected_commit) is None:
        raise ReceiptRequestError(f"{label} commit is invalid")
    checkout = _validated_checkout_root(raw)
    try:
        actual = _git(checkout, "rev-parse", "--verify", "HEAD").decode("ascii").strip()
    except UnicodeDecodeError as error:
        raise ReceiptRequestError(f"{label} checkout identity is invalid") from error
    if actual != expected_commit:
        raise ReceiptRequestError(f"{label} checkout does not match its commit")
    _validate_checkout_content(checkout, expected_commit, label=label)
    return checkout


def _read_launcher(path: Path) -> bytes:
    no_follow = getattr(os, "O_NOFOLLOW", None)
    if no_follow is None:
        raise ReceiptRequestError("safe launcher validation is unavailable")
    try:
        descriptor = os.open(
            path,
            os.O_RDONLY | no_follow | getattr(os, "O_CLOEXEC", 0),
        )
    except OSError as error:
        raise ReceiptRequestError("trusted receipt command is unavailable") from error
    try:
        chunks: list[bytes] = []
        remaining = MAX_LAUNCHER_BYTES + 1
        while remaining:
            chunk = os.read(descriptor, min(remaining, 64 * 1024))
            if not chunk:
                break
            chunks.append(chunk)
            remaining -= len(chunk)
        data = b"".join(chunks)
    except OSError as error:
        raise ReceiptRequestError("trusted receipt command is unavailable") from error
    finally:
        os.close(descriptor)
    if len(data) > MAX_LAUNCHER_BYTES:
        raise ReceiptRequestError("trusted receipt command is unavailable")
    return data


def _validate_launcher_source(base: Path, commit: str) -> None:
    expected = _git(
        base,
        "show",
        f"{commit}:scripts/create-age-admission-receipt",
        maximum_output_bytes=MAX_LAUNCHER_BYTES,
    )
    if _read_launcher(Path(__file__)) != expected:
        raise ReceiptRequestError("trusted receipt command is unavailable")


def _tree_relative_path(raw: bytes) -> tuple[str, ...]:
    try:
        relative = raw.decode("utf-8")
    except UnicodeDecodeError as error:
        raise ReceiptRequestError("Git tree path is not UTF-8") from error
    segments = tuple(relative.split("/"))
    if (
        not relative
        or relative.startswith("/")
        or "\\" in relative
        or any(segment in {"", ".", ".."} for segment in segments)
    ):
        raise ReceiptRequestError("Git tree path is not canonical")
    return segments


def _tree_records(repository: Path, commit: str) -> dict[bytes, tuple[bytes, bytes, bytes]]:
    """Read a commit tree without asking Git to inspect worktree contents."""

    raw_tree = _git(
        repository,
        "ls-tree",
        "-r",
        "-z",
        "--full-tree",
        commit,
        maximum_output_bytes=MAX_GIT_TREE_BYTES,
    )
    entries: dict[bytes, tuple[bytes, bytes, bytes]] = {}
    for record in raw_tree.split(b"\0"):
        if not record:
            continue
        try:
            metadata, raw_path = record.split(b"\t", 1)
            mode, kind, object_id = metadata.split(b" ", 2)
        except ValueError as error:
            raise ReceiptRequestError("Git tree record is malformed") from error
        if (
            not raw_path
            or raw_path in entries
            or len(object_id) != 40
            or re.fullmatch(rb"[0-9a-f]{40}", object_id) is None
            or kind not in {b"blob", b"commit", b"tree", b"tag"}
        ):
            raise ReceiptRequestError("Git tree record is invalid")
        _tree_relative_path(raw_path)
        if len(entries) >= MAX_MATERIALIZED_TREE_ENTRIES:
            raise ReceiptRequestError("Git tree contains too many entries")
        entries[raw_path] = (mode, kind, object_id)
    return entries


def _index_records(repository: Path) -> dict[bytes, tuple[bytes, bytes]]:
    """Read index metadata directly; ``git status`` is deliberately avoided."""

    raw_index = _git(
        repository,
        "ls-files",
        "--stage",
        "--full-name",
        "-z",
        maximum_output_bytes=MAX_GIT_INDEX_BYTES,
    )
    entries: dict[bytes, tuple[bytes, bytes]] = {}
    for record in raw_index.split(b"\0"):
        if not record:
            continue
        try:
            metadata, raw_path = record.split(b"\t", 1)
            mode, object_id, stage = metadata.split(b" ", 2)
        except ValueError as error:
            raise ReceiptRequestError("Git index record is malformed") from error
        if (
            not raw_path
            or raw_path in entries
            or stage != b"0"
            or len(object_id) != 40
            or re.fullmatch(rb"[0-9a-f]{40}", object_id) is None
        ):
            raise ReceiptRequestError("Git index record is invalid")
        _tree_relative_path(raw_path)
        if len(entries) >= MAX_MATERIALIZED_TREE_ENTRIES:
            raise ReceiptRequestError("Git index contains too many entries")
        entries[raw_path] = (mode, object_id)
    return entries


def _read_worktree_regular(path: Path) -> tuple[bytes, os.stat_result]:
    no_follow = getattr(os, "O_NOFOLLOW", None)
    if no_follow is None:
        raise ReceiptRequestError("safe checkout validation is unavailable")
    try:
        descriptor = os.open(
            path,
            os.O_RDONLY | no_follow | getattr(os, "O_CLOEXEC", 0),
        )
    except OSError as error:
        raise ReceiptRequestError("checkout entry is unavailable") from error
    try:
        info = os.fstat(descriptor)
        if not stat.S_ISREG(info.st_mode):
            raise ReceiptRequestError("checkout entry kind is not supported")
        chunks: list[bytes] = []
        remaining = MAX_WORKTREE_BYTES + 1
        while remaining:
            chunk = os.read(descriptor, min(remaining, 64 * 1024))
            if not chunk:
                break
            chunks.append(chunk)
            remaining -= len(chunk)
        data = b"".join(chunks)
        if len(data) > MAX_WORKTREE_BYTES:
            raise ReceiptRequestError("checkout contains an oversized file")
        return data, info
    except OSError as error:
        raise ReceiptRequestError("checkout entry is unavailable") from error
    finally:
        os.close(descriptor)


def _validate_worktree_shape(
    checkout: Path,
    expected_paths: set[bytes],
    *,
    label: str,
) -> None:
    """Reject untracked entries and symlinked parent directories without Git filters."""

    pending = [checkout]
    seen_entries = 0
    while pending:
        directory = pending.pop()
        try:
            entries = list(os.scandir(directory))
        except OSError as error:
            raise ReceiptRequestError(f"{label} checkout cannot be inspected") from error
        for entry in entries:
            if directory == checkout and entry.name == ".git":
                continue
            seen_entries += 1
            if seen_entries > MAX_WORKTREE_ENTRIES:
                raise ReceiptRequestError(f"{label} checkout contains too many entries")
            try:
                relative_raw = os.fsencode(os.path.relpath(entry.path, checkout))
                _tree_relative_path(relative_raw)
                info = entry.stat(follow_symlinks=False)
            except (OSError, ValueError) as error:
                raise ReceiptRequestError(f"{label} checkout cannot be inspected") from error
            if stat.S_ISDIR(info.st_mode):
                prefix = relative_raw + b"/"
                if not any(path.startswith(prefix) for path in expected_paths):
                    raise ReceiptRequestError(f"{label} checkout must be clean")
                pending.append(Path(entry.path))
            elif relative_raw not in expected_paths:
                raise ReceiptRequestError(f"{label} checkout must be clean")


def _validate_checkout_content(
    checkout: Path,
    commit: str,
    *,
    label: str,
) -> None:
    """Compare raw worktree and index bytes with one exact commit tree.

    This intentionally does not call ``git status``: a repository-local clean
    filter selected by ``.gitattributes`` could execute while Git inspects the
    worktree. The comparison below only reads Git objects, index metadata, and
    files through no-follow descriptors.
    """

    tree = _tree_records(checkout, commit)
    index = _index_records(checkout)
    if set(index) != set(tree) or any(
        index.get(path) != (entry[0], entry[2]) for path, entry in tree.items()
    ):
        raise ReceiptRequestError(f"{label} checkout index does not match its commit")
    _validate_worktree_shape(checkout, set(tree), label=label)

    compared_bytes = 0
    for raw_path, (mode, kind, object_id) in tree.items():
        if kind != b"blob" or mode not in {b"100644", b"100755", b"120000"}:
            raise ReceiptRequestError(f"{label} checkout contains an unsupported entry kind")
        destination = checkout.joinpath(*_tree_relative_path(raw_path))
        try:
            info = destination.lstat()
        except OSError as error:
            raise ReceiptRequestError(f"{label} checkout is missing a tracked entry") from error
        if mode == b"120000":
            if not stat.S_ISLNK(info.st_mode):
                raise ReceiptRequestError(f"{label} checkout entry kind does not match Git")
            try:
                actual = os.fsencode(os.readlink(os.fsencode(destination)))
            except OSError as error:
                raise ReceiptRequestError(f"{label} checkout entry is unavailable") from error
        else:
            if not stat.S_ISREG(info.st_mode):
                raise ReceiptRequestError(f"{label} checkout entry kind does not match Git")
            actual, info = _read_worktree_regular(destination)
            expected_executable = mode == b"100755"
            if bool(info.st_mode & 0o111) != expected_executable:
                raise ReceiptRequestError(f"{label} checkout mode does not match Git")
        expected = _git(
            checkout,
            "cat-file",
            "blob",
            object_id.decode("ascii"),
            maximum_output_bytes=MAX_WORKTREE_BYTES,
        )
        compared_bytes += len(expected)
        if compared_bytes > MAX_WORKTREE_BYTES:
            raise ReceiptRequestError(f"{label} checkout is too large")
        if actual != expected:
            raise ReceiptRequestError(f"{label} checkout bytes do not match its commit")


def _write_materialized_entry(root: Path, raw_path: bytes, mode: bytes, data: bytes) -> None:
    relative = _tree_relative_path(raw_path)
    destination = root.joinpath(*relative)
    destination.parent.mkdir(parents=True, exist_ok=True)
    if mode in {b"100644", b"100755"}:
        no_follow = getattr(os, "O_NOFOLLOW", None)
        if no_follow is None:
            raise ReceiptRequestError("safe tree materialization is unavailable")
        try:
            descriptor = os.open(
                destination,
                os.O_WRONLY
                | os.O_CREAT
                | os.O_EXCL
                | no_follow,
                0o600,
            )
        except OSError as error:
            raise ReceiptRequestError("candidate tree materialization failed") from error
        try:
            remaining = memoryview(data)
            while remaining:
                written = os.write(descriptor, remaining)
                if written <= 0:
                    raise ReceiptRequestError("candidate tree materialization failed")
                remaining = remaining[written:]
            os.fchmod(descriptor, 0o755 if mode == b"100755" else 0o644)
        except OSError as error:
            raise ReceiptRequestError("candidate tree materialization failed") from error
        finally:
            os.close(descriptor)
        return
    if mode == b"120000":
        try:
            target = os.fsdecode(data)
        except UnicodeDecodeError as error:
            raise ReceiptRequestError("Git symlink target is invalid") from error
        if not target or "\x00" in target or Path(target).is_absolute():
            raise ReceiptRequestError("Git symlink target is unsafe")
        try:
            resolved = (destination.parent / target).resolve(strict=False)
            resolved.relative_to(root)
            os.symlink(target, destination)
        except (OSError, ValueError) as error:
            raise ReceiptRequestError("candidate tree materialization failed") from error
        return
    raise ReceiptRequestError("Git tree contains an unsupported entry kind")


def _materialize_commit_tree(repository: Path, commit: str) -> tuple[tempfile.TemporaryDirectory[str], Path]:
    """Materialize raw Git blobs without invoking filters or checkout hooks."""

    temporary = tempfile.TemporaryDirectory(prefix="age-admission-tree.")
    root = Path(temporary.name) / "tree"
    root.mkdir()
    root = root.resolve()
    try:
        materialized_bytes = 0
        for entry_count, (raw_path, (mode, kind, object_id)) in enumerate(
            _tree_records(repository, commit).items(),
            start=1,
        ):
            if kind != b"blob":
                raise ReceiptRequestError("Git tree contains an unsupported entry kind")
            if entry_count > MAX_MATERIALIZED_TREE_ENTRIES:
                raise ReceiptRequestError("candidate tree is too large")
            data = _git(
                repository,
                "cat-file",
                "blob",
                object_id.decode("ascii"),
                maximum_output_bytes=MAX_MATERIALIZED_TREE_BYTES,
            )
            materialized_bytes += len(data)
            if materialized_bytes > MAX_MATERIALIZED_TREE_BYTES:
                raise ReceiptRequestError("candidate tree is too large")
            _write_materialized_entry(root, raw_path, mode, data)
    except (ReceiptRequestError, UnicodeDecodeError):
        temporary.cleanup()
        raise ReceiptRequestError("candidate tree materialization failed")
    return temporary, root


def _load_trusted_modules(root: Path) -> dict[str, types.ModuleType]:
    """Load trusted admission modules only from one materialized Git tree."""

    package_name = f"_trusted_age_admission_{secrets.token_hex(8)}"
    package = types.ModuleType(package_name)
    package.__path__ = [os.fspath(root / "scripts")]  # type: ignore[attr-defined]
    package.__package__ = package_name
    sys.modules[package_name] = package
    modules: dict[str, types.ModuleType] = {}
    try:
        for module_name in (
            "privacy_age_envelopes",
            "privacy_age_admission",
            "privacy_age_integrity_gate",
        ):
            module_path = root / "scripts" / f"{module_name}.py"
            spec = importlib.util.spec_from_file_location(
                f"{package_name}.{module_name}",
                module_path,
            )
            if spec is None or spec.loader is None:
                raise ReceiptRequestError("trusted admission modules are unavailable")
            module = importlib.util.module_from_spec(spec)
            sys.modules[spec.name] = module
            spec.loader.exec_module(module)
            modules[module_name] = module
    except (ImportError, OSError, SyntaxError, ValueError) as error:
        raise ReceiptRequestError("trusted admission modules are unavailable") from error
    return modules


def _open_validated_external_file(
    raw: Path,
    *,
    forbidden_roots: tuple[Path, ...],
    label: str,
    envelope_module: types.ModuleType,
) -> tuple[Path, os.stat_result, int]:
    """Open one stable, mode-0600 regular file outside both checkouts."""

    lexical = Path(os.path.abspath(raw))
    try:
        canonical = lexical.resolve(strict=True)
    except OSError as error:
        raise ReceiptRequestError(f"{label} is unavailable") from error
    if any(_within(lexical, root) or _within(canonical, root) for root in forbidden_roots):
        raise ReceiptRequestError(f"{label} must be outside the checkouts")
    try:
        descriptor, info = envelope_module.open_regular_file_descriptor(lexical)
    except (AttributeError, ValueError, OSError) as error:
        raise ReceiptRequestError(f"{label} is unavailable") from error
    try:
        canonical_info = canonical.stat(follow_symlinks=False)
        if (
            not stat.S_ISREG(canonical_info.st_mode)
            or (info.st_dev, info.st_ino) != (canonical_info.st_dev, canonical_info.st_ino)
            or stat.S_IMODE(info.st_mode) != 0o600
        ):
            raise ReceiptRequestError(f"{label} must be a mode-0600 regular file")
    except OSError as error:
        os.close(descriptor)
        raise ReceiptRequestError(f"{label} is unavailable") from error
    except BaseException:
        os.close(descriptor)
        raise
    return canonical, info, descriptor


def _validated_external_file(
    raw: Path,
    *,
    forbidden_roots: tuple[Path, ...],
    label: str,
    envelope_module: types.ModuleType,
) -> tuple[Path, os.stat_result]:
    """Validate one stable, mode-0600 regular file outside both checkouts."""

    canonical, info, descriptor = _open_validated_external_file(
        raw,
        forbidden_roots=forbidden_roots,
        label=label,
        envelope_module=envelope_module,
    )
    os.close(descriptor)
    return canonical, info


def _validated_signing_key(
    raw: Path,
    *,
    forbidden_roots: tuple[Path, ...],
    envelope_module: types.ModuleType,
) -> bytes:
    canonical, info = _validated_external_file(
        raw,
        forbidden_roots=forbidden_roots,
        label="signing key",
        envelope_module=envelope_module,
    )
    try:
        return envelope_module.read_regular_file(
            canonical,
            maximum=MAX_SIGNING_KEY_BYTES,
            expected=info,
        )
    except (AttributeError, ValueError, OSError) as error:
        raise ReceiptRequestError("signing key is unavailable") from error


def _validate_external_identity(
    raw: Path,
    *,
    forbidden_roots: tuple[Path, ...],
    envelope_module: types.ModuleType,
) -> tuple[Path, int]:
    """Hold the validated identity descriptor through the admission child."""
    canonical, _, descriptor = _open_validated_external_file(
        raw,
        forbidden_roots=forbidden_roots,
        label="identity",
        envelope_module=envelope_module,
    )
    try:
        os.set_inheritable(descriptor, True)
    except OSError as error:
        os.close(descriptor)
        raise ReceiptRequestError("identity is unavailable") from error
    return canonical, descriptor


def _validate_external_tooling_directory(
    raw: str | None,
    *,
    forbidden_roots: tuple[Path, ...],
) -> None:
    """Require the selected age-tool directory to be outside both trees."""

    if not raw:
        raise ReceiptRequestError("trusted age tooling provenance is unavailable")
    lexical = Path(raw)
    if not lexical.is_absolute():
        raise ReceiptRequestError("trusted age tooling provenance is unavailable")
    lexical = Path(os.path.abspath(lexical))
    try:
        canonical = lexical.resolve(strict=True)
    except OSError as error:
        raise ReceiptRequestError("trusted age tooling provenance is unavailable") from error
    if (
        not canonical.is_dir()
        or any(_within(lexical, root) or _within(canonical, root) for root in forbidden_roots)
    ):
        raise ReceiptRequestError("trusted age tooling provenance is unavailable")


def _run_local_admission(
    *,
    trusted_tree: Path,
    candidate_tree: Path,
    trusted_admitter: Path,
    identity_descriptor: int,
) -> None:
    try:
        result = subprocess.run(
            [
                sys.executable,
                os.fspath(trusted_admitter),
                "--root",
                os.fspath(candidate_tree),
                "--identity-fd",
                str(identity_descriptor),
                "--check-only",
            ],
            check=False,
            pass_fds=(identity_descriptor,),
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=CHECK_TIMEOUT_SECONDS,
            cwd=trusted_tree,
            env={
                key: value
                for key, value in os.environ.items()
                if key
                not in {
                    "PYTHONHOME",
                    "PYTHONINSPECT",
                    "PYTHONNOUSERSITE",
                    "PYTHONPATH",
                    "PYTHONSTARTUP",
                    "PYTHONUSERBASE",
                    "PYTHONWARNINGS",
                }
            }
            | {
                "GIT_TERMINAL_PROMPT": "0",
                "PYTHONDONTWRITEBYTECODE": "1",
                "PYTHONNOUSERSITE": "1",
            },
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        raise ReceiptRequestError("local ciphertext admission failed") from error
    if result.returncode != 0:
        raise ReceiptRequestError("local ciphertext admission failed")


def _validated_signing_tool(
    *,
    forbidden_roots: tuple[Path, ...],
    envelope_module: types.ModuleType,
) -> tuple[Path, os.stat_result]:
    raw = shutil.which("ssh-keygen")
    if raw is None:
        raise ReceiptRequestError("admission signature tooling is unavailable")
    lexical = Path(os.path.abspath(raw))
    try:
        canonical = lexical.resolve(strict=True)
    except OSError as error:
        raise ReceiptRequestError("admission signature tooling is unavailable") from error
    if any(
        _within(path, root)
        for path in (lexical, canonical)
        for root in forbidden_roots
    ):
        raise ReceiptRequestError("admission signature tooling is unavailable")
    try:
        descriptor, info = envelope_module.open_regular_file_descriptor(lexical)
        canonical_info = canonical.stat(follow_symlinks=False)
    except (AttributeError, ValueError, OSError) as error:
        raise ReceiptRequestError("admission signature tooling is unavailable") from error
    try:
        if (
            not stat.S_ISREG(canonical_info.st_mode)
            or (info.st_dev, info.st_ino) != (canonical_info.st_dev, canonical_info.st_ino)
            or info.st_mode & 0o111 == 0
            or info.st_mode & 0o022 != 0
        ):
            raise ReceiptRequestError("admission signature tooling is unavailable")
    finally:
        os.close(descriptor)
    return canonical, info


def _sign_payload(
    payload: bytes,
    signing_key: bytes,
    *,
    forbidden_roots: tuple[Path, ...],
    envelope_module: types.ModuleType,
    namespace: str,
) -> bytes:
    tool, tool_info = _validated_signing_tool(
        forbidden_roots=forbidden_roots,
        envelope_module=envelope_module,
    )
    try:
        envelope_module.read_regular_file(
            tool,
            maximum=MAX_SIGNING_TOOL_BYTES,
            expected=tool_info,
        )
    except (AttributeError, ValueError, OSError) as error:
        raise ReceiptRequestError("admission signature tooling is unavailable") from error
    try:
        with tempfile.TemporaryDirectory(prefix="age-admission-sign.") as temporary:
            root = Path(temporary)
            key = root / "signing-key"
            message = root / "payload"
            key.write_bytes(signing_key)
            message.write_bytes(payload)
            os.chmod(key, 0o600)
            os.chmod(message, 0o600)
            result = subprocess.run(
                [
                    os.fspath(tool),
                    "-Y",
                    "sign",
                    "-f",
                    os.fspath(key),
                    "-n",
                    namespace,
                    os.fspath(message),
                ],
                check=False,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=SIGN_TIMEOUT_SECONDS,
                env={
                    **os.environ,
                    "DISPLAY": "",
                    "GIT_TERMINAL_PROMPT": "0",
                    "SSH_ASKPASS": os.devnull,
                },
            )
            if result.returncode != 0:
                raise ReceiptRequestError("admission signature generation failed")
            signature_path = message.with_name(f"{message.name}.sig")
            try:
                signature = signature_path.read_bytes()
            except OSError as error:
                raise ReceiptRequestError("admission signature generation failed") from error
    except (OSError, subprocess.TimeoutExpired) as error:
        raise ReceiptRequestError("admission signature generation failed") from error
    if not signature or len(signature) > 8 * 1024:
        raise ReceiptRequestError("admission signature is invalid")
    return signature


def _write_output(path: Path, data: bytes, *, forbidden_roots: tuple[Path, ...]) -> None:
    lexical = Path(os.path.abspath(path))
    if any(_within(lexical, root) for root in forbidden_roots):
        raise ReceiptRequestError("receipt output must be outside the checkouts")
    parent = lexical.parent
    try:
        parent = parent.resolve(strict=True)
    except OSError as error:
        raise ReceiptRequestError("receipt output directory is unavailable") from error
    if (
        not parent.is_dir()
        or any(_within(parent, root) for root in forbidden_roots)
    ):
        raise ReceiptRequestError("receipt output directory is unavailable")
    if lexical.exists() or lexical.is_symlink():
        raise ReceiptRequestError("receipt output already exists")
    temporary: Path | None = None
    descriptor: int | None = None
    try:
        descriptor, name = tempfile.mkstemp(dir=parent, prefix=f".{lexical.name}.")
        temporary = Path(name)
        with os.fdopen(descriptor, "wb") as stream:
            descriptor = None
            os.fchmod(stream.fileno(), 0o600)
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, lexical)
        temporary = None
    except OSError as error:
        raise ReceiptRequestError("receipt output could not be installed") from error
    finally:
        if descriptor is not None:
            os.close(descriptor)
        if temporary is not None:
            try:
                temporary.unlink()
            except OSError:
                pass


def create_receipt(arguments: argparse.Namespace) -> None:
    base = _validated_checkout(
        arguments.base_repository,
        arguments.base_commit,
        label="trusted base",
    )
    head = _validated_checkout(
        arguments.head_repository,
        arguments.head_commit,
        label="candidate",
    )
    if base != REPOSITORY_ROOT or Path(__file__).resolve() != (
        base / "scripts/create-age-admission-receipt"
    ):
        raise ReceiptRequestError(
            "receipt command must run from the exact trusted base checkout"
        )
    _validate_launcher_source(base, arguments.base_commit)
    forbidden_roots = (base, head)
    try:
        admitter = arguments.trusted_admitter.resolve(strict=True)
        expected_admitter = (base / "scripts/admit-age-envelopes").resolve(strict=True)
    except OSError as error:
        raise ReceiptRequestError("trusted admission command is unavailable") from error
    if (
        admitter != expected_admitter
        or not admitter.is_file()
        or _within(admitter, head)
        or not _within(admitter, base)
    ):
        raise ReceiptRequestError("trusted admission command is unavailable")
    _validate_external_tooling_directory(
        os.environ.get("AGE_TOOLING_DIRECTORY"),
        forbidden_roots=forbidden_roots,
    )
    trusted_temporary, trusted_tree = _materialize_commit_tree(
        base,
        arguments.base_commit,
    )
    candidate_temporary: tempfile.TemporaryDirectory[str] | None = None
    try:
        candidate_temporary, candidate_tree = _materialize_commit_tree(
            head,
            arguments.head_commit,
        )
        modules = _load_trusted_modules(trusted_tree)
        envelope_module = modules["privacy_age_envelopes"]
        admission_module = modules["privacy_age_admission"]
        integrity_module = modules["privacy_age_integrity_gate"]
        _, identity_descriptor = _validate_external_identity(
            arguments.identity,
            forbidden_roots=forbidden_roots,
            envelope_module=envelope_module,
        )
        try:
            _run_local_admission(
                trusted_tree=trusted_tree,
                candidate_tree=candidate_tree,
                trusted_admitter=trusted_tree / "scripts/admit-age-envelopes",
                identity_descriptor=identity_descriptor,
            )
        finally:
            os.close(identity_descriptor)
        signing_key = _validated_signing_key(
            arguments.signing_key,
            forbidden_roots=forbidden_roots,
            envelope_module=envelope_module,
        )

        issued = datetime.now(timezone.utc).replace(microsecond=0)
        requested_lifetime = (
            timedelta(seconds=arguments.lifetime_seconds)
            if arguments.lifetime_seconds is not None
            else admission_module.ADMISSION_MAX_LIFETIME
        )
        lifetime = min(requested_lifetime, admission_module.ADMISSION_MAX_LIFETIME)
        if lifetime <= timedelta(0):
            raise ReceiptRequestError("admission lifetime is invalid")
        payload = integrity_module.build_admission_payload(
            base_repository=base,
            base_commit=arguments.base_commit,
            head_repository=head,
            head_commit=arguments.head_commit,
            repository=arguments.repository,
            issued_at=issued.strftime("%Y-%m-%dT%H:%M:%SZ"),
            expires_at=(issued + lifetime).strftime("%Y-%m-%dT%H:%M:%SZ"),
            nonce=secrets.token_hex(16),
        )
        payload_bytes = admission_module.canonical_payload_bytes(payload)
        signature = _sign_payload(
            payload_bytes,
            signing_key,
            forbidden_roots=forbidden_roots,
            envelope_module=envelope_module,
            namespace=admission_module.ADMISSION_NAMESPACE,
        )
        _write_output(
            arguments.output,
            admission_module.encode_receipt(payload, signature) + b"\n",
            forbidden_roots=forbidden_roots,
        )
    except (KeyError, AttributeError, TypeError) as error:
        raise ReceiptRequestError("trusted admission modules are unavailable") from error
    finally:
        if candidate_temporary is not None:
            candidate_temporary.cleanup()
        trusted_temporary.cleanup()


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--base-repository", type=Path, required=True)
    parser.add_argument("--base-commit", required=True)
    parser.add_argument("--head-repository", type=Path, required=True)
    parser.add_argument("--head-commit", required=True)
    parser.add_argument("--repository", required=True)
    parser.add_argument("--identity", type=Path, required=True)
    parser.add_argument("--signing-key", type=Path, required=True)
    parser.add_argument("--trusted-admitter", type=Path, required=True)
    parser.add_argument("--output", type=Path, required=True)
    parser.add_argument(
        "--lifetime-seconds",
        type=int,
    )
    arguments = parser.parse_args()
    try:
        create_receipt(arguments)
    except (ReceiptRequestError, ValueError, RuntimeError, OSError, OverflowError):
        print("age-transition admission failed", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
