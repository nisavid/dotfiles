#!/usr/bin/env python3
"""Create a signed, exact-head admission receipt without exposing plaintext."""

from __future__ import annotations

import argparse
import os
import re
import secrets
import shutil
import stat
import subprocess
import sys
import tempfile
from datetime import datetime, timedelta, timezone
from pathlib import Path

sys.dont_write_bytecode = True

REPOSITORY_ROOT = Path(__file__).resolve().parents[1]


class AdmissionReceiptError(ValueError):
    """A receipt request failed closed validation before trusted imports."""

CHECK_TIMEOUT_SECONDS = 60
SIGN_TIMEOUT_SECONDS = 15
MAX_SIGNING_KEY_BYTES = 64 * 1024
MAX_SIGNING_TOOL_BYTES = 32 * 1024 * 1024
MAX_GIT_STATUS_BYTES = 1024 * 1024
COMMIT_ID = re.compile(r"[0-9a-f]{40}\Z", re.ASCII)


def _within(path: Path, root: Path) -> bool:
    try:
        path.relative_to(root)
    except ValueError:
        return False
    return True


def _validated_checkout_root(raw: Path) -> Path:
    try:
        canonical = raw.resolve(strict=True)
    except OSError as error:
        raise AdmissionReceiptError("checkout is unavailable") from error
    if not canonical.is_dir():
        raise AdmissionReceiptError("checkout is unavailable")
    return canonical


def _git(
    repository: Path,
    *arguments: str,
    maximum_output_bytes: int | None = None,
    environment_overrides: dict[str, str] | None = None,
) -> bytes:
    environment = os.environ.copy()
    for variable in (
        "GIT_ALTERNATE_OBJECT_DIRECTORIES",
        "GIT_COMMON_DIR",
        "GIT_CONFIG_COUNT",
        "GIT_CONFIG_PARAMETERS",
        "GIT_DIR",
        "GIT_INDEX_FILE",
        "GIT_OBJECT_DIRECTORY",
        "GIT_WORK_TREE",
    ):
        environment.pop(variable, None)
    for variable in tuple(environment):
        if variable.startswith(("GIT_CONFIG_KEY_", "GIT_CONFIG_VALUE_")):
            environment.pop(variable, None)
    environment.update(
        {
            "GIT_CONFIG_GLOBAL": os.devnull,
            "GIT_CONFIG_NOSYSTEM": "1",
            "GIT_NO_LAZY_FETCH": "1",
            "GIT_NO_REPLACE_OBJECTS": "1",
            "GIT_OPTIONAL_LOCKS": "0",
            "GIT_TERMINAL_PROMPT": "0",
            "LC_ALL": "C",
        }
    )
    if environment_overrides:
        environment.update(environment_overrides)
    try:
        result = subprocess.run(
            [
                "git",
                "-c",
                "core.fsmonitor=false",
                "-c",
                f"core.hooksPath={os.devnull}",
                "-C",
                os.fspath(repository),
                *arguments,
            ],
            check=False,
            capture_output=True,
            env=environment,
            timeout=30,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        raise AdmissionReceiptError("checkout state inspection failed") from error
    if result.returncode != 0:
        raise AdmissionReceiptError("checkout state inspection failed")
    if maximum_output_bytes is not None and len(result.stdout) > maximum_output_bytes:
        raise AdmissionReceiptError("checkout state inspection exceeded its size limit")
    return result.stdout


def _validated_checkout(
    raw: Path,
    expected_commit: str,
    *,
    label: str,
) -> Path:
    if COMMIT_ID.fullmatch(expected_commit) is None:
        raise AdmissionReceiptError(f"{label} commit is invalid")
    checkout = _validated_checkout_root(raw)
    try:
        actual = _git(checkout, "rev-parse", "--verify", "HEAD").decode("ascii").strip()
        status = _git(
            checkout,
            "status",
            "--porcelain=v1",
            "--untracked-files=all",
            "--ignored=matching",
            "--ignore-submodules=none",
            maximum_output_bytes=MAX_GIT_STATUS_BYTES,
        )
    except UnicodeDecodeError as error:
        raise AdmissionReceiptError(f"{label} checkout identity is invalid") from error
    if actual != expected_commit:
        raise AdmissionReceiptError(f"{label} checkout does not match its commit")
    if status:
        raise AdmissionReceiptError(f"{label} checkout must be clean")
    return checkout


def _materialize_commit_tree(repository: Path, commit: str) -> tuple[tempfile.TemporaryDirectory[str], Path]:
    """Materialize Git's exact tree bytes for local validation."""

    temporary = tempfile.TemporaryDirectory(prefix="age-admission-head.")
    root = Path(temporary.name) / "tree"
    root.mkdir()
    index = Path(temporary.name) / "index"
    overrides = {"GIT_INDEX_FILE": os.fspath(index)}
    try:
        _git(
            repository,
            "read-tree",
            "--reset",
            commit,
            environment_overrides=overrides,
        )
        _git(
            repository,
            "checkout-index",
            "--all",
            "--ignore-skip-worktree-bits",
            "--prefix",
            f"{root}/",
            environment_overrides=overrides,
        )
    except AdmissionReceiptError:
        temporary.cleanup()
        raise AdmissionReceiptError("candidate tree materialization failed")
    return temporary, root


def _validated_external_file(
    raw: Path,
    *,
    forbidden_roots: tuple[Path, ...],
    label: str,
) -> tuple[Path, os.stat_result]:
    """Validate one stable, mode-0600 regular file outside both checkouts."""

    try:
        from scripts.privacy_age_envelopes import (
            AgeEnvelopeError,
            open_regular_file_descriptor,
        )
    except ImportError as error:
        raise AdmissionReceiptError("trusted admission modules are unavailable") from error

    lexical = Path(os.path.abspath(raw))
    try:
        canonical = lexical.resolve(strict=True)
    except OSError as error:
        raise AdmissionReceiptError(f"{label} is unavailable") from error
    if any(_within(lexical, root) or _within(canonical, root) for root in forbidden_roots):
        raise AdmissionReceiptError(f"{label} must be outside the checkouts")
    try:
        descriptor, info = open_regular_file_descriptor(lexical)
    except AgeEnvelopeError as error:
        raise AdmissionReceiptError(f"{label} is unavailable") from error
    try:
        canonical_info = canonical.stat(follow_symlinks=False)
        if (
            not stat.S_ISREG(canonical_info.st_mode)
            or (info.st_dev, info.st_ino) != (canonical_info.st_dev, canonical_info.st_ino)
            or stat.S_IMODE(info.st_mode) != 0o600
        ):
            raise AdmissionReceiptError(f"{label} must be a mode-0600 regular file")
    except OSError as error:
        raise AdmissionReceiptError(f"{label} is unavailable") from error
    finally:
        os.close(descriptor)
    return canonical, info


def _validated_signing_key(raw: Path, *, forbidden_roots: tuple[Path, ...]) -> bytes:
    try:
        from scripts.privacy_age_envelopes import (
            AgeEnvelopeError,
            read_regular_file,
        )
    except ImportError as error:
        raise AdmissionReceiptError("trusted admission modules are unavailable") from error

    canonical, info = _validated_external_file(
        raw,
        forbidden_roots=forbidden_roots,
        label="signing key",
    )
    try:
        return read_regular_file(
            canonical,
            maximum=MAX_SIGNING_KEY_BYTES,
            expected=info,
        )
    except (AgeEnvelopeError, OSError) as error:
        raise AdmissionReceiptError("signing key is unavailable") from error


def _validate_external_identity(
    raw: Path,
    *,
    forbidden_roots: tuple[Path, ...],
) -> Path:
    """Require the age identity to be a stable mode-0600 file outside both trees."""
    canonical, _ = _validated_external_file(
        raw,
        forbidden_roots=forbidden_roots,
        label="identity",
    )
    return canonical


def _validate_external_tooling_directory(
    raw: str | None,
    *,
    forbidden_roots: tuple[Path, ...],
) -> None:
    """Require the selected age-tool directory to be outside both trees."""

    if not raw:
        raise AdmissionReceiptError("trusted age tooling provenance is unavailable")
    lexical = Path(raw)
    if not lexical.is_absolute():
        raise AdmissionReceiptError("trusted age tooling provenance is unavailable")
    lexical = Path(os.path.abspath(lexical))
    try:
        canonical = lexical.resolve(strict=True)
    except OSError as error:
        raise AdmissionReceiptError("trusted age tooling provenance is unavailable") from error
    if (
        not canonical.is_dir()
        or any(_within(lexical, root) or _within(canonical, root) for root in forbidden_roots)
    ):
        raise AdmissionReceiptError("trusted age tooling provenance is unavailable")


def _run_local_admission(
    *,
    base: Path,
    base_commit: str,
    head: Path,
    head_commit: str,
    identity: Path,
) -> None:
    trusted_temporary: tempfile.TemporaryDirectory[str] | None = None
    candidate_temporary: tempfile.TemporaryDirectory[str] | None = None
    try:
        trusted_temporary, materialized_base = _materialize_commit_tree(base, base_commit)
        candidate_temporary, materialized_head = _materialize_commit_tree(head, head_commit)
        result = subprocess.run(
            [
                sys.executable,
                os.fspath(materialized_base / "scripts/admit-age-envelopes"),
                "--root",
                os.fspath(materialized_head),
                "--identity",
                os.fspath(identity),
                "--check-only",
            ],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=CHECK_TIMEOUT_SECONDS,
            cwd=materialized_base,
            env={
                key: value
                for key, value in os.environ.items()
                if key
                not in {
                    "PYTHONHOME",
                    "PYTHONINSPECT",
                    "PYTHONNOUSERSITE",
                    "PYTHONPATH",
                    "PYTHONSTARTUP",
                    "PYTHONUSERBASE",
                    "PYTHONWARNINGS",
                }
            }
            | {
                "GIT_TERMINAL_PROMPT": "0",
                "PYTHONDONTWRITEBYTECODE": "1",
                "PYTHONNOUSERSITE": "1",
            },
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        raise AdmissionReceiptError("local ciphertext admission failed") from error
    finally:
        if candidate_temporary is not None:
            candidate_temporary.cleanup()
        if trusted_temporary is not None:
            trusted_temporary.cleanup()
    if result.returncode != 0:
        raise AdmissionReceiptError("local ciphertext admission failed")


def _validated_signing_tool(
    *,
    forbidden_roots: tuple[Path, ...],
) -> tuple[Path, os.stat_result]:
    try:
        from scripts.privacy_age_envelopes import (
            AgeEnvelopeError,
            open_regular_file_descriptor,
        )
    except ImportError as error:
        raise AdmissionReceiptError("trusted admission modules are unavailable") from error

    raw = shutil.which("ssh-keygen")
    if raw is None:
        raise AdmissionReceiptError("admission signature tooling is unavailable")
    lexical = Path(os.path.abspath(raw))
    try:
        canonical = lexical.resolve(strict=True)
    except OSError as error:
        raise AdmissionReceiptError("admission signature tooling is unavailable") from error
    if any(
        _within(path, root)
        for path in (lexical, canonical)
        for root in forbidden_roots
    ):
        raise AdmissionReceiptError("admission signature tooling is unavailable")
    try:
        descriptor, info = open_regular_file_descriptor(lexical)
        canonical_info = canonical.stat(follow_symlinks=False)
    except (AgeEnvelopeError, OSError) as error:
        raise AdmissionReceiptError("admission signature tooling is unavailable") from error
    try:
        if (
            not stat.S_ISREG(canonical_info.st_mode)
            or (info.st_dev, info.st_ino) != (canonical_info.st_dev, canonical_info.st_ino)
            or info.st_mode & 0o111 == 0
            or info.st_mode & 0o022 != 0
        ):
            raise AdmissionReceiptError("admission signature tooling is unavailable")
    finally:
        os.close(descriptor)
    return canonical, info


def _sign_payload(
    payload: bytes,
    signing_key: bytes,
    *,
    forbidden_roots: tuple[Path, ...],
) -> bytes:
    try:
        from scripts.privacy_age_envelopes import AgeEnvelopeError, read_regular_file
    except ImportError as error:
        raise AdmissionReceiptError("trusted admission modules are unavailable") from error
    tool, tool_info = _validated_signing_tool(forbidden_roots=forbidden_roots)
    try:
        read_regular_file(
            tool,
            maximum=MAX_SIGNING_TOOL_BYTES,
            expected=tool_info,
        )
    except (AgeEnvelopeError, OSError) as error:
        raise AdmissionReceiptError("admission signature tooling is unavailable") from error
    try:
        with tempfile.TemporaryDirectory(prefix="age-admission-sign.") as temporary:
            root = Path(temporary)
            key = root / "signing-key"
            message = root / "payload"
            key.write_bytes(signing_key)
            message.write_bytes(payload)
            os.chmod(key, 0o600)
            os.chmod(message, 0o600)
            result = subprocess.run(
                [
                    os.fspath(tool),
                    "-Y",
                    "sign",
                    "-f",
                    os.fspath(key),
                    "-n",
                    "nisavid/dotfiles/age-admission/v1",
                    os.fspath(message),
                ],
                check=False,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=SIGN_TIMEOUT_SECONDS,
                env={
                    **os.environ,
                    "DISPLAY": "",
                    "GIT_TERMINAL_PROMPT": "0",
                    "SSH_ASKPASS": os.devnull,
                },
            )
            if result.returncode != 0:
                raise AdmissionReceiptError("admission signature generation failed")
            signature_path = message.with_name(f"{message.name}.sig")
            try:
                signature = signature_path.read_bytes()
            except OSError as error:
                raise AdmissionReceiptError("admission signature generation failed") from error
    except (OSError, subprocess.TimeoutExpired) as error:
        raise AdmissionReceiptError("admission signature generation failed") from error
    if not signature or len(signature) > 8 * 1024:
        raise AdmissionReceiptError("admission signature is invalid")
    return signature


def _write_output(path: Path, data: bytes, *, forbidden_roots: tuple[Path, ...]) -> None:
    lexical = Path(os.path.abspath(path))
    if any(_within(lexical, root) for root in forbidden_roots):
        raise AdmissionReceiptError("receipt output must be outside the checkouts")
    parent = lexical.parent
    try:
        parent = parent.resolve(strict=True)
    except OSError as error:
        raise AdmissionReceiptError("receipt output directory is unavailable") from error
    if (
        not parent.is_dir()
        or any(_within(parent, root) for root in forbidden_roots)
    ):
        raise AdmissionReceiptError("receipt output directory is unavailable")
    if lexical.exists() or lexical.is_symlink():
        raise AdmissionReceiptError("receipt output already exists")
    temporary: Path | None = None
    descriptor: int | None = None
    try:
        descriptor, name = tempfile.mkstemp(dir=parent, prefix=f".{lexical.name}.")
        temporary = Path(name)
        with os.fdopen(descriptor, "wb") as stream:
            descriptor = None
            os.fchmod(stream.fileno(), 0o600)
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, lexical)
        temporary = None
    except OSError as error:
        raise AdmissionReceiptError("receipt output could not be installed") from error
    finally:
        if descriptor is not None:
            os.close(descriptor)
        if temporary is not None:
            try:
                temporary.unlink()
            except OSError:
                pass


def create_receipt(arguments: argparse.Namespace) -> None:
    base = _validated_checkout(
        arguments.base_repository,
        arguments.base_commit,
        label="trusted base",
    )
    head = _validated_checkout(
        arguments.head_repository,
        arguments.head_commit,
        label="candidate",
    )
    if base != REPOSITORY_ROOT or Path(__file__).resolve() != (
        base / "scripts/create-age-admission-receipt"
    ):
        raise AdmissionReceiptError(
            "receipt command must run from the exact trusted base checkout"
        )
    if os.fspath(base) not in sys.path:
        sys.path.insert(0, os.fspath(base))
    forbidden_roots = (base, head)
    try:
        admitter = arguments.trusted_admitter.resolve(strict=True)
        expected_admitter = (base / "scripts/admit-age-envelopes").resolve(strict=True)
    except OSError as error:
        raise AdmissionReceiptError("trusted admission command is unavailable") from error
    if (
        admitter != expected_admitter
        or not admitter.is_file()
        or _within(admitter, head)
        or not _within(admitter, base)
    ):
        raise AdmissionReceiptError("trusted admission command is unavailable")
    identity = _validate_external_identity(
        arguments.identity,
        forbidden_roots=forbidden_roots,
    )
    _validate_external_tooling_directory(
        os.environ.get("AGE_TOOLING_DIRECTORY"),
        forbidden_roots=forbidden_roots,
    )
    signing_key = _validated_signing_key(
        arguments.signing_key,
        forbidden_roots=forbidden_roots,
    )
    try:
        from scripts.privacy_age_admission import (
            ADMISSION_MAX_LIFETIME,
            canonical_payload_bytes,
            encode_receipt,
        )
        from scripts.privacy_age_integrity_gate import build_admission_payload
    except ImportError as error:
        raise AdmissionReceiptError("trusted admission modules are unavailable") from error
    _run_local_admission(
        base=base,
        base_commit=arguments.base_commit,
        head=head,
        head_commit=arguments.head_commit,
        identity=identity,
    )

    issued = datetime.now(timezone.utc).replace(microsecond=0)
    requested_lifetime = (
        timedelta(seconds=arguments.lifetime_seconds)
        if arguments.lifetime_seconds is not None
        else ADMISSION_MAX_LIFETIME
    )
    lifetime = min(requested_lifetime, ADMISSION_MAX_LIFETIME)
    if lifetime <= timedelta(0):
        raise AdmissionReceiptError("admission lifetime is invalid")
    payload = build_admission_payload(
        base_repository=base,
        base_commit=arguments.base_commit,
        head_repository=head,
        head_commit=arguments.head_commit,
        repository=arguments.repository,
        issued_at=issued.strftime("%Y-%m-%dT%H:%M:%SZ"),
        expires_at=(issued + lifetime).strftime("%Y-%m-%dT%H:%M:%SZ"),
        nonce=secrets.token_hex(16),
    )
    payload_bytes = canonical_payload_bytes(payload)
    signature = _sign_payload(
        payload_bytes,
        signing_key,
        forbidden_roots=forbidden_roots,
    )
    _write_output(
        arguments.output,
        encode_receipt(payload, signature) + b"\n",
        forbidden_roots=forbidden_roots,
    )


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--base-repository", type=Path, required=True)
    parser.add_argument("--base-commit", required=True)
    parser.add_argument("--head-repository", type=Path, required=True)
    parser.add_argument("--head-commit", required=True)
    parser.add_argument("--repository", required=True)
    parser.add_argument("--identity", type=Path, required=True)
    parser.add_argument("--signing-key", type=Path, required=True)
    parser.add_argument("--trusted-admitter", type=Path, required=True)
    parser.add_argument("--output", type=Path, required=True)
    parser.add_argument(
        "--lifetime-seconds",
        type=int,
    )
    arguments = parser.parse_args()
    try:
        create_receipt(arguments)
    except (AdmissionReceiptError, ValueError, RuntimeError, OSError, OverflowError):
        print("age-transition admission failed", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
