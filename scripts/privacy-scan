#!/usr/bin/env python3
"""Scan a source tree without echoing matched sensitive values."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import shutil
import stat
import subprocess
import sys
from collections import deque
from collections.abc import Iterable
from pathlib import Path

sys.dont_write_bytecode = True

import tomllib
from agent_equipment_public_data import (
    contains_literal_credential,
    serialized_syntax,
    string_looks_like_credential,
    string_looks_like_private_key,
)
from privacy_age_envelopes import (
    AGE_MANIFEST_NAME,
    AGE_VERSION,
    MAX_AGE_ENVELOPE_BYTES,
    AgeEnvelopeError,
    age_inspection_has_exact_postquantum_stanzas,
    discover_age_files,
    load_manifest,
    read_regular_file,
)

ALLOWED_EMAILS = {"ivan@nisavid.io"}
ALLOWED_EMAIL_DOMAINS = {"example.com", "example.invalid"}
ALLOWED_HOME_USERS = {"fixture", "runner", "test", "test-user"}
AGE_INVENTORY_SKIPPED_DIRECTORIES = {".git"}
AGE_INSPECT_TIMEOUT_SECONDS = 5
MAX_AGE_INSPECTION_BYTES = 1024 * 1024
EXPECTED_AGE_RECIPIENT_STANZAS = 1
MAX_PUBLIC_FILE_BYTES = 4 * 1024 * 1024
MAX_PUBLIC_SOURCE_ENTRIES = 10_000
MAX_PUBLIC_SOURCE_PATH_BYTES = 8 * 1024 * 1024
MAX_PUBLIC_SOURCE_CONTENT_BYTES = 16 * 1024 * 1024
MAX_PUBLIC_FINDINGS = 10_000
MAX_PUBLIC_FINDING_BYTES = 4 * 1024 * 1024
MAX_DENYLIST_BYTES = 1024 * 1024
MAX_DENYLIST_TERMS = 10_000
RESOURCE_LIMIT_DIAGNOSTIC = "privacy scan failed: scan resource limits exceeded"
AGE_NATIVE_MAGIC = b"age-encryption.org/v1\n"
AGE_ARMORED_MAGIC = b"-----BEGIN AGE ENCRYPTED FILE-----"

EMAIL = re.compile(r"(?i)\b[A-Z0-9._%+-]+@([A-Z0-9.-]+\.[A-Z]{2,})\b")
HOME_PATH = re.compile(
    r"(?<![A-Za-z0-9_.$:-])(?:/Users|/home)/"
    r"([A-Za-z0-9._-]+)(?:/[^\s\"'<>]*)?"
)
RELATIVE_HOME_PATH = re.compile(
    r"(?:^Users|/(?:Users|home))/([A-Za-z0-9._-]+)(?:/[^\s\"'<>]*)?"
)
MAC_ADDRESS = re.compile(r"(?i)(?<![0-9a-f])(?:[0-9a-f]{2}:){5}[0-9a-f]{2}(?![0-9a-f])")
GITDIR_POINTER = re.compile(
    r"gitdir: (?:[^\r\n]*/)?\.git/worktrees/[^/\r\n]+(?:\r?\n)?\Z"
)


class PublicScanError(RuntimeError):
    """A repository boundary could not be scanned completely."""


class PublicScanResourceLimitError(PublicScanError):
    """A scan exceeded a safe aggregate resource limit."""


Finding = tuple[str, int, str]


class ExactSubstringMatcher:
    """Match any case-folded exact substring in linear input time."""

    def __init__(self, terms: Iterable[str]) -> None:
        transitions: list[dict[str, int]] = [{}]
        failures = [0]
        matches = [False]
        for term in terms:
            state = 0
            for character in term:
                next_state = transitions[state].get(character)
                if next_state is None:
                    next_state = len(transitions)
                    transitions[state][character] = next_state
                    transitions.append({})
                    failures.append(0)
                    matches.append(False)
                state = next_state
            matches[state] = True

        pending: deque[int] = deque(transitions[0].values())
        while pending:
            state = pending.popleft()
            for character, next_state in transitions[state].items():
                pending.append(next_state)
                failure = failures[state]
                while failure and character not in transitions[failure]:
                    failure = failures[failure]
                failures[next_state] = transitions[failure].get(character, 0)
                matches[next_state] = (
                    matches[next_state] or matches[failures[next_state]]
                )

        self._transitions = transitions
        self._failures = failures
        self._matches = matches

    def matches(self, value: str) -> bool:
        state = 0
        for character in value.casefold():
            while state and character not in self._transitions[state]:
                state = self._failures[state]
            state = self._transitions[state].get(character, 0)
            if self._matches[state]:
                return True
        return False


class Findings:
    """Retain unique findings within count and rendered-text budgets."""

    def __init__(self) -> None:
        self._values: set[Finding] = set()
        self._text_bytes = 0

    def append(self, finding: Finding) -> None:
        if finding in self._values:
            return
        relative, line_number, rule = finding
        text_bytes = (
            len(relative.encode("utf-8", errors="surrogateescape"))
            + len(str(line_number).encode("ascii"))
            + len(rule.encode("ascii"))
            + len(":: [] review required\n".encode("ascii"))
        )
        if (
            len(self._values) >= MAX_PUBLIC_FINDINGS
            or self._text_bytes + text_bytes > MAX_PUBLIC_FINDING_BYTES
        ):
            raise PublicScanResourceLimitError
        self._values.add(finding)
        self._text_bytes += text_bytes

    def extend(self, findings: Iterable[Finding]) -> None:
        for finding in findings:
            self.append(finding)

    def __iter__(self) -> Iterable[Finding]:
        return iter(self._values)

    def __bool__(self) -> bool:
        return bool(self._values)


def files(root: Path) -> Iterable[Path]:
    """Yield the complete bounded source inventory or fail closed."""

    pending_directories = [root]
    entry_count = 0
    path_bytes = 0
    while pending_directories:
        current_path = pending_directories.pop()
        try:
            with os.scandir(current_path) as entries:
                for entry in entries:
                    path = Path(entry.path)
                    try:
                        info = entry.stat(follow_symlinks=False)
                    except OSError as error:
                        raise PublicScanError(
                            "source inventory is unreadable"
                        ) from error
                    if entry.name == ".git" and stat.S_ISDIR(info.st_mode):
                        continue
                    relative = path.relative_to(root).as_posix()
                    entry_count += 1
                    path_bytes += len(
                        relative.encode("utf-8", errors="surrogateescape")
                    )
                    if (
                        entry_count > MAX_PUBLIC_SOURCE_ENTRIES
                        or path_bytes > MAX_PUBLIC_SOURCE_PATH_BYTES
                    ):
                        raise PublicScanResourceLimitError
                    if stat.S_ISDIR(info.st_mode):
                        pending_directories.append(path)
                    else:
                        yield path
        except OSError as error:
            raise PublicScanError("source inventory is unreadable") from error


def enforce_source_content_budget(source_paths: Iterable[Path]) -> None:
    """Reject excessive potential regular-file read work before analysis."""

    content_bytes = 0
    for path in source_paths:
        try:
            info = path.lstat()
        except OSError:
            continue
        if not stat.S_ISREG(info.st_mode):
            continue
        maximum = (
            MAX_AGE_ENVELOPE_BYTES
            if has_exact_age_suffix(path)
            else MAX_PUBLIC_FILE_BYTES
        )
        content_bytes += min(info.st_size, maximum + 1)
        if content_bytes > MAX_PUBLIC_SOURCE_CONTENT_BYTES:
            raise PublicScanResourceLimitError


def admit_source_content(content_bytes: int, data: bytes) -> int:
    """Account for exact bytes before analyzing content read after preflight."""

    admitted = content_bytes + len(data)
    if admitted > MAX_PUBLIC_SOURCE_CONTENT_BYTES:
        raise PublicScanResourceLimitError
    return admitted


def read_public_file(path: Path) -> tuple[bytes | None, str | None]:
    """Read one bounded regular public file without following a symlink."""

    flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NONBLOCK", 0)
    no_follow = getattr(os, "O_NOFOLLOW", 0)
    if no_follow:
        flags |= no_follow
    try:
        descriptor = os.open(path, flags)
    except OSError:
        return None, "unreadable-public-file"
    try:
        try:
            info = os.fstat(descriptor)
            if not stat.S_ISREG(info.st_mode):
                return None, "unreadable-public-file"
            if info.st_size > MAX_PUBLIC_FILE_BYTES:
                return None, "oversized-public-file"
            chunks: list[bytes] = []
            remaining = MAX_PUBLIC_FILE_BYTES + 1
            while remaining:
                chunk = os.read(descriptor, min(remaining, 64 * 1024))
                if not chunk:
                    break
                chunks.append(chunk)
                remaining -= len(chunk)
        except OSError:
            return None, "unreadable-public-file"
    finally:
        os.close(descriptor)
    data = b"".join(chunks)
    if len(data) > MAX_PUBLIC_FILE_BYTES:
        return None, "oversized-public-file"
    return data, None


def public_text_views(data: bytes) -> tuple[str, ...]:
    """Return bounded text views, including common NUL-padded encodings."""

    views = [data.decode("utf-8", "surrogateescape")]
    if b"\0" in data:
        views.append(data.replace(b"\0", b"").decode("utf-8", "surrogateescape"))
        for encoding in (
            "utf-16",
            "utf-16-le",
            "utf-16-be",
            "utf-32",
            "utf-32-le",
            "utf-32-be",
        ):
            try:
                views.append(data.decode(encoding))
            except (UnicodeError, ValueError):
                continue
    return tuple(dict.fromkeys(views))


def has_exact_age_suffix(path: Path) -> bool:
    """Return whether a basename, including exactly ``.age``, ends in ``.age``."""

    return path.name.endswith(".age")


def has_age_like_suffix(path: Path) -> bool:
    return path.name.casefold().endswith(".age")


def has_age_magic(data: bytes) -> bool:
    return data.startswith((AGE_NATIVE_MAGIC, AGE_ARMORED_MAGIC))


def structured_document_contains_credential(path: Path, text: str) -> bool:
    """Parse supported public document formats and apply mapping semantics."""

    try:
        if path.name.casefold().endswith(".json"):
            document = json.loads(text)
        elif path.name.casefold().endswith(".toml"):
            document = tomllib.loads(text)
        else:
            return False
    except (UnicodeError, json.JSONDecodeError, tomllib.TOMLDecodeError):
        return False
    return contains_literal_credential(document)


def trusted_age_inspect_parser() -> str | None:
    """Return the exact available age-inspect executable when its version is trusted."""

    parser = shutil.which("age-inspect")
    if parser is None:
        return None
    try:
        version = subprocess.run(
            [parser, "--version"],
            check=False,
            capture_output=True,
            timeout=AGE_INSPECT_TIMEOUT_SECONDS,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    if version.returncode != 0 or version.stdout.strip() != AGE_VERSION.encode("ascii"):
        return None
    return parser


def age_envelope_finding(data: bytes, parser: str | None) -> str | None:
    """Return any exact-ciphertext or parser finding for the hosted policy."""

    if parser is None:
        return "age-parser-unavailable"
    if len(data) > MAX_PUBLIC_FILE_BYTES:
        return "invalid-age-envelope"
    try:
        result = subprocess.run(
            [parser, "--json", "-"],
            check=False,
            input=data,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=AGE_INSPECT_TIMEOUT_SECONDS,
        )
    except (OSError, subprocess.TimeoutExpired):
        return "age-parser-unavailable"
    if result.returncode != 0 or len(result.stdout) > MAX_AGE_INSPECTION_BYTES:
        return "invalid-age-envelope"
    try:
        document = json.loads(result.stdout)
    except (UnicodeError, json.JSONDecodeError):
        return "invalid-age-envelope"
    if not age_inspection_has_exact_postquantum_stanzas(
        document,
        stanza_count=EXPECTED_AGE_RECIPIENT_STANZAS,
    ):
        return "invalid-age-envelope"
    return None


def exact_terms(source: str | None) -> tuple[str, ...]:
    if source is None:
        return ()

    def read_terms(data: bytes) -> set[str]:
        if len(data) > MAX_DENYLIST_BYTES:
            raise PublicScanResourceLimitError
        try:
            lines = data.decode("utf-8").splitlines()
        except UnicodeError as error:
            raise PublicScanError("denylist is unreadable") from error
        terms: set[str] = set()
        for line in lines:
            stripped = line.strip()
            if not stripped or line.lstrip().startswith("#"):
                continue
            terms.add(stripped.casefold())
            if len(terms) > MAX_DENYLIST_TERMS:
                raise PublicScanResourceLimitError
        return terms

    if source == "-":
        terms = read_terms(sys.stdin.buffer.read(MAX_DENYLIST_BYTES + 1))
    else:
        data, finding = read_public_file(Path(source))
        if finding == "oversized-public-file":
            raise PublicScanResourceLimitError
        if finding is not None or data is None:
            raise PublicScanError("denylist is unreadable")
        terms = read_terms(data)
    return tuple(sorted(terms, key=len, reverse=True))


def public_path_label(
    relative: str,
    denylist: ExactSubstringMatcher,
) -> tuple[str, str | None]:
    """Return a non-sensitive finding label and any filename finding rule."""

    raw_relative = relative.encode("utf-8", errors="surrogateescape")
    rule = None
    if denylist.matches(relative):
        rule = "exact-denylist-filename"
    elif string_looks_like_private_key(relative):
        rule = "private-key-filename"
    elif string_looks_like_credential(relative):
        rule = "provider-token-filename"
    elif MAC_ADDRESS.search(relative):
        rule = "mac-address-filename"
    elif any(
        match.group(0).casefold() not in ALLOWED_EMAILS
        and match.group(1).casefold() not in ALLOWED_EMAIL_DOMAINS
        for match in EMAIL.finditer(relative)
    ):
        rule = "email-filename"
    elif any(
        match.group(1).casefold() not in ALLOWED_HOME_USERS
        for match in RELATIVE_HOME_PATH.finditer(relative)
    ):
        rule = "user-home-filename"
    elif any(0xD800 <= ord(character) <= 0xDFFF for character in relative):
        rule = "non-utf8-filename"
    elif any(
        ord(character) < 0x20
        or 0x7F <= ord(character) <= 0x9F
        or character in {"\u2028", "\u2029"}
        for character in relative
    ):
        rule = "control-character-filename"
    if rule is None:
        return relative, None
    digest = hashlib.sha256(raw_relative).hexdigest()[:16]
    return f"redacted-path:sha256:{digest}", rule


def sensitive_text_rules(
    value: str,
    denylist: ExactSubstringMatcher,
    *,
    syntax: str | None = None,
) -> tuple[str, ...]:
    """Return privacy rules matched by one value without retaining the value."""

    rules: list[str] = []
    folded = value.casefold()
    if denylist.matches(value):
        rules.append("exact-denylist")
    if string_looks_like_private_key(value):
        rules.append("private-key")
    elif string_looks_like_credential(value, syntax=syntax):
        rules.append("provider-token")
    if MAC_ADDRESS.search(value):
        rules.append("mac-address")
    if any(
        not (match.group(0).casefold().startswith("git@") and "ssh://git@" in folded)
        and match.group(0).casefold() not in ALLOWED_EMAILS
        and match.group(1).casefold() not in ALLOWED_EMAIL_DOMAINS
        for match in EMAIL.finditer(value)
    ):
        rules.append("email")
    if any(
        not re.search(
            r"\$[A-Za-z_][A-Za-z0-9_]*\"?$",
            value[: match.start()],
        )
        and match.group(1).casefold() not in ALLOWED_HOME_USERS
        for match in HOME_PATH.finditer(value)
    ):
        rules.append("user-home")
    return tuple(rules)


def sensitive_age_text_rules(
    value: str,
    denylist: ExactSubstringMatcher,
) -> tuple[str, ...]:
    """Return high-confidence rules found in exact ciphertext bytes."""

    rules: list[str] = []
    if denylist.matches(value):
        rules.append("exact-denylist")
    if string_looks_like_private_key(value):
        rules.append("private-key")
    elif string_looks_like_credential(value):
        rules.append("provider-token")
    return tuple(rules)


def sensitive_file_text_rules(
    relative: str,
    value: str,
    denylist: ExactSubstringMatcher,
    *,
    age_shaped: bool,
    syntax: str | None = None,
) -> tuple[str, ...]:
    """Return rules while treating an exact root gitfile pointer as metadata."""

    if age_shaped:
        return sensitive_age_text_rules(value, denylist)
    rules = sensitive_text_rules(value, denylist, syntax=syntax)
    if relative == ".git" and GITDIR_POINTER.fullmatch(value):
        return tuple(
            rule for rule in rules if rule not in {"exact-denylist", "user-home"}
        )
    return rules


def _main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--root", type=Path, default=Path.cwd())
    parser.add_argument(
        "--denylist",
        help="plaintext exact-term file, or '-' for standard input",
    )
    parser.add_argument(
        "--require-age-manifest",
        action="store_true",
        help="require the canonical age inventory even when it is empty",
    )
    arguments = parser.parse_args()
    try:
        root = arguments.root.resolve(strict=True)
    except OSError:
        print("privacy scan failed", file=sys.stderr)
        return 1
    if not root.is_dir():
        print("privacy scan failed", file=sys.stderr)
        return 1
    try:
        denylist = ExactSubstringMatcher(exact_terms(arguments.denylist))
    except PublicScanResourceLimitError:
        raise
    except PublicScanError:
        print("privacy scan failed", file=sys.stderr)
        return 1
    findings = Findings()
    unresolved_age_parser = object()
    age_parser: str | None | object = unresolved_age_parser

    try:
        source_paths = tuple(files(root))
    except PublicScanResourceLimitError:
        raise
    except PublicScanError:
        print("privacy scan failed", file=sys.stderr)
        return 1
    enforce_source_content_budget(source_paths)
    admitted_content_bytes = 0
    age_candidates = {
        path.relative_to(root).as_posix()
        for path in source_paths
        if has_exact_age_suffix(path)
    }
    admitted: dict[str, str] | None = None
    inventory_is_valid = True
    try:
        discovered = discover_age_files(
            root,
            skipped_directories=AGE_INVENTORY_SKIPPED_DIRECTORIES,
        )
    except AgeEnvelopeError:
        discovered = {}
        inventory_is_valid = False
    manifest_exists = os.path.lexists(root / AGE_MANIFEST_NAME)
    if (
        discovered
        or age_candidates
        or manifest_exists
        or arguments.require_age_manifest
    ):
        try:
            admitted = load_manifest(root)
        except AgeEnvelopeError:
            admitted = None
            inventory_is_valid = False
        else:
            if set(admitted) != set(discovered):
                inventory_is_valid = False
    else:
        admitted = {}
    if not inventory_is_valid:
        findings.append((AGE_MANIFEST_NAME, 0, "invalid-age-envelope-manifest"))

    for path in source_paths:
        relative = path.relative_to(root).as_posix()
        public_relative, filename_rule = public_path_label(relative, denylist)
        if filename_rule is not None:
            findings.append((public_relative, 0, filename_rule))
        exact_age_suffix = has_exact_age_suffix(path)
        age_like_suffix = has_age_like_suffix(path)
        if age_like_suffix and not exact_age_suffix:
            findings.append((public_relative, 0, "invalid-age-envelope-suffix"))
        try:
            path_info = path.lstat()
        except OSError:
            findings.append((public_relative, 0, "unreadable-public-file"))
            continue
        if stat.S_ISLNK(path_info.st_mode):
            if exact_age_suffix:
                findings.append((public_relative, 0, "age-envelope-not-regular"))
            try:
                target = path.readlink().as_posix()
            except OSError:
                findings.append((public_relative, 0, "symlink-target-unreadable"))
                continue
            findings.extend(
                (public_relative, 0, f"{rule}-symlink-target")
                for rule in sensitive_text_rules(target, denylist)
            )
            continue
        if not stat.S_ISREG(path_info.st_mode):
            findings.append((public_relative, 0, "unreadable-public-file"))
            continue
        if exact_age_suffix:
            try:
                age_data = read_regular_file(
                    path,
                    maximum=MAX_AGE_ENVELOPE_BYTES,
                )
            except AgeEnvelopeError:
                findings.append((public_relative, 0, "invalid-age-envelope"))
                continue
            admitted_content_bytes = admit_source_content(
                admitted_content_bytes,
                age_data,
            )
            digest = "sha256:" + hashlib.sha256(age_data).hexdigest()
            if admitted is None or admitted.get(relative) != digest:
                findings.append((public_relative, 0, "invalid-age-envelope"))
            if age_parser is unresolved_age_parser:
                age_parser = trusted_age_inspect_parser()
            assert age_parser is None or isinstance(age_parser, str)
            envelope_finding = age_envelope_finding(age_data, age_parser)
            if envelope_finding is not None:
                findings.append((public_relative, 0, envelope_finding))
            text_views = (age_data.decode("utf-8", "surrogateescape"),)
            age_shaped = True
        else:
            public_data, read_finding = read_public_file(path)
            if read_finding is not None:
                findings.append((public_relative, 0, read_finding))
                continue
            assert public_data is not None
            admitted_content_bytes = admit_source_content(
                admitted_content_bytes,
                public_data,
            )
            age_shaped = has_age_magic(public_data)
            if age_shaped:
                findings.append((public_relative, 0, "invalid-age-envelope-suffix"))
                text_views = (public_data.decode("utf-8", "surrogateescape"),)
            else:
                text_views = public_text_views(public_data)
        if not text_views:
            continue
        for text in text_views:
            file_syntax = serialized_syntax(relative)
            line_syntax = "line-invariants" if file_syntax is not None else None
            line_rules: set[str] = set()
            for line_number, line in enumerate(text.splitlines(), start=1):
                matched_rules = sensitive_file_text_rules(
                    relative,
                    line,
                    denylist,
                    age_shaped=age_shaped,
                    syntax=line_syntax,
                )
                line_rules.update(matched_rules)
                findings.extend(
                    (public_relative, line_number, rule) for rule in matched_rules
                )
            findings.extend(
                (public_relative, 0, rule)
                for rule in sensitive_file_text_rules(
                    relative,
                    text,
                    denylist,
                    age_shaped=age_shaped,
                    syntax=file_syntax,
                )
                if rule not in line_rules
            )
            if not age_shaped and structured_document_contains_credential(path, text):
                findings.append((public_relative, 0, "provider-token"))

    for relative, line_number, rule in sorted(findings):
        print(f"{relative}:{line_number}: [{rule}] review required")
    return 1 if findings else 0


def main() -> int:
    try:
        return _main()
    except PublicScanResourceLimitError:
        print(RESOURCE_LIMIT_DIAGNOSTIC, file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
