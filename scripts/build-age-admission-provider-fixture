"""Build one provider-free, synthetic age-admission qualification fixture."""

from __future__ import annotations

import sys

_FAILURE = "age-admission provider fixture failed"
_INTERRUPTED = "age-admission provider fixture interrupted"

if not sys.flags.isolated or not sys.flags.dont_write_bytecode or not sys.flags.no_site:
    print(_FAILURE, file=sys.stderr)
    raise SystemExit(1)

