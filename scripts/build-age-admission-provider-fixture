MAX_PREFLIGHT_CHANNEL_BYTES = 32
MAX_GIT_TREE_ENTRIES = 10_000
CHILD_TIMEOUT_SECONDS = 30
PREFLIGHT_TIMEOUT_SECONDS = 75
TERMINATION_GRACE_SECONDS = 1.0

COMMIT_ID = re.compile(r"[0-9a-f]{40}\Z", re.ASCII)
