#!/usr/bin/env python3
"""Admit exact age ciphertext bytes after non-interactive decryption to EOF."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import shutil
import stat
import subprocess
import sys
import tempfile
from pathlib import Path

from privacy_age_envelopes import (
    AGE_MANIFEST_NAME,
    AGE_VERSION,
    MAX_AGE_ENVELOPE_BYTES,
    MAX_AGE_MANIFEST_BYTES,
    AgeEnvelopeError,
    age_inspection_has_exact_postquantum_stanzas,
    canonical_manifest_bytes,
    discover_age_files,
    open_regular_file_descriptor,
    read_regular_file,
)

DECRYPT_TIMEOUT_SECONDS = 15
MAX_INSPECTION_BYTES = 1024 * 1024
MAX_RECIPIENT_BYTES = 4096
MAX_AGE_TOOL_BYTES = 32 * 1024 * 1024
SKIPPED_DIRECTORIES = {".git"}
_POSTQUANTUM_RECIPIENT = re.compile(rb"age1pq1[a-z0-9]+\n\Z", re.ASCII)
# Darwin ``fcntl`` request that returns the path bound to a descriptor. CPython
# does not expose ``F_GETPATH`` on every supported build.
_DARWIN_F_GETPATH = 50


class ManifestDurabilityUncertainError(AgeEnvelopeError):
    """The new manifest is installed but its directory commit is unconfirmed."""


def _is_within(path: Path, root: Path) -> bool:
    try:
        path.relative_to(root)
    except ValueError:
        return False
    return True


def _validated_identities(raw_identities: list[Path], root: Path) -> list[int]:
    if len(raw_identities) != 1:
        raise AgeEnvelopeError("v1 requires exactly one identity")
    identities: list[int] = []
    identity_objects: set[tuple[int, int]] = set()
    try:
        for raw_identity in raw_identities:
            lexical = Path(os.path.abspath(raw_identity))
            try:
                canonical = lexical.resolve(strict=True)
            except OSError as error:
                raise AgeEnvelopeError("identity is unavailable") from error
            if _is_within(lexical, root) or _is_within(canonical, root):
                raise AgeEnvelopeError("identity must be outside the repository")

            descriptor, info = open_regular_file_descriptor(lexical)
            try:
                try:
                    canonical_info = canonical.stat(follow_symlinks=False)
                except OSError as error:
                    raise AgeEnvelopeError("identity is unavailable") from error
                identity_object = (info.st_dev, info.st_ino)
                if not stat.S_ISREG(canonical_info.st_mode) or identity_object != (
                    canonical_info.st_dev,
                    canonical_info.st_ino,
                ):
                    raise AgeEnvelopeError("identity changed during validation")
                if stat.S_IMODE(info.st_mode) != 0o600:
                    raise AgeEnvelopeError("identity does not have mode 0600")
                if identity_object in identity_objects:
                    raise AgeEnvelopeError("duplicate identity")
            except BaseException:
                os.close(descriptor)
                raise
            identities.append(descriptor)
            identity_objects.add(identity_object)
    except BaseException:
        for descriptor in identities:
            os.close(descriptor)
        raise
    return identities


def _descriptor_target(descriptor: int) -> Path:
    """Resolve an inherited descriptor to its source path for boundary checks."""

    try:
        if sys.platform == "darwin":
            import fcntl

            raw = fcntl.fcntl(descriptor, _DARWIN_F_GETPATH, b"\0" * 1024)
            target = raw.split(b"\0", 1)[0].decode("utf-8")
        else:
            target = os.readlink(f"/proc/self/fd/{descriptor}")
    except (AttributeError, OSError, UnicodeError) as error:
        raise AgeEnvelopeError("identity source cannot be established") from error
    if not target or target.endswith(" (deleted)"):
        raise AgeEnvelopeError("identity source cannot be established")
    return Path(target)


def _validated_identity_descriptors(
    raw_descriptors: list[int],
    root: Path,
) -> list[int]:
    """Duplicate inherited, already-bound identity descriptors safely."""

    if len(raw_descriptors) != 1:
        raise AgeEnvelopeError("v1 requires exactly one identity")
    identities: list[int] = []
    identity_objects: set[tuple[int, int]] = set()
    try:
        for raw_descriptor in raw_descriptors:
            descriptor: int | None = None
            try:
                descriptor = os.dup(raw_descriptor)
                info = os.fstat(descriptor)
            except OSError as error:
                if descriptor is not None:
                    os.close(descriptor)
                raise AgeEnvelopeError("identity is unavailable") from error
            if not stat.S_ISREG(info.st_mode):
                os.close(descriptor)
                raise AgeEnvelopeError("identity is not regular")
            if stat.S_IMODE(info.st_mode) != 0o600:
                os.close(descriptor)
                raise AgeEnvelopeError("identity does not have mode 0600")
            try:
                target = _descriptor_target(descriptor)
            except BaseException:
                os.close(descriptor)
                raise
            try:
                canonical = target.resolve(strict=True)
            except OSError as error:
                os.close(descriptor)
                raise AgeEnvelopeError("identity source cannot be established") from error
            if _is_within(target, root) or _is_within(canonical, root):
                os.close(descriptor)
                raise AgeEnvelopeError("identity must be outside the repository")
            identity_object = (info.st_dev, info.st_ino)
            if identity_object in identity_objects:
                os.close(descriptor)
                raise AgeEnvelopeError("duplicate identity")
            identities.append(descriptor)
            identity_objects.add(identity_object)
    except BaseException:
        for descriptor in identities:
            os.close(descriptor)
        raise
    return identities


def _read_age_tool(path: Path, *, root: Path) -> bytes:
    try:
        canonical = path.resolve(strict=True)
    except OSError as error:
        raise AgeEnvelopeError("pinned age tooling is unavailable") from error
    if _is_within(canonical, root):
        raise AgeEnvelopeError("age tooling executable must be outside repository")
    descriptor, info = open_regular_file_descriptor(canonical)
    try:
        if info.st_mode & 0o111 == 0:
            raise AgeEnvelopeError("pinned age tooling is unavailable")
        chunks: list[bytes] = []
        remaining = MAX_AGE_TOOL_BYTES + 1
        while remaining:
            chunk = os.read(descriptor, min(remaining, 64 * 1024))
            if not chunk:
                break
            chunks.append(chunk)
            remaining -= len(chunk)
    finally:
        os.close(descriptor)
    data = b"".join(chunks)
    if len(data) > MAX_AGE_TOOL_BYTES:
        raise AgeEnvelopeError("pinned age tooling is unavailable")
    return data


def _stage_age_tool(path: Path, data: bytes, *, root: Path) -> None:
    descriptor: int | None = None
    try:
        descriptor = os.open(
            path,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_CLOEXEC", 0),
            0o600,
        )
        with os.fdopen(descriptor, "wb") as stream:
            descriptor = None
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
            os.fchmod(stream.fileno(), 0o500)
        if _read_age_tool(path, root=root) != data:
            raise AgeEnvelopeError("age tooling changed during staging")
    except OSError as error:
        raise AgeEnvelopeError("age tooling staging failed") from error
    finally:
        if descriptor is not None:
            os.close(descriptor)


def _validated_binary(
    name: str,
    trusted_directory: Path,
    stage: Path,
    *,
    root: Path,
) -> str:
    ambient = shutil.which(name)
    if ambient is None:
        raise AgeEnvelopeError("pinned age tooling is unavailable")
    trusted_data = _read_age_tool(trusted_directory / name, root=root)
    if _read_age_tool(Path(ambient), root=root) != trusted_data:
        raise AgeEnvelopeError("untrusted age tooling provenance")
    staged = stage / name
    _stage_age_tool(staged, trusted_data, root=root)
    try:
        result = subprocess.run(
            [staged, "--version"],
            check=False,
            capture_output=True,
            timeout=DECRYPT_TIMEOUT_SECONDS,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        raise AgeEnvelopeError("age tooling version check failed") from error
    if result.returncode != 0 or result.stdout.strip() != AGE_VERSION.encode("ascii"):
        raise AgeEnvelopeError("unexpected age tooling version")
    return os.fspath(staged)


def _validated_tooling_directory(root: Path) -> Path:
    raw = os.environ.get("AGE_TOOLING_DIRECTORY")
    if not raw:
        raise AgeEnvelopeError("trusted age tooling provenance is unavailable")
    directory = Path(raw)
    if not directory.is_absolute():
        raise AgeEnvelopeError("trusted age tooling provenance is unavailable")
    lexical = Path(os.path.abspath(directory))
    try:
        canonical = lexical.resolve(strict=True)
    except OSError as error:
        raise AgeEnvelopeError(
            "trusted age tooling provenance is unavailable"
        ) from error
    if (
        not canonical.is_dir()
        or _is_within(lexical, root)
        or _is_within(canonical, root)
    ):
        raise AgeEnvelopeError("trusted age tooling provenance is unavailable")
    return canonical


def _has_authorized_postquantum_structure(
    age_inspect: str,
    data: bytes,
    *,
    identity_count: int,
) -> bool:
    try:
        result = subprocess.run(
            [age_inspect, "--json", "-"],
            check=False,
            input=data,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=DECRYPT_TIMEOUT_SECONDS,
            start_new_session=True,
        )
    except (OSError, subprocess.TimeoutExpired):
        return False
    if result.returncode != 0 or len(result.stdout) > MAX_INSPECTION_BYTES:
        return False
    try:
        document = json.loads(result.stdout)
    except (UnicodeError, json.JSONDecodeError):
        return False
    return age_inspection_has_exact_postquantum_stanzas(
        document,
        stanza_count=identity_count,
    )


def _validated_identity_recipients(
    age_keygen: str,
    identities: list[int],
) -> set[bytes]:
    recipients: set[bytes] = set()
    for identity in identities:
        try:
            os.lseek(identity, 0, os.SEEK_SET)
            result = subprocess.run(
                [age_keygen, "-y", f"/dev/fd/{identity}"],
                check=False,
                pass_fds=(identity,),
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                timeout=DECRYPT_TIMEOUT_SECONDS,
                start_new_session=True,
            )
        except (OSError, subprocess.TimeoutExpired) as error:
            raise AgeEnvelopeError("identity recipient derivation failed") from error
        recipient = result.stdout
        if (
            result.returncode != 0
            or len(recipient) > MAX_RECIPIENT_BYTES
            or _POSTQUANTUM_RECIPIENT.fullmatch(recipient) is None
            or recipient in recipients
        ):
            raise AgeEnvelopeError("identity is not one unique PQ identity")
        recipients.add(recipient)
    return recipients


def _decrypts_to_eof(age: str, identities: list[int], data: bytes) -> bool:
    for identity in identities:
        try:
            os.lseek(identity, 0, os.SEEK_SET)
            result = subprocess.run(
                [age, "--decrypt", "--identity", f"/dev/fd/{identity}", "-"],
                check=False,
                input=data,
                pass_fds=(identity,),
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=DECRYPT_TIMEOUT_SECONDS,
                start_new_session=True,
            )
        except (OSError, subprocess.TimeoutExpired):
            return False
        if result.returncode != 0:
            return False
    return True


def _replace_manifest(root: Path, data: bytes) -> None:
    descriptor: int | None = None
    temporary: Path | None = None
    replaced = False
    try:
        descriptor, temporary_name = tempfile.mkstemp(
            dir=root,
            prefix=f"{AGE_MANIFEST_NAME}.",
        )
        temporary = Path(temporary_name)
        stream = os.fdopen(descriptor, "wb")
        descriptor = None
        with stream:
            stream.write(data)
            stream.flush()
            os.fchmod(stream.fileno(), 0o644)
            os.fsync(stream.fileno())
        os.replace(temporary, root / AGE_MANIFEST_NAME)
        temporary = None
        replaced = True
        directory = os.open(
            root,
            os.O_RDONLY | getattr(os, "O_DIRECTORY", 0),
        )
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    except OSError as error:
        if replaced:
            try:
                installed = read_regular_file(
                    root / AGE_MANIFEST_NAME,
                    maximum=len(data),
                )
            except (AgeEnvelopeError, OSError):
                installed = None
            if installed == data:
                raise ManifestDurabilityUncertainError(
                    "manifest installed but directory durability is uncertain"
                ) from error
        raise AgeEnvelopeError("manifest replacement failed") from error
    finally:
        if descriptor is not None:
            try:
                os.close(descriptor)
            except OSError:
                pass
        if temporary is not None:
            try:
                temporary.unlink()
            except OSError:
                pass


def admit(
    root: Path,
    raw_identities: list[Path],
    *,
    identity_descriptors: list[int] | None = None,
    replace_manifest: bool = True,
) -> bytes:
    try:
        root = root.resolve(strict=True)
    except OSError as error:
        raise AgeEnvelopeError("repository root is unavailable") from error
    if not root.is_dir():
        raise AgeEnvelopeError("repository root is not a directory")
    trusted_tooling = _validated_tooling_directory(root)
    try:
        with tempfile.TemporaryDirectory(prefix="admit-age-tooling.") as raw_stage:
            stage = Path(raw_stage)
            age = _validated_binary("age", trusted_tooling, stage, root=root)
            age_keygen = _validated_binary(
                "age-keygen",
                trusted_tooling,
                stage,
                root=root,
            )
            age_inspect = _validated_binary(
                "age-inspect",
                trusted_tooling,
                stage,
                root=root,
            )
            if identity_descriptors is None:
                identities = _validated_identities(raw_identities, root)
            else:
                if raw_identities:
                    raise AgeEnvelopeError("identity arguments are ambiguous")
                identities = _validated_identity_descriptors(identity_descriptors, root)
            try:
                _validated_identity_recipients(age_keygen, identities)
                discovered = discover_age_files(
                    root,
                    skipped_directories=SKIPPED_DIRECTORIES,
                )

                admitted: dict[str, str] = {}
                for relative in sorted(discovered):
                    data = read_regular_file(
                        discovered[relative],
                        maximum=MAX_AGE_ENVELOPE_BYTES,
                    )
                    if not _has_authorized_postquantum_structure(
                        age_inspect,
                        data,
                        identity_count=1,
                    ):
                        raise AgeEnvelopeError(
                            "an envelope has an unauthorized recipient set"
                        )
                    if not _decrypts_to_eof(age, identities, data):
                        raise AgeEnvelopeError("an envelope did not decrypt to EOF")
                    admitted[relative] = "sha256:" + hashlib.sha256(data).hexdigest()

                manifest = canonical_manifest_bytes(admitted)
                if replace_manifest:
                    _replace_manifest(root, manifest)
                else:
                    try:
                        existing = read_regular_file(
                            root / AGE_MANIFEST_NAME,
                            maximum=MAX_AGE_MANIFEST_BYTES,
                        )
                    except (AgeEnvelopeError, OSError) as error:
                        raise AgeEnvelopeError(
                            "validated envelope manifest is unavailable"
                        ) from error
                    if existing != manifest:
                        raise AgeEnvelopeError(
                            "validated envelope manifest does not match candidate"
                        )
                return manifest
            finally:
                for descriptor in identities:
                    os.close(descriptor)
    except OSError as error:
        raise AgeEnvelopeError("age tooling validation failed") from error


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--root", type=Path, default=Path.cwd())
    identity_arguments = parser.add_mutually_exclusive_group(required=True)
    identity_arguments.add_argument("--identity", type=Path, action="append")
    identity_arguments.add_argument(
        "--identity-fd",
        type=int,
        action="append",
        help="use a descriptor already validated by the trusted receipt creator",
    )
    parser.add_argument(
        "--check-only",
        action="store_true",
        help="validate every envelope without replacing the manifest",
    )
    arguments = parser.parse_args()
    try:
        admit(
            arguments.root,
            arguments.identity or [],
            identity_descriptors=arguments.identity_fd,
            replace_manifest=not arguments.check_only,
        )
    except ManifestDurabilityUncertainError:
        print("age-envelope manifest durability uncertain", file=sys.stderr)
        return 2
    except AgeEnvelopeError:
        print("age-envelope admission failed", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
