#!/usr/bin/env python3
"""Verify that the retained dotfiles Buildkite pipeline is archived.

GitHub Actions owns CI. This tool reads the pipeline named in the adjacent
record; it never changes provider settings or unarchives a pipeline. The
retired apply command fails before provider access, including with --yes or
an alternate record. Archive verification does not inspect queue pauses,
active builds, schedules, or account spending controls.

Exit status: 0 when the pipeline is archived, 1 when it is not, and 2 when
verification is unavailable or the invocation/record is invalid.
"""

from __future__ import annotations

import argparse
from datetime import datetime
import json
import os
from pathlib import Path
import re
import subprocess
import sys
from typing import Any, NoReturn
from urllib.parse import urlsplit

sys.dont_write_bytecode = True
PROG = "buildkite-pipeline-settings"
DEFAULT_RECORD = Path(__file__).resolve().with_name(f"{PROG}.json")
RECORD_KEYS = {"description", "organization", "pipeline", "archived"}
SLUG = re.compile(r"[a-z0-9][a-z0-9-]*\Z")
SECRET_ASSIGNMENT = re.compile(
    r"(?i)(\b\w*(?:token|secret|password|passwd|credential|api_?key|private_?key)\w*[\"']?\s*[:=]\s*)\S.*"
)
BK_TIMEOUT_SECONDS = 120
STDERR_EXCERPT_LINES = 5


class Failure(Exception):
    """Verification could not establish the required state."""


def fail(message: str) -> NoReturn:
    raise Failure(message)


def show(value: object) -> str:
    return json.dumps(value, ensure_ascii=False)


def unique_object(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
    result: dict[str, Any] = {}
    for key, value in pairs:
        if key in result:
            fail(f"duplicate key {show(key)}")
        result[key] = value
    return result


def reject_constant(name: str) -> NoReturn:
    fail(f"non-standard JSON constant {name}")


def load_record(path: Path) -> dict[str, Any]:
    try:
        record = json.loads(path.read_text(encoding="utf-8"), object_pairs_hook=unique_object, parse_constant=reject_constant)
    except (OSError, UnicodeDecodeError, json.JSONDecodeError, Failure) as error:
        fail(f"cannot read retirement record: {error}")
    if not isinstance(record, dict) or set(record) != RECORD_KEYS:
        fail("retirement record must contain only description, organization, pipeline, and archived")
    if not isinstance(record["description"], str):
        fail("retirement record description must be a string")
    for field in ("organization", "pipeline"):
        slug = record[field]
        if not isinstance(slug, str) or not SLUG.fullmatch(slug):
            fail(f"retirement record must name the {field} slug")
    if record["archived"] is not True:
        fail("retirement record must require archived: true")
    return record


def redact(text: str) -> str:
    text = re.sub(r"[a-z][a-z0-9+.-]*://[^\s\"'<>]+", "<url>", text, flags=re.IGNORECASE)
    text = re.sub(r"\bbk[a-z]{2}_[A-Za-z0-9_]+", "<token>", text)
    text = SECRET_ASSIGNMENT.sub(r"\1<redacted>", text)
    token = os.environ.get("BUILDKITE_API_TOKEN")
    if token:
        text = text.replace(token, "<token>")
    return text


def run_bk(arguments: list[str], action: str) -> subprocess.CompletedProcess[str]:
    bk = os.environ.get("BK") or "bk"
    try:
        result = subprocess.run(
            [bk, *arguments],
            stdin=subprocess.DEVNULL,
            capture_output=True,
            encoding="utf-8",
            errors="replace",
            timeout=BK_TIMEOUT_SECONDS,
            check=False,
        )
    except FileNotFoundError:
        fail(f"cannot {action}: {bk} not found (set BK to the bk executable)")
    except subprocess.TimeoutExpired:
        fail(f"cannot {action}: {bk} did not finish within {BK_TIMEOUT_SECONDS}s")
    except OSError as error:
        fail(f"cannot {action}: cannot run {bk}: {error.strerror}")
    if result.returncode != 0:
        lines = redact(result.stderr).strip().splitlines()[-STDERR_EXCERPT_LINES:]
        detail = "".join(f"\n  {line}" for line in lines)
        fail(f"cannot {action}: {bk} exited with status {result.returncode}{detail}")
    return result


def read_json(endpoint: str, action: str) -> Any:
    result = run_bk(["api", "--no-pager", "-q", endpoint], action)
    try:
        return json.loads(result.stdout)
    except json.JSONDecodeError:
        # The body can hold the webhook URL, so it is not quoted.
        fail(f"bk api {endpoint} returned malformed JSON")


def url_organization(url: object) -> str | None:
    if not isinstance(url, str):
        return None
    segments = urlsplit(url).path.split("/")
    for index, segment in enumerate(segments[:-1]):
        if segment == "organizations":
            return segments[index + 1]
    return None


def read_pipeline(record: dict[str, Any]) -> dict[str, Any]:
    slug, organization = record["pipeline"], record["organization"]
    endpoint = f"/pipelines/{slug}"
    pipeline = read_json(endpoint, f"read pipeline {slug}")
    if not isinstance(pipeline, dict):
        fail(f"bk api {endpoint} did not return a pipeline object")
    if pipeline.get("slug") != slug:
        fail(f"bk api {endpoint} returned a different pipeline")
    # bk prefixes the endpoint with the organization it has selected. Only the
    # organization segment of the pipeline's URL is compared or printed.
    selected = url_organization(pipeline.get("url"))
    if selected != organization:
        found = f"organization {show(selected)}" if selected else "no organization"
        fail(
            f"bk api {endpoint} returned pipeline {slug} of {found}, not {organization};"
            f" select organization {organization} in bk"
        )
    return pipeline


def check(record: dict[str, Any]) -> int:
    pipeline = read_pipeline(record)
    if "archived_at" not in pipeline:
        fail("pipeline response has no archive state")
    archived = pipeline["archived_at"]
    if archived is None:
        print(f"{PROG}: pipeline {record['pipeline']} is not archived; CI must remain on GitHub Actions")
        return 1
    try:
        if not isinstance(archived, str) or not archived:
            raise ValueError
        if archived.endswith(" UTC"):
            archived = archived.removesuffix(" UTC") + "+00:00"
        instant = datetime.fromisoformat(archived.replace("Z", "+00:00"))
        if instant.tzinfo is None:
            raise ValueError
    except ValueError:
        fail("pipeline response has an invalid archive state")
    print(f"{PROG}: pipeline {record['pipeline']} is archived")
    print("Queue state, active builds, and spending limits are not checked.")
    return 0


def parse_arguments(argv: list[str] | None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(prog=PROG, description=__doc__)
    parser.add_argument("--record", type=Path, default=DEFAULT_RECORD, help="retirement record")
    commands = parser.add_subparsers(dest="command", metavar="{check,apply}")
    commands.add_parser("check", help="verify the pipeline is archived (default; read-only)")
    retired = commands.add_parser("apply", help="retired; always fails without provider access")
    retired.add_argument("--yes", action="store_true", help=argparse.SUPPRESS)
    return parser.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    arguments = parse_arguments(argv)
    try:
        if arguments.command == "apply":
            fail("Buildkite CI is retired; apply is disabled and no settings were changed")
        return check(load_record(arguments.record))
    except Failure as error:
        print(f"{PROG}: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
